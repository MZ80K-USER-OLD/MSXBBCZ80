  1201                          ;Function STR - convert numeric value to ASCII string.
  1202                          ;   Inputs: HLH'L'C = integer or floating-point number
  1203                          ;           DE = address at which to store string
  1204                          ;           IX = address of @% format control
  1205                          ;  Outputs: String stored, with NUL terminator
  1206                          ;
  1207                          ;First normalise for decimal output:
  1208                          ;
  1209  06cd  cd9d09            STR:	CALL	SFLOAT
  1210  06d0  0600              	LD	B,0		;DEFAULT PT. POSITION
  1211  06d2  cb7c              	BIT	7,H		;NEGATIVE?
