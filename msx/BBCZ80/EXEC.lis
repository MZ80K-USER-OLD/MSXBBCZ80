  3150  12be  2829              	JR	Z,WSRCHX
  3151  12c0  b9                	CP	C
  3152  12c1  2823              	JR	Z,WSRCHP
  3153  12c3  fe0d              	CP	CR
  3154  12c5  20e4              	JR	NZ,WSRCH
