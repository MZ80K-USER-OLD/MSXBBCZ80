   624                          ;
   625                          ;SETUP - Set up File Control Block.
   626                          ;   Inputs: HL addresses filename
   627                          ;           Format  [A:]FILENAME[.EXT]
   628                          ;           Device defaults to current drive
   629                          ;           Extension defaults to .BBC
   630                          ;           A = fill character
   631                          ;  Outputs: HL updated
   632                          ;           A = terminator
   633                          ;           BC = 128
   634                          ; Destroys: A,B,C,H,L,F
   635                          ;
   636                          ; MSX-DOS2 path-aware compatibility shim.
   637                          ; Keep the raw path string in PATHBUF so command handlers can migrate from
   638                          ; CP/M FCB parsing to path-based DOS calls without immediately breaking the
   639                          ; legacy file layer.
   640                          ;
   641  02d4  110000            PATHSAVE:	LD	DE,PATHBUF
   642  02d7  af                	XOR	A
   643  02d8  7e                PATHS1:	LD	A,(HL)
   644  02d9  b7                	OR	A
   645  02da  2828              	JR	Z,PATHS2
   646  02dc  fe0d              	CP	CR
   647  02de  2824              	JR	Z,PATHS2
   648  02e0  fe20              	CP	' '
   649  02e2  2820              	JR	Z,PATHS2
   650  02e4  fe3d              	CP	'='
   651  02e6  281c              	JR	Z,PATHS2
   652  02e8  fe22              	CP	'"'
   653  02ea  2818              	JR	Z,PATHS2
   654  02ec  fe7c              	CP	'|'
   655  02ee  2814              	JR	Z,PATHS2
   656  02f0  fe2f              	CP	'/'
   657  02f2  2809              	JR	Z,PATHS3
   658  02f4  fe5c              	CP	5CH		; '\'
   659  02f6  2805              	JR	Z,PATHS3
   660  02f8  12                	LD	(DE),A
   661  02f9  13                	INC	DE
   662  02fa  23                	INC	HL
   663  02fb  18db              	JR	PATHS1
   664  02fd  3e5c              PATHS3:	LD	A,5CH
   665  02ff  12                	LD	(DE),A
   666  0300  13                	INC	DE
   667  0301  23                	INC	HL
   668  0302  18d4              	JR	PATHS1
   669  0304  af                PATHS2:	XOR	A
   670  0305  12                	LD	(DE),A
   671  0306  c9                	RET
   672                          ;
   673                          ;PATHNORM - normalise a path string stored in PATHBUF to a DOS2-friendly form.
   674                          ;   Normalises '/' to '\' and uppercases the drive/path characters.
   675                          ;   The original FCB-based layer still receives the CP/M-compatible name, but
   676                          ;   PATHBUF preserves the full path information needed for a later DOS2 switch.
   677                          ;
   678  0307  f5                PATHNORM:	PUSH	AF
   679  0308  d5                	PUSH	DE
   680  0309  e5                	PUSH	HL
   681  030a  210000            	LD	HL,PATHBUF
   682  030d  7e                PATHN1:	LD	A,(HL)
   683  030e  b7                	OR	A
   684  030f  2815              	JR	Z,PATHNEND
   685  0311  fe2f              	CP	'/'
   686  0313  280b              	JR	Z,PATHN2
   687  0315  fe5c              	CP	5CH
   688  0317  2807              	JR	Z,PATHN2
   689  0319  cd1406            	CALL	UPPRC
   690  031c  77                	LD	(HL),A
   691  031d  23                	INC	HL
   692  031e  18ed              	JR	PATHN1
   693  0320  3e5c              PATHN2:	LD	A,5CH
   694  0322  77                	LD	(HL),A
   695  0323  23                	INC	HL
   696  0324  18e7              	JR	PATHN1
   697  0326  e1                PATHNEND:	POP	HL
   698  0327  d1                	POP	DE
   699  0328  f1                	POP	AF
   700  0329  c9                	RET
   701                          ;
   702                          ;FCB FORMAT (36 BYTES TOTAL):
   703                          ; 0      0=SAME DISK, 1=DISK A, 2=DISK B (ETC.)
   704                          ; 1-8    FILENAME, PADDED WITH SPACES
   705                          ; 9-11   EXTENSION, PADDED WITH SPACES
   706                          ; 12     CURRENT EXTENT, SET TO ZERO
