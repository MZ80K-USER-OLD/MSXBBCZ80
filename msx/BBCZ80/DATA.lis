              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
    50  0100  0000000000000000  BUFFER:	DEFS	256		;STRING INPUT BUFFER
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
    51  0200  0000000000000000  STAVAR:	DEFS	27*4		;STATIC VARIABLES
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              00000000          
    52                          OC	EQU	STAVAR+15*4	;CODE ORIGIN (O%)
    53                          PC	EQU	STAVAR+16*4	;PROGRAM COUNTER (P%)
    54  026c  0000000000000000  DYNVAR:	DEFS	54*2		;DYN. VARIABLE POINTERS
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              00000000          
    55  02d8  0000              FNPTR:	DEFS	2		;DYN. FUNCTION POINTER
    56  02da  0000              PROPTR:	DEFS	2		;DYN. PROCEDURE POINTER
    57                          ;
    58  02dc  0000              PAGE:	DEFS	2		;START OF USER PROGRAM
    59  02de  0000              LOMEM:	DEFS	2		;START OF DYN. STORAGE
    60  02e0  0000              FREE:	DEFS	2		;FIRST FREE-SPACE BYTE
    61  02e2  0000              HIMEM:	DEFS	2		;FIRST BYTE ABOVE STACK
    62  02e4  0000              LIBASE:	DEFS	2		;START OF FIRST LIBRARY
    63                          ;
    64  02e6  0000              TRACEN:	DEFS	2		;TRACE FLAG AND NUMBER
    65  02e8  0000              AUTONO:	DEFS	2		;AUTO FLAG AND NUMBER
    66  02ea  0000              ERRTRP:	DEFS	2		;ON ERROR STMT POINTER \
    67  02ec  0000              ONERSP:	DEFS	2		;ON ERROR LOCAL STKPTR /
    68  02ee  0000              ERRTXT:	DEFS	2		;ERROR MESSAGE POINTER
    69  02f0  0000              DATPTR:	DEFS	2		;DATA POINTER
    70  02f2  0000              ERL:	DEFS	2		;LINE NO OF LAST ERROR
    71  02f4  0000              CURLIN:	DEFS	2		;POINTER TO CURRENT LINE
    72  02f6  0000000000        RANDOM:	DEFS	5		;RANDOM NUMBER
    73  02fb  00                COUNT:	DEFS	1		;PRINT POSITION
    74  02fc  00                WIDTH:	DEFS	1		;PRINT WIDTH
    75  02fd  00                ERR:	DEFS	1		;ERROR NUMBER
    76  02fe  00                LISTON:	DEFS	1		;LISTO & OPT FLAG
    77  02ff  00                INCREM:	DEFS	1		;AUTO INCREMENT
    78  0300  00                DOS_VER:	DEFS	1		;MSX-DOS VERSION
    79                          USER:	;END
