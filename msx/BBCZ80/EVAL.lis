   846                          ;
   847                          ;VARIABLE-TYPE FUNCTIONS:
   848                          ;
   849                          ;Result returned in HLH'L'C (floating point)
   850                          ;Result returned in HLH'L' (C=0) (integer)
   851                          ;Result returned in string accumulator & DE (string)
   852                          ;All registers destroyed.
   853                          ;IY (text pointer) updated.
   854                          ;Bit 7 of A indicates type: 0 = numeric, 1 = string.
   855                          ;
   856                          ;
   857                          ;POS - horizontal cursor position.
   858                          ;VPOS - vertical cursor position.
   859                          ;EOF - return status of file.
   860                          ;BGET - read byte from file.
   861                          ;INKEY - as GET but wait only n centiseconds.
   862                          ;GET - wait for keypress and return ASCII value.
   863                          ;GET(n) - input from Z80 port n.
   864                          ;ASC - ASCII value of string.
   865                          ;LEN - length of string.
   866                          ;LOMEM - location of dynamic variables.
   867                          ;HIMEM - top of available RAM.
   868                          ;PAGE - start of current text page.
   869                          ;TOP - address of first free byte after program.
   870                          ;ERL - line number where last error occurred.
   871                          ;ERR - number of last error.
   872                          ;COUNT - number of printing characters since CR.
   873                          ;Results are integer numeric.
   874                          ;
   875  044f  cd0000            TINT:	CALL	TINTFN
   876  0452  187b              	JR	COUNT1
   877  0454  cd0000            POS:	CALL	GETCSR
   878  0457  eb                	EX	DE,HL
   879  0458  1875              	JR	COUNT1
   880  045a  cd0000            VPOS:	CALL	GETCSR
   881  045d  1870              	JR	COUNT1
   882  045f  cd0000            EOF:	CALL	CHANEL
   883  0462  cd0000            	CALL	OSSTAT
   884  0465  ca3c05            	JP	Z,TRUE
   885  0468  c37809            	JP	ZERO
   886  046b  cd0000            BGET:	CALL	CHANEL		;CHANNEL NUMBER
   887  046e  cd0000            	CALL	OSBGET
   888  0471  6f                	LD	L,A
   889  0472  1859              	JR	COUNT0
   890  0474  cd0e08            INKEY:	CALL	INKEYS
   891  0477  1819              	JR	ASC0
   892  0479  cd0000            GET:	CALL	NXT
   893  047c  fe28              	CP	'('
   894  047e  200a              	JR	NZ,GET0
   895  0480  cdde01            	CALL	ITEMI		;PORT ADDRESS
   896  0483  d9                	EXX
   897  0484  44                	LD	B,H
   898  0485  4d                	LD	C,L
   899  0486  ed68              	IN	L,(C)		;INPUT FROM PORT BC
   900  0488  1843              	JR	COUNT0
   901  048a  cdac07            GET0:	CALL	GETS
   902  048d  1808              	JR	ASC1
   903  048f  cde701            ASC:	CALL	ITEMS
   904  0492  af                ASC0:	XOR	A
   905  0493  bb                	CP	E
   906  0494  ca3c05            	JP	Z,TRUE		;NULL STRING
