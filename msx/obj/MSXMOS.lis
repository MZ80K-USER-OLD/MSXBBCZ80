  1509                          ;
  1510                          ;PTEXT - Print text
  1511                          ;   Inputs: HL = address of text
  1512                          ;            B = number of characters to print
  1513                          ; Destroys: A,B,H,L,F
  1514                          ;
  1515  0850  f5                CPTEXT:	PUSH	AF
  1516  0851  3e3a              	LD	A,':'
  1517  0853  cd1a09            	CALL	OSWRCH
  1518  0856  f1                	POP	AF
  1519  0857  cd1a09            SPTEXT:	CALL	OSWRCH
  1520  085a  7e                PTEXT:	LD	A,(HL)
  1521  085b  e67f              	AND	7FH
  1522  085d  23                	INC	HL
  1523  085e  cd1a09            	CALL	OSWRCH
  1524  0861  10f7              	DJNZ	PTEXT
  1525  0863  c9                	RET
  1526                          ;
  1527                          ;OSINIT - Initialise RAM mapping etc.
  1528                          ;If BASIC is entered by BBCBASIC FILENAME then file
  1529                          ;FILENAME.BBC is automatically CHAINed.
  1530                          ;   Outputs: DE = initial value of HIMEM (top of RAM)
  1531                          ;            HL = initial value of PAGE (user program)
  1532                          ;            Z-flag reset indicates AUTO-RUN.
  1533                          ;  Destroys: A,B,C,D,E,H,L,F
  1534                          ;
  1535  0864  0e2d              OSINIT:	LD	C,45		;*
  1536  0866  1efe              	LD	E,254		;*
  1537  0868  cd0500            	CALL	BDOS		;*
  1538  086b  af                	XOR	A
  1539  086c  0615              	LD	B,INILEN
  1540  086e  21ac09            	LD	HL,TABLE
  1541  0871  77                CLRTAB:	LD	(HL),A		;CLEAR FILE TABLE ETC.
  1542  0872  23                	INC	HL
  1543  0873  10fc              	DJNZ	CLRTAB
  1544  0875  110000            	LD	DE,ACCS
  1545  0878  218000            	LD	HL,DSKBUF
  1546  087b  4e                	LD	C,(HL)
  1547  087c  23                	INC	HL
  1548  087d  b9                	CP	C		;N.B. A=B=0
  1549  087e  2802              	JR	Z,NOBOOT
  1550  0880  edb0              	LDIR			;COPY TO ACCS
  1551  0882  eb                NOBOOT:	EX	DE,HL
  1552  0883  360d              	LD	(HL),CR
  1553  0885  ed5b0600          	LD	DE,(6)		;DE = HIMEM
  1554  0889  5f                	LD	E,A		;PAGE BOUNDARY
  1555  088a  210000            	LD	HL,USER
  1556  088d  c9                	RET
  1557                          ;
  1558                          ;
  1559                          ;TRAP - Test ESCAPE flag and abort if set;
  1560                          ;       every 20th call, test for keypress.
  1561                          ; Destroys: A,H,L,F
  1562                          ;
  1563                          ;LTRAP - Test ESCAPE flag and abort if set.
  1564                          ; Destroys: A,F
  1565                          ;
  1566  088e  21ab09            TRAP:	LD	HL,TRPCNT
  1567  0891  35                	DEC	(HL)
  1568  0892  cca208            	CALL	Z,TEST20	;TEST KEYBOARD
  1569  0895  3abc09            LTRAP:	LD	A,(FLAGS)	;ESCAPE FLAG
  1570  0898  b7                	OR	A		;TEST
  1571  0899  f0                	RET	P
  1572  089a  21bc09            ABORT:	LD	HL,FLAGS	;ACKNOWLEDGE
  1573  089d  cbbe              	RES	7,(HL)		;ESCAPE
  1574  089f  c30000            	JP	ESCAPE		;AND ABORT
  1575                          ;
  1576                          ;TEST - Sample for ESCape and CTRL/S. If ESCape
  1577                          ;       pressed set ESCAPE flag and return.
  1578                          ; Destroys: A,F
  1579                          ;
  1580  08a2  3614              TEST20:	LD	(HL),20
  1581  08a4  d5                TEST:	PUSH	DE
  1582  08a5  3e06              	LD	A,6
  1583  08a7  1eff              	LD	E,0FFH
  1584  08a9  cda803            	CALL	BDOS0
  1585  08ac  d1                	POP	DE
  1586  08ad  b7                	OR	A
  1587  08ae  c8                	RET	Z
  1588  08af  fe13              	CP	'S' & 1FH	;PAUSE DISPLAY?
  1589  08b1  281e              	JR	Z,OSRDCH
  1590  08b3  fe1b              	CP	ESC
  1591  08b5  2857              	JR	Z,ESCSET
  1592  08b7  32bd09            	LD	(INKEY),A
  1593  08ba  c9                	RET
  1594                          ;
  1595                          ;OSRDCH - Read from the current input stream (keyboard).
  1596                          ;  Outputs: A = character
  1597                          ; Destroys: A,F
  1598                          ;
  1599  08bb  dd46f4            KEYGET:	LD	B,(IX-12)	;SCREEN WIDTH
  1600  08be  cdd108            	CALL	OSRDCH
  1601  08c1  fe7f              	CP	DEL
  1602  08c3  2809              	JR	Z,KEYDEL
  1603  08c5  fee0              	CP	224
  1604  08c7  c0                	RET	NZ
  1605  08c8  cdd108            	CALL	OSRDCH
  1606  08cb  d641              	SUB	65
  1607  08cd  c9                	RET
  1608                          ;
  1609  08ce  3e08              KEYDEL:	LD	A,BS
  1610  08d0  c9                	RET
  1611                          ;
  1612  08d1  3abc09            OSRDCH:	LD	A,(FLAGS)
  1613  08d4  1f                	RRA			;*EXEC ACTIVE?
  1614  08d5  380a              	JR	C,EXECIN
  1615  08d7  e5                	PUSH	HL
  1616  08d8  ed62              	SBC	HL,HL		;HL=0
  1617  08da  cdf908            	CALL	OSKEY
  1618  08dd  e1                	POP	HL
  1619  08de  d8                	RET	C
  1620  08df  18f0              	JR	OSRDCH
  1621                          ;
  1622                          ;EXECIN - Read byte from EXEC file
  1623                          ;  Outputs: A = byte read
  1624                          ; Destroys: A,F
  1625                          ;
  1626  08e1  c5                EXECIN:	PUSH	BC		;SAVE REGISTERS
  1627  08e2  d5                	PUSH	DE
  1628  08e3  e5                	PUSH	HL
  1629  08e4  1e08              	LD	E,8		;SPOOL/EXEC CHANNEL
  1630  08e6  21bc09            	LD	HL,FLAGS
  1631  08e9  cb86              	RES	0,(HL)
  1632  08eb  cde302            	CALL	OSBGET
  1633  08ee  cbc6              	SET	0,(HL)
  1634  08f0  f5                	PUSH	AF
  1635  08f1  dc6b00            	CALL	C,SESHUT	;END EXEC IF EOF
  1636  08f4  f1                	POP	AF
  1637  08f5  e1                	POP	HL		;RESTORE REGISTERS
  1638  08f6  d1                	POP	DE
  1639  08f7  c1                	POP	BC
  1640  08f8  c9                	RET
  1641                          ;
  1642                          ;
  1643                          ;OSKEY - Read key with time-limit, test for ESCape.
  1644                          ;Main function is carried out in user patch.
  1645                          ;   Inputs: HL = time limit (centiseconds)
  1646                          ;  Outputs: Carry reset if time-out
  1647                          ;           If carry set A = character
  1648                          ; Destroys: A,H,L,F
  1649                          ;
  1650  08f9  e5                OSKEY:	PUSH	HL
  1651  08fa  21bd09            	LD	HL,INKEY
  1652  08fd  7e                	LD	A,(HL)
  1653  08fe  3600              	LD	(HL),0
  1654  0900  e1                	POP	HL
  1655  0901  b7                	OR	A
  1656  0902  37                	SCF
  1657  0903  c0                	RET	NZ
  1658  0904  d5                	PUSH	DE
  1659  0905  cd0000            	CALL	GETKEY
  1660  0908  d1                	POP	DE
  1661  0909  d0                	RET	NC
  1662  090a  fe1b              	CP	ESC
  1663  090c  37                	SCF
  1664  090d  c0                	RET	NZ
  1665  090e  e5                ESCSET:	PUSH	HL
  1666  090f  21bc09            	LD	HL,FLAGS
  1667  0912  cb76              	BIT	6,(HL)		;ESC DISABLED?
  1668  0914  2002              	JR	NZ,ESCDIS
  1669  0916  cbfe              	SET	7,(HL)		;SET ESCAPE FLAG
  1670  0918  e1                ESCDIS:	POP	HL
  1671  0919  c9                	RET
  1672                          ;
  1673                          ;OSWRCH - Write a character to console output.
  1674                          ;   Inputs: A = character.
  1675                          ; Destroys: Nothing
  1676                          ;
  1677  091a  f5                OSWRCH:	PUSH	AF
  1678  091b  d5                	PUSH	DE
  1679  091c  e5                	PUSH	HL
  1680  091d  cd0000            	CALL  msxCHPUT
  1681  0920  e1                	POP	HL
  1682  0921  d1                	POP	DE
  1683  0922  f1                	POP	AF
  1684  0923  c9                	RET
  1685                          ;
  1686                          ;OSLINE - Read/edit a complete line, terminated by CR.
  1687                          ;   Inputs: HL addresses destination buffer.
  1688                          ;           (L=0)
  1689                          ;  Outputs: Buffer filled, terminated by CR.
  1690                          ;           A=0.
  1691                          ; Destroys: A,B,C,D,E,H,L,F
  1692                          ;
  1693                          OSLINE:
  1694                          INLINE:
  1695  0924  eb                	EX DE,HL
  1696  0925  d5                	PUSH DE
  1697  0926  cd0000            	CALL msxPINLINE   ; 一行入力 入力先 BUF
  1698  0929  d1                    POP DE
  1699  092a  380d              	JR C,OSLINE_STOP   ; CTRL-STOPが押されたら終わり
  1700                          INLINE0:
  1701  092c  23                	INC HL 		; HL=BUF-1 　だから
  1702  092d  7e                	LD A,(HL)
  1703  092e  12                	LD (DE),A
  1704  092f  13                	INC DE
  1705  0930  b7                	OR A
  1706  0931  20f9              	JR NZ,INLINE0
  1707  0933  12                	LD (DE),A	; NULL 終端
  1708  0934  1b                	DEC DE
  1709  0935  3e0d              	LD A,CR
  1710  0937  12                	LD (DE),A	; 0DH,NULL
  1711  0938  c9                	RET
  1712                          
  1713                          OSLINE_STOP:
  1714  0939  3e0d              	LD A,CR
  1715  093b  12                	LD (DE),A	; 0DH
  1716  093c  13                	INC DE
  1717  093d  af                	XOR A
  1718  093e  12                	LD (DE),A	; NULL 終端
  1719  093f  37                	SCF			; CTRL-STOPが押されたことを示す
  1720  0940  c9                	RET
  1721                          ;
  1722                          ; INIT SCREEN
  1723                          ;
  1724                          INITTXT:
  1725  0941  3e50              	LD A,80
  1726  0943  320000            	LD (WIDTH),A
  1727  0946  c30000            	JP msxINITXT80
