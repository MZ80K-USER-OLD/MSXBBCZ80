    45                          ;
    46                          ;n.b. ACCS, BUFFER & STAVAR must be on page boundaries.
    47                          ;
    48                          
    49  0000  0000000000000000  ACCS:	DEFS	256		;STRING ACCUMULATOR
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
