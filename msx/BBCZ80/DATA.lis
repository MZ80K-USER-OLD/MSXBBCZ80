    63                          OC	EQU	STAVAR+15*4	;CODE ORIGIN (O%)
    64                          PC	EQU	STAVAR+16*4	;PROGRAM COUNTER (P%)
    65  026c  0000000000000000  DYNVAR:	DEFS	54*2		;DYN. VARIABLE POINTERS
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              00000000          
    66  02d8  0000              FNPTR:	DEFS	2		;DYN. FUNCTION POINTER
    67  02da  0000              PROPTR:	DEFS	2		;DYN. PROCEDURE POINTER
    68                          ;
    69  02dc  0000              PAGE:	DEFS	2		;START OF USER PROGRAM
    70  02de  0000              LOMEM:	DEFS	2		;START OF DYN. STORAGE
    71  02e0  0000              FREE:	DEFS	2		;FIRST FREE-SPACE BYTE
    72  02e2  0000              HIMEM:	DEFS	2		;FIRST BYTE ABOVE STACK
    73  02e4  0000              LIBASE:	DEFS	2		;START OF FIRST LIBRARY
    74                          ;
    75  02e6  0000              TRACEN:	DEFS	2		;TRACE FLAG AND NUMBER
    76  02e8  0000              AUTONO:	DEFS	2		;AUTO FLAG AND NUMBER
    77  02ea  0000              ERRTRP:	DEFS	2		;ON ERROR STMT POINTER \
    78  02ec  0000              ONERSP:	DEFS	2		;ON ERROR LOCAL STKPTR /
    79  02ee  0000              ERRTXT:	DEFS	2		;ERROR MESSAGE POINTER
    80  02f0  0000              DATPTR:	DEFS	2		;DATA POINTER
    81  02f2  0000              ERL:	DEFS	2		;LINE NO OF LAST ERROR
    82  02f4  0000              CURLIN:	DEFS	2		;POINTER TO CURRENT LINE
    83  02f6  0000000000        RANDOM:	DEFS	5		;RANDOM NUMBER
    84  02fb  00                COUNT:	DEFS	1		;PRINT POSITION
    85  02fc  00                WIDTH:	DEFS	1		;PRINT WIDTH
    86  02fd  00                ERR:	DEFS	1		;ERROR NUMBER
    87  02fe  00                LISTON:	DEFS	1		;LISTO & OPT FLAG
    88  02ff  00                INCREM:	DEFS	1		;AUTO INCREMENT
    89                          ; OS WORK AREAA
    90  0300  00                FILE_HANDLE:	DEFS	1		;MSX-DOS2 file handle used by OSLOAD
    91  0301  0000              FILE_BUFADRS:	DEFS	2		; バッファのアドレス保存用
    92  0303  0000              FILE_COUNTS:	DEFS	2		; 累積読み込みバイト数
    93  0305  0000              FILE_MAXSIZE:	DEFS	2		; 最大読み込みバイト数
    94  0307  0000              SEEK_PREV_L:    DEFS    2       ; 読み込み前ポインタ下位16bit
    95  0309  0000              SEEK_PREV_H:    DEFS    2       ; 読み込み前ポインタ上位16bit
    96  030b  0000              SEEK_CUR_L:     DEFS    2       ; 読み込み後ポインタ下位16bit
    97  030d  0000              SEEK_CUR_H:     DEFS    2       ; 読み込み後ポインタ上位16bit
    98  030f  0000              REQ_BYTES:      DEFS    2       ; 読み込み要求バイト数
    99  0311  0000000000000000  PATHBUF:	DEFS	64		;PATH WORK BUFFER FOR MSX-DOS2 / SUBDIR SUPPORT
