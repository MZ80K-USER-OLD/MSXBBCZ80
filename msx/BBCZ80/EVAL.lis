   209                          ;
   210                          ;EXPR - VARIABLE-TYPE EXPRESSION EVALUATION
   211                          ; Expression type is returned in A'F':
   212                          ; Numeric - A' bit 7=0, F' sign bit cleared.
   213                          ; String - A' bit 7=1, F' sign bit set.
   214                          ;Floating-point or integer result returned in HLH'L'C
   215                          ; Integer result denoted by C=0 and HLH'L' non-zero.
   216                          ;String result returned in string accumulator, DE set.
   217                          ;
   218                          ;Hierarchy is: (1) Variables, functions,
   219                          ; constants, bracketed expressions.
   220                          ; (2) ^
   221                          ; (3) * / MOD DIV
   222                          ; (4) + -
   223                          ; (5) = <> <= >= > <
   224                          ; (6) AND
   225                          ; (7) EOR OR
   226                          ;
   227  0080  cd9500            EXPR:	CALL	EXPR1		;GET FIRST OPERAND
   228  0083  fe82              EXPR0A:	CP	EOR		;CHECK OPERATOR
   229  0085  2803              	JR	Z,EXPR0B
   230  0087  fe84              	CP	OR
   231  0089  c0                	RET	NZ
   232  008a  cdf309            EXPR0B:	CALL	SAVE		;SAVE FIRST OPERAND
   233  008d  cd9500            	CALL	EXPR1		;GET SECOND OPERAND
   234  0090  cd030a            	CALL	DOIT		;DO OPERATION
   235  0093  18ee              	JR	EXPR0A		;CONTINUE
   236                          ;
   237  0095  cda600            EXPR1:	CALL	EXPR2
   238  0098  fe80              EXPR1A:	CP	AND
   239  009a  c0                	RET	NZ
   240  009b  cdf309            	CALL	SAVE
   241  009e  cda600            	CALL	EXPR2
   242  00a1  cd030a            	CALL	DOIT
   243  00a4  18f2              	JR	EXPR1A
   244                          ;
   245  00a6  cd1e01            EXPR2:	CALL	EXPR3
   246  00a9  cdea09            	CALL	RELOPQ
   247  00ac  c0                	RET	NZ
   248  00ad  47                	LD	B,A
   249  00ae  fd23              	INC	IY		;BUMP OVER OPERATOR
   250  00b0  cd0000            	CALL	NXT
   251  00b3  cdea09            	CALL	RELOPQ		;COMPOUND OPERATOR?
   252  00b6  2007              	JR	NZ,EXPR2B
   253  00b8  fd23              	INC	IY
   254  00ba  b8                	CP	B
   255  00bb  281c              	JR	Z,SHIFT		;SHIFT OR ==
   256  00bd  80                	ADD	A,B
   257  00be  47                	LD	B,A
   258  00bf  78                EXPR2B:	LD	A,B
   259  00c0  08                	EX	AF,AF'
   260  00c1  faf100            	JP	M,EXPR2S
   261  00c4  08                	EX	AF,AF'
   262  00c5  d604              	SUB	4
   263  00c7  fe3a              	CP	'>'-4
   264  00c9  2002              	JR	NZ,EXPR2C
   265  00cb  c602              	ADD	A,2
   266  00cd  e60f              EXPR2C:	AND	0FH
   267  00cf  cdf709            EXPR2D:	CALL	SAVE1
   268  00d2  cd1e01            	CALL	EXPR3
   269  00d5  cd030a            	CALL	DOIT		;Must NOT be "JP DOIT"
   270  00d8  c9                	RET
   271                          ;
   272  00d9  fe3d              SHIFT:	CP	'='
   273  00db  28e2              	JR	Z,EXPR2B	;==
   274  00dd  cd0000            	CALL	NXT
   275  00e0  cdea09            	CALL	RELOPQ
   276  00e3  2007              	JR	NZ,SHIFT1
   277  00e5  b8                	CP	B
   278  00e6  c20000            	JP	NZ,SYNTAX
   279  00e9  fd23              	INC	IY
   280  00eb  04                	INC	B
   281  00ec  78                SHIFT1:	LD	A,B
   282  00ed  d610              	SUB	16
   283  00ef  18de              	JR	EXPR2D
