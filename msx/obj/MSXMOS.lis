    91                          ;
    92                          ;
    93                          ;OSSAVE - Save an area of memory to a file.
    94                          ;   Inputs: HL addresses filename (term CR)
    95                          ;           DE = start address of data to save
    96                          ;           BC = length of data to save (bytes)
    97                          ; Destroys: A,B,C,D,E,H,L,F
    98                          ;
    99  0000  cd3106            STSAVE:	CALL	SAVLOD		;*SAVE
   100  0003  daff05            	JP	C,HUH		;"Bad command"
   101  0006  e5                	PUSH	HL
   102  0007  1804              	JR	OSS1
   103                          ;
   104  0009  c5                OSSAVE:	PUSH	BC		;SAVE
   105  000a  cd8d04            	CALL	SETUP0
   106  000d  eb                OSS1:	EX	DE,HL
   107  000e  cda003            	CALL	CREATE
   108  0011  2014              	JR	NZ,SAVE
   109  0013  3ebe              DIRFUL:	LD	A,190
   110  0015  cd0000            	CALL	EXTERR
   111  0018  4469726563746f72  	DEFM	"Directory full"
              792066756c6c      
   112  0026  00                	DEFB	0
   113  0027  cd7203            SAVE:	CALL	WRITE
   114  002a  09                	ADD	HL,BC
   115  002b  e3                	EX	(SP),HL
   116  002c  ed42              	SBC	HL,BC
   117  002e  e3                	EX	(SP),HL
   118  002f  2802              	JR	Z,SAVE1
   119  0031  30f4              	JR	NC,SAVE
   120  0033  c1                SAVE1:	POP	BC
   121  0034  3e10              CLOSE:	LD	A,16
   122  0036  cd4603            	CALL	BDOS1
   123  0039  3c                	INC	A
   124  003a  c0                	RET	NZ
   125  003b  3ec8              	LD	A,200
   126  003d  cd0000            	CALL	EXTERR
   127  0040  436c6f7365206572  	DEFM	"Close error"
              726f72            
   128  004b  00                	DEFB	0
   129                          ;
   130                          ;OSSHUT - Close disk file(s).
   131                          ;   Inputs: E = file channel
   132                          ;           If E=0 all files are closed (except SPOOL)
   133                          ; Destroys: A,B,C,D,E,H,L,F
   134                          ;
   135  004c  7b                OSSHUT:	LD	A,E
   136  004d  b7                	OR	A
   137  004e  200b              	JR	NZ,SHUTIT
   138  0050  1c                SHUT0:	INC	E
   139  0051  cb5b              	BIT	3,E
   140  0053  c0                	RET	NZ
   141  0054  d5                	PUSH	DE
   142  0055  cd6c00            	CALL	SHUT1
   143  0058  d1                	POP	DE
   144  0059  18f5              	JR	SHUT0
   145                          ;
   146  005b  cdf903            SHUTIT:	CALL	FIND1
   147  005e  2010              	JR	NZ,SHUT2
   148  0060  c3e403            	JP	CHANER
   149                          ;
   150  0063  217109            SESHUT:	LD	HL,FLAGS
   151  0066  cb86              	RES	0,(HL)		;STOP EXEC
   152  0068  cb8e              	RES	1,(HL)		;STOP SPOOL
   153  006a  1e08              	LD	E,8		;SPOOL/EXEC CHANNEL
   154  006c  cdf903            SHUT1:	CALL	FIND1
   155  006f  c8                	RET	Z
   156  0070  af                SHUT2:	XOR	A
   157  0071  77                	LD	(HL),A
   158  0072  2b                	DEC	HL
   159  0073  77                	LD	(HL),A
   160  0074  212500            	LD	HL,37
   161  0077  19                	ADD	HL,DE
   162  0078  cb7e              	BIT	7,(HL)
   163  007a  23                	INC	HL
   164  007b  c47203            	CALL	NZ,WRITE
   165  007e  21a600            	LD	HL,FCBSIZ
   166  0081  19                	ADD	HL,DE
   167  0082  ed4b0000          	LD	BC,(FREE)
   168  0086  ed42              	SBC	HL,BC
   169  0088  20aa              	JR	NZ,CLOSE
   170  008a  ed530000          	LD	(FREE),DE	;RELEASE SPACE
   171  008e  18a4              	JR	CLOSE
   172                          ;
   173                          ;TYPE - *TYPE command.
   174                          ;Types file to console output.
   175                          ;
   176  0090  37                TYPE:	SCF			;*TYPE
   177  0091  cd2c02            	CALL	OSOPEN
   178  0094  b7                	OR	A
   179  0095  2830              	JR	Z,NOTFND
   180  0097  5f                	LD	E,A
   181  0098  3a7109            TYPE1:	LD	A,(FLAGS)	;TEST
   182  009b  cb7f              	BIT	7,A		;FOR
   183  009d  200a              	JR	NZ,TYPESC	;ESCape
   184  009f  cd9802            	CALL	OSBGET
   185  00a2  cdcf08            	CALL	OSWRCH		;N.B. CALLS "TEST"
   186  00a5  30f1              	JR	NC,TYPE1
   187  00a7  18a3              	JR	OSSHUT
   188                          ;
   189  00a9  cd4c00            TYPESC:	CALL	OSSHUT		;CLOSE!
   190  00ac  c34f08            	JP	ABORT
   191                          ;
   192                          ;OSLOAD - Load an area of memory from a file.
   193                          ;   Inputs: HL addresses filename (term CR)
   194                          ;           DE = address at which to load
   195                          ;           BC = maximum allowed size (bytes)
   196                          ;  Outputs: Carry reset indicates no room for file.
   197                          ; Destroys: A,B,C,D,E,H,L,F
   198                          ;
   199  00af  cd3106            STLOAD:	CALL	SAVLOD		;*LOAD
   200  00b2  e5                	PUSH	HL
   201  00b3  180c              	JR	OSL1
   202                          ;
   203  00b5  3a0000            OSLOAD:	LD	A,(DOS_VER)
   204  00b8  fe02              	CP	2
   205  00ba  d2f200            	JP	NC,OSLOAD_DOS2
   206  00bd  c5                OSLOAD_CPM:	PUSH	BC		;LOAD
   207  00be  cd8d04            	CALL	SETUP0
   208  00c1  eb                OSL1:	EX	DE,HL
   209  00c2  cd9603            	CALL	OPEN
   210  00c5  201d              	JR	NZ,LOAD0
   211  00c7  3ed6              NOTFND:	LD	A,214
   212  00c9  cd0000            	CALL	EXTERR
   213  00cc  46696c65206e6f74  	DEFM	"File not found"
              20666f756e64      
   214  00da  00                	DEFB	0
   215  00db  cd4103            LOAD:	CALL	READ
   216  00de  200a              	JR	NZ,LOAD1
   217  00e0  cd8b03            	CALL	INCSEC
   218  00e3  09                	ADD	HL,BC
   219  00e4  e3                LOAD0:	EX	(SP),HL
   220  00e5  ed42              	SBC	HL,BC
   221  00e7  e3                	EX	(SP),HL
   222  00e8  30f1              	JR	NC,LOAD
   223  00ea  c1                LOAD1:	POP	BC
   224  00eb  f5                	PUSH	AF
   225  00ec  cd3400            	CALL	CLOSE
   226  00ef  f1                	POP	AF
   227  00f0  3f                	CCF
   228  00f1  c9                OSCALL:	RET
   229                          
   230                          ;OSLOAD_DOS2 - Load through an MSX-DOS2 file handle.
   231                          ; _READ does not return a reliable byte count on the target, so the count is
   232                          ; calculated from the file-position difference before and after each read.
   233                          ; Each read is limited to 512 bytes.
   234                          ;
   235                          OSLOAD_DOS2:
   236  00f2  ed530000          	LD	(FILE_BUFADRS),DE
   237  00f6  ed430000          	LD	(FILE_MAXSIZE),BC
   238  00fa  cd8d04            	CALL	SETUP0
   239  00fd  cd3d04            	CALL	PATHNORM
   240  0100  cd6004            	CALL	DOS2_DEFAULT_EXT
   241                          
   242  0103  110000            	LD	DE,PATHBUF
   243  0106  3e01              	LD	A,1			; read-only
   244  0108  cd9101            	CALL	HOPEN
   245  010b  b7                	OR	A
   246  010c  c25f01            	JP	NZ,LOAD_DOS2_NOTFOUND
   247                          
   248                          LOAD_DOS2_LOOP:
   249  010f  2a0000            	LD	HL,(FILE_MAXSIZE)
   250  0112  7c                	LD	A,H
   251  0113  b5                	OR	L
   252  0114  2844              	JR	Z,LOAD_DOS2_CLOSE_OK
   253                          
   254  0116  110001            	LD	DE,BLOCKSIZE
   255  0119  b7                	OR	A
   256  011a  ed52              	SBC	HL,DE
   257  011c  3006              	JR	NC,LOAD_DOS2_FULL_BLOCK
   258  011e  19                	ADD	HL,DE
   259  011f  220000            	LD	(REQ_BYTES),HL
   260  0122  1806              	JR	LOAD_DOS2_HAVE_REQUEST
   261                          
   262                          LOAD_DOS2_FULL_BLOCK:
   263  0124  210001            	LD	HL,BLOCKSIZE
   264  0127  220000            	LD	(REQ_BYTES),HL
   265                          
   266                          LOAD_DOS2_HAVE_REQUEST:
   267  012a  ed5b0000          	LD	DE,(FILE_BUFADRS)
   268  012e  2a0000            	LD	HL,(REQ_BYTES)
   269  0131  cda801            	CALL	HREAD
   270  0134  b7                	OR	A
   271  0135  203c              	JR	NZ,LOAD_DOS2_ERROR
   272  0137  7c                	LD	A,H
   273  0138  b5                	OR	L
   274  0139  281f              	JR	Z,LOAD_DOS2_CLOSE_OK
   275                          
   276  013b  ed530000          	LD	(FILE_BUFADRS),DE
   277  013f  ed5b0000          	LD	DE,(FILE_COUNTS)
   278  0143  2a0000            	LD	HL,(FILE_MAXSIZE)
   279  0146  b7                	OR	A
   280  0147  ed52              	SBC	HL,DE
   281  0149  3828              	JR	C,LOAD_DOS2_ERROR
   282  014b  220000            	LD	(FILE_MAXSIZE),HL
   283                          
   284  014e  2a0000            	LD	HL,(REQ_BYTES)
   285  0151  b7                	OR	A
   286  0152  ed52              	SBC	HL,DE
   287  0154  381d              	JR	C,LOAD_DOS2_ERROR
   288  0156  28b7              	JR	Z,LOAD_DOS2_LOOP
   289  0158  1800              	JR	LOAD_DOS2_CLOSE_OK	; short read means EOF
   290                          
   291                          LOAD_DOS2_CLOSE_OK:
   292  015a  cd9e01            	CALL	HCLOSE
   293  015d  37                	SCF
   294  015e  c9                	RET
   295                          
   296                          LOAD_DOS2_NOTFOUND:
   297  015f  3ed6              	LD	A,214
   298  0161  cd0000            	CALL	EXTERR
   299  0164  46696c65206e6f74  	DEFM	"File not found"
              20666f756e64      
   300  0172  00                	DEFB	0
   301                          
   302                          LOAD_DOS2_ERROR:
   303  0173  f5                	PUSH	AF
   304  0174  cd9e01            	CALL	HCLOSE
   305  0177  f1                	POP	AF
   306  0178  3eff              	LD	A,255
   307  017a  cd0000            	CALL	EXTERR
   308  017d  4d53582d444f5332  	DEFM	"MSX-DOS2 file error"
              2066696c65206572  
              726f72            
   309  0190  00                	DEFB	0
   310                          
   311                          ; HOPEN - Open an MSX-DOS2 file.
   312                          ;   Inputs: DE = ASCIIZ filename, A = access mode
   313                          ;  Outputs: A = error code (0 on success), FILE_HANDLE = file handle
   314                          ; Destroys: A,C,DE,HL,F
   315                          HOPEN:
   316  0191  0e43              	LD	C,43H			; _OPEN
   317  0193  cd0500            	CALL	BDOS
   318  0196  b7                	OR	A
   319  0197  c0                	RET	NZ
   320  0198  78                	LD	A,B
   321  0199  320000            	LD	(FILE_HANDLE),A
   322  019c  af                	XOR	A
   323  019d  c9                	RET
   324                          
   325                          ; HCLOSE - Close an MSX-DOS2 file handle.
   326                          ;   Inputs: FILE_HANDLE = file handle
   327                          ;  Outputs: A = error code (0 on success)
   328                          ; Destroys: A,BC,DE,HL,F
   329                          HCLOSE:
   330  019e  3a0000            	LD	A,(FILE_HANDLE)
   331  01a1  47                	LD	B,A
   332  01a2  0e45              	LD	C,45H			; _CLOSE
   333  01a4  cd0500            	CALL	BDOS
   334  01a7  c9                	RET
   335                          
   336                          ; HREAD - Read bytes through an MSX-DOS2 file handle.
   337                          ;   Inputs: FILE_HANDLE = file handle, DE = destination buffer,
   338                          ;           HL = requested bytes
   339                          ;  Outputs: A = error code (0 on success), DE = next buffer address,
   340                          ;           HL = actual bytes read
   341                          ; Destroys: A,BC,F
   342                          HREAD:
   343  01a8  ed530000          	LD	(FILE_BUFADRS),DE
   344  01ac  220000            	LD	(REQ_BYTES),HL
   345  01af  3a0000            	LD	A,(FILE_HANDLE)
   346  01b2  47                	LD	B,A
   347  01b3  cdf101            	CALL	DOS2_SEEK_CURRENT
   348  01b6  c0                	RET	NZ
   349  01b7  220000            	LD	(SEEK_PREV_L),HL
   350  01ba  ed530000          	LD	(SEEK_PREV_H),DE
   351                          
   352  01be  3a0000            	LD	A,(FILE_HANDLE)
   353  01c1  47                	LD	B,A
   354  01c2  ed5b0000          	LD	DE,(FILE_BUFADRS)
   355  01c6  2a0000            	LD	HL,(REQ_BYTES)
   356  01c9  0e46              	LD	C,46H			; _READ
   357  01cb  cd0500            	CALL	BDOS
   358  01ce  b7                	OR	A
   359  01cf  c0                	RET	NZ
   360                          
   361  01d0  3a0000            	LD	A,(FILE_HANDLE)
   362  01d3  47                	LD	B,A
   363  01d4  cdf101            	CALL	DOS2_SEEK_CURRENT
   364  01d7  c0                	RET	NZ
   365  01d8  220000            	LD	(SEEK_CUR_L),HL
   366  01db  ed530000          	LD	(SEEK_CUR_H),DE
   367  01df  cdff01            	CALL	DOS2_CALC_DELTA
   368  01e2  3809              	JR	C,HREAD_DELTA_ERROR
   369  01e4  ed5b0000          	LD	DE,(FILE_BUFADRS)
   370  01e8  e5                	PUSH	HL
   371  01e9  19                	ADD	HL,DE
   372  01ea  eb                	EX	DE,HL
   373  01eb  e1                	POP	HL
   374  01ec  c9                	RET
   375                          
   376                          HREAD_DELTA_ERROR:
   377  01ed  3eff              	LD	A,255
   378  01ef  b7                	OR	A
   379  01f0  c9                	RET
   380                          
   381                          ; Return the current 32-bit position in DE:HL.
   382                          DOS2_SEEK_CURRENT:
   383  01f1  3e01              	LD	A,1			; current-position origin, offset zero
   384  01f3  110000            	LD	DE,0
   385  01f6  210000            	LD	HL,0
   386  01f9  0e48              	LD	C,48H			; _SEEK
   387  01fb  cd0500            	CALL	BDOS
   388  01fe  c9                	RET
   389                          
   390                          ; Return HL = low-word delta. Carry indicates a non-zero high-word delta.
   391                          DOS2_CALC_DELTA:
   392  01ff  2a0000            	LD	HL,(SEEK_CUR_L)
   393  0202  ed5b0000          	LD	DE,(SEEK_PREV_L)
   394  0206  b7                	OR	A
   395  0207  ed52              	SBC	HL,DE
   396  0209  e5                	PUSH	HL
   397  020a  2a0000            	LD	HL,(SEEK_CUR_H)
   398  020d  ed5b0000          	LD	DE,(SEEK_PREV_H)
   399  0211  ed52              	SBC	HL,DE
   400  0213  d1                	POP	DE
   401  0214  7c                	LD	A,H
   402  0215  b5                	OR	L
   403  0216  2006              	JR	NZ,DOS2_DELTA_ERROR
   404  0218  eb                	EX	DE,HL
   405  0219  220000            	LD	(FILE_COUNTS),HL
   406  021c  b7                	OR	A
   407  021d  c9                	RET
   408                          
   409                          DOS2_DELTA_ERROR:
   410  021e  37                	SCF
   411  021f  c9                	RET
   412                          ;
   413                          ;OSOPEN - Open a file for reading or writing.
   414                          ;   Inputs: HL addresses filename (term CR)
   415                          ;           Carry set for OPENIN, cleared for OPENOUT.
   416                          ;  Outputs: A = file channel (=0 if cannot open)
   417                          ;           DE = file FCB
   418                          ; Destroys: A,B,C,D,E,H,L,F
   419                          ;
   420  0220  f5                OPENIT:	PUSH	AF		;SAVE CARRY
   421  0221  cd8d04            	CALL	SETUP0
   422  0224  f1                	POP	AF
   423  0225  d4a003            	CALL	NC,CREATE
   424  0228  dc9603            	CALL	C,OPEN
   425  022b  c9                	RET
   426                          ;
   427  022c  cd2002            OSOPEN:	CALL	OPENIT
   428  022f  c8                	RET	Z		;ERROR
   429  0230  0607              	LD	B,7		;MAX. NUMBER OF FILES
   430  0232  217009            	LD	HL,TABLE+15
   431  0235  7e                OPEN1:	LD	A,(HL)
   432  0236  2b                	DEC	HL
   433  0237  b6                	OR	(HL)
   434  0238  281c              	JR	Z,OPEN2		;FREE CHANNEL
   435  023a  2b                	DEC	HL
   436  023b  10f8              	DJNZ	OPEN1
   437  023d  3ec0              	LD	A,192
   438  023f  cd0000            	CALL	EXTERR
   439  0242  546f6f206d616e79  	DEFM	"Too many open files"
              206f70656e206669  
              6c6573            
   440  0255  00                	DEFB	0
   441                          ;
   442  0256  ed5b0000          OPEN2:	LD	DE,(FREE)	;FREE SPACE POINTER
   443  025a  73                	LD	(HL),E
   444  025b  23                	INC	HL
   445  025c  72                	LD	(HL),D
   446  025d  78                	LD	A,B		;CHANNEL (1-7)
   447  025e  21a600            	LD	HL,FCBSIZ
   448  0261  19                	ADD	HL,DE		;RESERVE SPACE
   449  0262  220000            	LD	(FREE),HL
   450  0265  215c00            OPEN3:	LD	HL,FCB		;ENTRY FROM SPOOL/EXEC
   451  0268  d5                	PUSH	DE
   452  0269  012400            	LD	BC,36
   453  026c  edb0              	LDIR			;COPY FCB
   454  026e  eb                	EX	DE,HL
   455  026f  23                	INC	HL
   456  0270  71                	LD	(HL),C		;CLEAR PTR
   457  0271  23                	INC	HL
   458  0272  d1                	POP	DE
   459  0273  47                	LD	B,A
   460  0274  cd2103            	CALL	RDF		;READ OR FILL
   461  0277  78                	LD	A,B
   462  0278  c30000            	JP	CHECK
   463                          ;
   464                          ;OSBPUT - Write a byte to a random disk file.
   465                          ;   Inputs: E = file channel
   466                          ;           A = byte to write
   467                          ; Destroys: A,B,C,F
   468                          ;
   469  027b  d5                OSBPUT:	PUSH	DE
   470  027c  e5                	PUSH	HL
   471  027d  47                	LD	B,A
   472  027e  cdd803            	CALL	FIND
   473  0281  78                	LD	A,B
   474  0282  0600              	LD	B,0
   475  0284  2b                	DEC	HL
   476  0285  70                	LD	(HL),B		;CLEAR EOF
   477  0286  23                	INC	HL
   478  0287  4e                	LD	C,(HL)
   479  0288  cbb9              	RES	7,C
   480  028a  cbfe              	SET	7,(HL)
   481  028c  34                	INC	(HL)
   482  028d  23                	INC	HL
   483  028e  e5                	PUSH	HL
   484  028f  09                	ADD	HL,BC
   485  0290  77                	LD	(HL),A
   486  0291  e1                	POP	HL
   487  0292  cc1e03            	CALL	Z,WRRDF		;WRITE THEN READ/FILL
   488  0295  e1                	POP	HL
   489  0296  d1                	POP	DE
   490  0297  c9                	RET
   491                          ;
   492                          ;OSBGET - Read a byte from a random disk file.
   493                          ;   Inputs: E = file channel
   494                          ;  Outputs: A = byte read
   495                          ;           Carry set if LAST BYTE of file
   496                          ; Destroys: A,B,C,F
   497                          ;
   498  0298  d5                OSBGET:	PUSH	DE
   499  0299  e5                	PUSH	HL
   500  029a  cdd803            	CALL	FIND
   501  029d  4e                	LD	C,(HL)
   502  029e  cbb9              	RES	7,C
   503  02a0  34                	INC	(HL)
   504  02a1  23                	INC	HL
   505  02a2  e5                	PUSH	HL
   506  02a3  0600              	LD	B,0
   507  02a5  09                	ADD	HL,BC
   508  02a6  46                	LD	B,(HL)
   509  02a7  e1                	POP	HL
   510  02a8  ec3903            	CALL	PE,INCRDF	;INC SECTOR THEN READ
   511  02ab  cc1e03            	CALL	Z,WRRDF		;WRITE THEN READ/FILL
   512  02ae  78                	LD	A,B
   513  02af  e1                	POP	HL
   514  02b0  d1                	POP	DE
   515  02b1  c9                	RET
   516                          ;
   517                          ;OSSTAT - Read file status.
   518                          ;   Inputs: E = file channel
   519                          ;  Outputs: Z flag set - EOF
   520                          ;           (If Z then A=0)
   521                          ;           DE = address of file block.
   522                          ; Destroys: A,D,E,H,L,F
   523                          ;
   524  02b2  cdd803            OSSTAT:	CALL	FIND
   525  02b5  2b                	DEC	HL
   526  02b6  7e                	LD	A,(HL)
   527  02b7  3c                	INC	A
   528  02b8  c9                	RET
   529                          ;
   530                          ;GETEXT - Find file size.
   531                          ;   Inputs: E = file channel
   532                          ;  Outputs: DEHL = file size (0-&800000)
   533                          ; Destroys: A,B,C,D,E,H,L,F
   534                          ;
   535  02b9  cdd803            GETEXT:	CALL	FIND
   536  02bc  eb                	EX	DE,HL
   537  02bd  115c00            	LD	DE,FCB
   538  02c0  012400            	LD	BC,36
   539  02c3  d5                	PUSH	DE
   540  02c4  edb0              	LDIR			;COPY FCB
   541  02c6  eb                	EX	DE,HL
   542  02c7  e3                	EX	(SP),HL
   543  02c8  eb                	EX	DE,HL
   544  02c9  3e23              	LD	A,35
   545  02cb  cd4603            	CALL	BDOS1		;COMPUTE SIZE
   546  02ce  e1                	POP	HL
   547  02cf  af                	XOR	A
   548  02d0  1806              	JR	GETPT1
   549                          ;
   550                          ;GETPTR - Return file pointer.
   551                          ;   Inputs: E = file channel
   552                          ;  Outputs: DEHL = pointer (0-&7FFFFF)
   553                          ; Destroys: A,B,C,D,E,H,L,F
   554                          ;
   555  02d2  cdd803            GETPTR:	CALL	FIND
   556  02d5  7e                	LD	A,(HL)
   557  02d6  87                	ADD	A,A
   558  02d7  2b                	DEC	HL
   559  02d8  2b                GETPT1:	DEC	HL
   560  02d9  56                	LD	D,(HL)
   561  02da  2b                	DEC	HL
   562  02db  5e                	LD	E,(HL)
   563  02dc  2b                	DEC	HL
   564  02dd  66                	LD	H,(HL)
   565  02de  6f                	LD	L,A
   566  02df  cb3a              	SRL	D
   567  02e1  cb1b              	RR	E
   568  02e3  cb1c              	RR	H
   569  02e5  cb1d              	RR	L
   570  02e7  c9                	RET
   571                          ;
   572                          ;PUTPTR - Update file pointer.
   573                          ;   Inputs: A = file channel
   574                          ;           DEHL = new pointer (0-&7FFFFF)
   575                          ; Destroys: A,B,C,D,E,H,L,F
   576                          ;
   577  02e8  55                PUTPTR:	LD	D,L
   578  02e9  29                	ADD	HL,HL
   579  02ea  cb13              	RL	E
   580  02ec  43                	LD	B,E
   581  02ed  4c                	LD	C,H
   582  02ee  5f                	LD	E,A		;CHANNEL
   583  02ef  d5                	PUSH	DE
   584  02f0  cdd803            	CALL	FIND
   585  02f3  f1                	POP	AF
   586  02f4  e67f              	AND	7FH
   587  02f6  cb7e              	BIT	7,(HL)		;PENDING WRITE?
   588  02f8  2802              	JR	Z,PUTPT1
   589  02fa  f680              	OR	80H
   590  02fc  77                PUTPT1:	LD	(HL),A
   591  02fd  d5                	PUSH	DE
   592  02fe  e5                	PUSH	HL
   593  02ff  2b                	DEC	HL
   594  0300  2b                	DEC	HL
   595  0301  2b                	DEC	HL
   596  0302  56                	LD	D,(HL)
   597  0303  2b                	DEC	HL
   598  0304  5e                	LD	E,(HL)
   599  0305  eb                	EX	DE,HL
   600  0306  b7                	OR	A
   601  0307  ed42              	SBC	HL,BC
   602  0309  e1                	POP	HL
   603  030a  d1                	POP	DE
   604  030b  c8                	RET	Z
   605  030c  23                	INC	HL
   606  030d  b7                	OR	A
   607  030e  fc7203            	CALL	M,WRITE
   608  0311  e5                	PUSH	HL
   609  0312  2b                	DEC	HL
   610  0313  2b                	DEC	HL
   611  0314  2b                	DEC	HL
   612  0315  3600              	LD	(HL),0
   613  0317  2b                	DEC	HL
   614  0318  70                	LD	(HL),B
   615  0319  2b                	DEC	HL
   616  031a  71                	LD	(HL),C		;NEW RECORD NO.
   617  031b  e1                	POP	HL
   618  031c  1803              	JR	RDF
   619                          ;
   620                          ;WRRDF - Write, read; if EOF fill with zeroes.
   621                          ;RDF - Read; if EOF fill with zeroes.
   622                          ;   Inputs: DE address FCB.
   623                          ;           HL addresses data buffer.
   624                          ;  Outputs: A=0, Z-flag set.
   625                          ;           Carry set if fill done (EOF)
   626                          ; Destroys: A,H,L,F
   627                          ;
   628  031e  cd7203            WRRDF:	CALL	WRITE
   629  0321  cd4103            RDF:	CALL	READ
   630  0324  2b                	DEC	HL
   631  0325  cbbe              	RES	7,(HL)
   632  0327  2b                	DEC	HL
   633  0328  77                	LD	(HL),A		;CLEAR EOF FLAG
   634  0329  c8                	RET	Z
   635  032a  36ff              	LD	(HL),-1		;SET EOF FLAG
   636  032c  23                	INC	HL
   637  032d  23                	INC	HL
   638  032e  c5                	PUSH	BC
   639  032f  af                	XOR	A
   640  0330  0680              	LD	B,128
   641  0332  77                FILL:	LD	(HL),A
   642  0333  23                	INC	HL
   643  0334  10fc              	DJNZ	FILL
   644  0336  c1                	POP	BC
   645  0337  37                	SCF
   646  0338  c9                	RET
   647                          ;
   648                          ;INCRDF - Increment record, read; if EOF fill.
   649                          ;   Inputs: DE addresses FCB.
   650                          ;           HL addresses data buffer.
   651                          ;  Outputs: A=1, Z-flag reset.
   652                          ;           Carry set if fill done (EOF)
   653                          ; Destroys: A,H,L,F
   654                          ;
   655  0339  cd8b03            INCRDF:	CALL	INCSEC
   656  033c  cd2103            	CALL	RDF
   657  033f  3c                	INC	A
   658  0340  c9                	RET
   659                          ;
   660                          ;READ - Read a record from a disk file.
   661                          ;   Inputs: DE addresses FCB.
   662                          ;           HL = address to store data.
   663                          ;  Outputs: A<>0 & Z-flag reset indicates EOF.
   664                          ;           Carry = 0
   665                          ; Destroys: A,F
   666                          ;
   667                          ;BDOS1 - CP/M BDOS call.
   668                          ;   Inputs: A = function number
   669                          ;          DE = parameter
   670                          ;  Outputs: AF = result (carry=0)
   671                          ; Destroys: A,F
   672                          ;
   673  0341  cdd003            READ:	CALL	SETDMA
   674  0344  3e21              	LD	A,33
   675  0346  cd5d03            BDOS1:	CALL	BDOS0
   676  0349  2002              	JR	NZ,CPMERR
   677  034b  b7                	OR	A
   678  034c  c9                	RET
   679  034d  3eff              CPMERR:	LD	A,255
   680  034f  cd0000            	CALL	EXTERR
   681  0352  43502f4d20457272  	DEFM	"CP/M Error"
              6f72              
   682  035c  00                	DEFB	0
   683                          ;
   684  035d  c5                BDOS0:	PUSH	BC
   685  035e  d5                	PUSH	DE
   686  035f  e5                	PUSH	HL
   687  0360  dde5              	PUSH	IX
   688  0362  fde5              	PUSH	IY
   689  0364  4f                	LD	C,A
   690  0365  cd0500            	CALL	BDOS
   691  0368  24                	INC	H
   692  0369  25                	DEC	H
   693  036a  fde1              	POP	IY
   694  036c  dde1              	POP	IX
   695  036e  e1                	POP	HL
   696  036f  d1                	POP	DE
   697  0370  c1                	POP	BC
   698  0371  c9                	RET
   699                          ;
   700                          ;WRITE - Write a record to a disk file.
   701                          ;   Inputs: DE addresses FCB.
   702                          ;           HL = address to get data.
   703                          ; Destroys: A,F
   704                          ;
   705  0372  cdd003            WRITE:	CALL	SETDMA
   706  0375  3e28              	LD	A,40
   707  0377  cd4603            	CALL	BDOS1
   708  037a  280f              	JR	Z,INCSEC
   709  037c  3ec6              	LD	A,198
   710  037e  cd0000            	CALL	EXTERR
   711  0381  4469736b2066756c  	DEFM	"Disk full"
              6c                
   712  038a  00                	DEFB	0
   713                          ;
   714                          ;INCSEC - Increment random record number.
   715                          ;   Inputs: DE addresses FCB.
   716                          ; Destroys: F
   717                          ;
   718  038b  e5                INCSEC:	PUSH	HL
   719  038c  212100            	LD	HL,33
   720  038f  19                	ADD	HL,DE
   721  0390  34                INCS1:	INC	(HL)
   722  0391  23                	INC	HL
   723  0392  28fc              	JR	Z,INCS1
   724  0394  e1                	POP	HL
   725  0395  c9                	RET
   726                          ;
   727                          ;OPEN - Open a file for access.
   728                          ;   Inputs: FCB set up.
   729                          ;  Outputs: DE = FCB
   730                          ;           A=0 & Z-flag set indicates Not Found.
   731                          ;           Carry = 0
   732                          ; Destroys: A,D,E,F
   733                          ;
   734  0396  115c00            OPEN:	LD	DE,FCB
   735  0399  3e0f              	LD	A,15
   736  039b  cd4603            	CALL	BDOS1
   737  039e  3c                	INC	A
   738  039f  c9                	RET
   739                          ;
   740                          ;CREATE - Create a disk file for writing.
   741                          ;   Inputs: FCB set up.
   742                          ;  Outputs: DE = FCB
   743                          ;           A=0 & Z-flag set indicates directory full.
   744                          ;           Carry = 0
   745                          ; Destroys: A,D,E,F
   746                          ;
   747  03a0  cdb203            CREATE:	CALL	CHKAMB
   748  03a3  115c00            	LD	DE,FCB
   749  03a6  3e13              	LD	A,19
   750  03a8  cd4603            	CALL	BDOS1		;DELETE
   751  03ab  3e16              	LD	A,22
   752  03ad  cd4603            	CALL	BDOS1		;MAKE
   753  03b0  3c                	INC	A
   754  03b1  c9                	RET
   755                          ;
   756                          ;CHKAMB - Check for ambiguous filename.
   757                          ; Destroys: A,D,E,F
   758                          ;
   759  03b2  c5                CHKAMB:	PUSH	BC
   760  03b3  115c00            	LD	DE,FCB
   761  03b6  060c              	LD	B,12
   762  03b8  1a                CHKAM1:	LD	A,(DE)
   763  03b9  fe3f              	CP	'?'
   764  03bb  2805              	JR	Z,AMBIG		;AMBIGUOUS
   765  03bd  13                	INC	DE
   766  03be  10f8              	DJNZ	CHKAM1
   767  03c0  c1                	POP	BC
   768  03c1  c9                	RET
   769  03c2  3ecc              AMBIG:	LD	A,204
   770  03c4  cd0000            	CALL	EXTERR
   771  03c7  426164206e616d65  	DEFM	"Bad name"
   772  03cf  00                	DEFB	0
   773                          ;
   774                          ;SETDMA - Set "DMA" address.
   775                          ;   Inputs: HL = address
   776                          ; Destroys: A,F
   777                          ;
   778  03d0  3e1a              SETDMA:	LD	A,26
   779  03d2  eb                	EX	DE,HL
   780  03d3  cd5d03            	CALL	BDOS0
   781  03d6  eb                	EX	DE,HL
   782  03d7  c9                	RET
   783                          ;
   784                          ;FIND - Find file parameters from channel.
   785                          ;   Inputs: E = channel
   786                          ;  Outputs: DE addresses FCB
   787                          ;           HL addresses pointer byte (FCB+37)
   788                          ; Destroys: A,D,E,H,L,F
   789                          ;
   790  03d8  1c                FIND:	INC	E		;N.B. channel 8 is SPOOL/EXEC
   791  03d9  1d                	DEC	E
   792  03da  2808              	JR	Z,CHANER
   793  03dc  cdf903            	CALL	FIND1
   794  03df  212500            	LD	HL,37
   795  03e2  19                	ADD	HL,DE
   796  03e3  c0                	RET	NZ
   797  03e4  3ede              CHANER:	LD	A,222
   798  03e6  cd0000            	CALL	EXTERR
   799  03e9  496e76616c696420  	DEFM	"Invalid channel"
              6368616e6e656c    
   800  03f8  00                	DEFB	0
   801                          ;
   802                          ;FIND1 - Look up file table.
   803                          ;   Inputs: E = channel
   804                          ;  Outputs: Z-flag set = file not opened
   805                          ;           If NZ, DE addresses FCB
   806                          ;                  HL points into table
   807                          ; Destroys: A,D,E,H,L,F
   808                          ;
   809  03f9  7b                FIND1:	LD	A,E
   810  03fa  e607              	AND	7
   811  03fc  87                	ADD	A,A
   812  03fd  5f                	LD	E,A
   813  03fe  1600              	LD	D,0
   814  0400  216109            	LD	HL,TABLE
   815  0403  19                	ADD	HL,DE
   816  0404  5e                	LD	E,(HL)
   817  0405  23                	INC	HL
   818  0406  56                	LD	D,(HL)
   819  0407  7a                	LD	A,D
   820  0408  b3                	OR	E
   821  0409  c9                	RET
   822                          ;
   823                          ;SETUP - Set up File Control Block.
   824                          ;   Inputs: HL addresses filename
   825                          ;           Format  [A:]FILENAME[.EXT]
   826                          ;           Device defaults to current drive
   827                          ;           Extension defaults to .BBC
   828                          ;           A = fill character
   829                          ;  Outputs: HL updated
   830                          ;           A = terminator
   831                          ;           BC = 128
   832                          ; Destroys: A,B,C,H,L,F
   833                          ;
   834                          ; MSX-DOS2 path-aware compatibility shim.
   835                          ; Keep the raw path string in PATHBUF so command handlers can migrate from
   836                          ; CP/M FCB parsing to path-based DOS calls without immediately breaking the
   837                          ; legacy file layer.
   838                          ;
   839  040a  110000            PATHSAVE:	LD	DE,PATHBUF
   840  040d  af                	XOR	A
   841  040e  7e                PATHS1:	LD	A,(HL)
   842  040f  b7                	OR	A
   843  0410  2828              	JR	Z,PATHS2
   844  0412  fe0d              	CP	CR
   845  0414  2824              	JR	Z,PATHS2
   846  0416  fe20              	CP	' '
   847  0418  2820              	JR	Z,PATHS2
   848  041a  fe3d              	CP	'='
   849  041c  281c              	JR	Z,PATHS2
   850  041e  fe22              	CP	'"'
   851  0420  2818              	JR	Z,PATHS2
   852  0422  fe7c              	CP	'|'
   853  0424  2814              	JR	Z,PATHS2
   854  0426  fe2f              	CP	'/'
   855  0428  2809              	JR	Z,PATHS3
   856  042a  fe5c              	CP	5CH		; '\'
   857  042c  2805              	JR	Z,PATHS3
   858  042e  12                	LD	(DE),A
   859  042f  13                	INC	DE
   860  0430  23                	INC	HL
   861  0431  18db              	JR	PATHS1
   862  0433  3e5c              PATHS3:	LD	A,5CH
   863  0435  12                	LD	(DE),A
   864  0436  13                	INC	DE
   865  0437  23                	INC	HL
   866  0438  18d4              	JR	PATHS1
   867  043a  af                PATHS2:	XOR	A
   868  043b  12                	LD	(DE),A
   869  043c  c9                	RET
   870                          ;
   871                          ;PATHNORM - normalise a path string stored in PATHBUF to a DOS2-friendly form.
   872                          ;   Normalises '/' to '\' and uppercases the drive/path characters.
   873                          ;   The original FCB-based layer still receives the CP/M-compatible name, but
   874                          ;   PATHBUF preserves the full path information needed for a later DOS2 switch.
   875                          ;
   876  043d  f5                PATHNORM:	PUSH	AF
   877  043e  d5                	PUSH	DE
   878  043f  e5                	PUSH	HL
   879  0440  210000            	LD	HL,PATHBUF
   880  0443  7e                PATHN1:	LD	A,(HL)
   881  0444  b7                	OR	A
   882  0445  2815              	JR	Z,PATHNEND
   883  0447  fe2f              	CP	'/'
   884  0449  280b              	JR	Z,PATHN2
   885  044b  fe5c              	CP	5CH
   886  044d  2807              	JR	Z,PATHN2
   887  044f  cd7707            	CALL	UPPRC
   888  0452  77                	LD	(HL),A
   889  0453  23                	INC	HL
   890  0454  18ed              	JR	PATHN1
   891  0456  3e5c              PATHN2:	LD	A,5CH
   892  0458  77                	LD	(HL),A
   893  0459  23                	INC	HL
   894  045a  18e7              	JR	PATHN1
   895  045c  e1                PATHNEND:	POP	HL
   896  045d  d1                	POP	DE
   897  045e  f1                	POP	AF
   898  045f  c9                	RET
   899                          
   900                          ; Add the BASIC default extension to PATHBUF when the supplied path has none.
   901                          DOS2_DEFAULT_EXT:
   902  0460  f5                	PUSH	AF
   903  0461  c5                	PUSH	BC
   904  0462  d5                	PUSH	DE
   905  0463  e5                	PUSH	HL
   906  0464  210000            	LD	HL,PATHBUF
   907  0467  0600              	LD	B,0
   908                          DOS2_EXT_SCAN:
   909  0469  7e                	LD	A,(HL)
   910  046a  b7                	OR	A
   911  046b  2808              	JR	Z,DOS2_EXT_END
   912  046d  fe2e              	CP	'.'
   913  046f  2817              	JR	Z,DOS2_EXT_HAVE
   914  0471  23                	INC	HL
   915  0472  04                	INC	B
   916  0473  18f4              	JR	DOS2_EXT_SCAN
   917                          DOS2_EXT_END:
   918  0475  78                	LD	A,B
   919  0476  fe3d              	CP	61			; PATHBUF capacity (including terminator)
   920  0478  300e              	JR	NC,DOS2_EXT_HAVE
   921  047a  362e              	LD	(HL),'.'
   922  047c  23                	INC	HL
   923  047d  3642              	LD	(HL),'B'
   924  047f  23                	INC	HL
   925  0480  3642              	LD	(HL),'B'
   926  0482  23                	INC	HL
   927  0483  3643              	LD	(HL),'C'
   928  0485  23                	INC	HL
   929  0486  3600              	LD	(HL),0
   930                          DOS2_EXT_HAVE:
   931  0488  e1                	POP	HL
   932  0489  d1                	POP	DE
   933  048a  c1                	POP	BC
   934  048b  f1                	POP	AF
   935  048c  c9                	RET
   936                          ;
   937                          ;FCB FORMAT (36 BYTES TOTAL):
   938                          ; 0      0=SAME DISK, 1=DISK A, 2=DISK B (ETC.)
   939                          ; 1-8    FILENAME, PADDED WITH SPACES
   940                          ; 9-11   EXTENSION, PADDED WITH SPACES
   941                          ; 12     CURRENT EXTENT, SET TO ZERO
   942                          ; 32-35  CLEARED TO ZERO
   943                          ;
   944  048d  3e20              SETUP0:	LD	A,' '
   945  048f  d5                SETUP:	PUSH	DE
   946  0490  e5                	PUSH	HL
   947  0491  f5                	PUSH	AF
   948  0492  cd0a04            	CALL	PATHSAVE
   949  0495  f1                	POP	AF
   950  0496  116500            	LD	DE,FCB+9
   951  0499  213d05            	LD	HL,BBC
   952  049c  010300            	LD	BC,3
   953  049f  edb0              	LDIR
   954  04a1  217c00            	LD	HL,FCB+32
   955  04a4  0604              	LD	B,4
   956  04a6  71                SETUP1:	LD	(HL),C
   957  04a7  23                	INC	HL
   958  04a8  10fc              	DJNZ	SETUP1
   959  04aa  e1                	POP	HL
   960  04ab  4f                	LD	C,A
   961  04ac  af                	XOR	A
   962  04ad  12                	LD	(DE),A
   963  04ae  d1                	POP	DE
