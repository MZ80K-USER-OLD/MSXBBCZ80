  3131                          ; WSRCH - search for token, with nesting of inner structures
  3132                          ;
  3133                          ;   Inputs: B = token to find or unnest (anywhere)
  3134                          ;           C = token to nest (anywhere), ignore after EXIT
  3135                          ;           D = ordinal (1 = find first token, 2 = second)
  3136                          ;           IY = address to start looking
  3137                          ;  Outputs: IY points to byte after that found
  3138                          ;           if not found abort to END
  3139                          ; Destroys: A,D,IY,F
  3140                          ;
  3141  12ab  fd7e00            WSRCH:	LD	A,(IY)
