  1680                          ;------------------------------------------------------------------------------
  1681                          ; Check Msx-DOS Version (MSX1 or MSX2)
  1682                          ; ------------------------------------------------------------------------------
  1683                          CheckMSXDOS:
  1684                              ; --- バージョン取得 ---
  1685  08fe  010000                ld   bc, 0000h   ; 初期化
  1686  0901  0e6f                  ld   c, 6Fh      ; _DOSVER
  1687  0903  cd0500                call BDOS       ; BDOS
  1688                          
  1689  0906  78                    ld   a, b        ; メジャーバージョン
  1690  0907  320000                ld   (DOS_VER), a ; 変数に格納
  1691                          
  1692                              ; --- 判定と表示 ---
  1693  090a  3a0000            	ld   a, (DOS_VER)
  1694  090d  fe02                  cp   2
  1695  090f  3006                  jr   nc, print_dos2
  1696                          
  1697                          print_dos1:
  1698  0911  211d09                LD HL, MSG_DOS1
  1699  0914  c30000                JP msxSTRPUT
  1700                          
  1701                          print_dos2:
  1702  0917  212909                LD HL, MSG_DOS2
  1703  091a  c30000                JP msxSTRPUT
  1704                          
  1705                          
  1706                          ; --- データエリア ---
  1707  091d  4d53582d444f5320  MSG_DOS1: DEFB "MSX-DOS 1",0DH,0AH,00
              310d0a00          
  1708  0929  4d53582d444f5320  MSG_DOS2: DEFB "MSX-DOS 2",0DH,0AH,00
              320d0a00          
  1709                          
  1710                          ; ======================================================
  1711                          ; HLレジスタの内容をASCII 4文字で画面に表示する
  1712                          ; ======================================================
  1713                          PrintAddress:
  1714  0935  7c                    ld  a, h
  1715  0936  cd3a09                call PrintHexByte   ; 上位バイト(H)を表示
  1716  0939  7d                    ld  a, l            ; 下位バイト(L)を表示
  1717                              ; そのまま下の PrintHexByte へ流れる (Fall-through)
  1718                          
  1719                          ; --- 1バイト(A)を16進ASCII 2文字で表示 ---
  1720                          PrintHexByte:
  1721  093a  f5                    push af             ; 下位ニブル保存用
  1722  093b  0f                    rrca
  1723  093c  0f                	rrca 		        ; 上位4ビットを下位へ移動
  1724  093d  0f                    rrca
  1725  093e  0f                	rrca
  1726  093f  cd4309                call PrintNibble    ; 上位桁を表示
  1727  0942  f1                    pop  af             ; 下位ニブルを戻す
  1728                              ; そのまま下の PrintNibble へ流れる
  1729                          
  1730                          ; --- 下位4ビット(A)をASCII 1文字で表示 (DAAマジック) ---
  1731                          PrintNibble:
  1732  0943  e60f                  and  0Fh            ; 下位4ビットのみにマスク
  1733  0945  c690                  add  a, 90h         ; 10進補正を利用するためのオフセット
  1734  0947  27                    daa                 ; 0-9はそのまま、A-Fは桁上げが発生
  1735  0948  ce40                  adc  a, 40h         ; ASCII '0'(30h)や'A'(41h)への調整
  1736  094a  27                    daa                 ; 最終的なASCIIコードに確定
  1737                          
  1738                          ; --- [システム依存] 1文字出力ルーチン ---
  1739                              ; Aレジスタの文字を表示します。
  1740                              ; お使いの環境に合わせて書き換えてください。
  1741                          PUTCHAR::
  1742  094b  c30000            	JP msxCHPUT ; 画面に表示 (自動的にXが+1される)
  1743                          
  1744                          PUTCRLF:
  1745  094e  3e0d              	LD A,CR
  1746  0950  cd0000            	CALL msxCHPUT
  1747  0953  3e0a              	LD  A,LF
  1748  0955  c30000            	JP  msxCHPUT
  1749                          
  1750                          PROMPT:
  1751  0958  3e3e              	LD A,'>'
  1752  095a  c30000            	JP msxCHPUT
  1753                          ;
  1754                          ; HLレジスタの指す文字列を画面に出力するルーチン
  1755                          ; 文字列はNULL(0)で終端されているもの
  1756                          STRPUT:
  1757  095d  c30000                JP msxSTRPUT ; 文字列出力
  1758                          
