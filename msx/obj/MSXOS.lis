  1069  05a1  cde706            	CALL	LTRAP
  1070  05a4  dd210000          	LD	IX,DIRFIB
  1071  05a8  0e41              	LD	C,41H		; FNEXT
  1072  05aa  cd0500            	CALL	BDOS
  1073  05ad  c1                	POP	BC
  1074  05ae  b7                	OR	A
  1075  05af  28e2              	JR	Z,DIRD22
  1076  05b1  78                	LD	A,B
  1077  05b2  fe04              	CP	4
  1078  05b4  c40000            	CALL	NZ,CRLF
  1079                          DIRD2END:
  1080  05b7  c9                	RET
