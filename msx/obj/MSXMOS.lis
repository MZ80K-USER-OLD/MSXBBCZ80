   901  0453  af                	XOR	A
   902  0454  12                	LD	(DE),A
   903  0455  d1                	POP	DE
   904  0456  cddd04            	CALL	SKIPSP
   905  0459  fe22              	CP	'"'
   906  045b  2027              	JR	NZ,SETUP2
   907  045d  23                	INC	HL
   908  045e  cddd04            	CALL	SKIPSP
   909  0461  cd8404            	CALL	SETUP2
   910  0464  fe22              	CP	'"'
   911  0466  23                	INC	HL
   912  0467  2874              	JR	Z,SKIPSP
   913  0469  3efd              BADSTR:	LD	A,253
   914  046b  cd0000            	CALL	EXTERR
   915  046e  4261642073747269  	DEFM	"Bad string"
              6e67              
