  1140  060d  f9                	LD	SP,HL		;NEW SP
  1141  060e  eb                	EX	DE,HL
  1142  060f  cd2f01            	CALL	OPEN3		;FINISH OPEN OPERATION
  1143  0612  dde9              JPIX:	JP	(IX)		;"RETURN"
