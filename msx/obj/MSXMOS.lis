   893  0446  edb0              	LDIR
   894  0448  217c00            	LD	HL,FCB+32
   895  044b  0604              	LD	B,4
   896  044d  71                SETUP1:	LD	(HL),C
   897  044e  23                	INC	HL
   898  044f  10fc              	DJNZ	SETUP1
   899  0451  e1                	POP	HL
