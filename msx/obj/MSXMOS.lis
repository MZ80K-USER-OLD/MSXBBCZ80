   870  0454  c9                	RET
   871                          ;
   872                          ;SETUP - Set up File Control Block.
   873                          ;   Inputs: HL addresses filename
   874                          ;           Format  [A:]FILENAME[.EXT]
   875                          ;           Device defaults to current drive
   876                          ;           Extension defaults to .BBC
   877                          ;           A = fill character
   878                          ;  Outputs: HL updated
   879                          ;           A = terminator
   880                          ;           BC = 128
   881                          ; Destroys: A,B,C,H,L,F
   882                          ;
   883                          ; MSX-DOS2 path-aware compatibility shim.
   884                          ; Keep the raw path string in PATHBUF so command handlers can migrate from
   885                          ; CP/M FCB parsing to path-based DOS calls without immediately breaking the
   886                          ; legacy file layer.
   887                          ;
   888  0455  110000            PATHSAVE:	LD	DE,PATHBUF
   889  0458  af                	XOR	A
   890  0459  7e                PATHS1:	LD	A,(HL)
   891  045a  b7                	OR	A
   892  045b  2828              	JR	Z,PATHS2
   893  045d  fe0d              	CP	CR
   894  045f  2824              	JR	Z,PATHS2
   895  0461  fe20              	CP	' '
   896  0463  2820              	JR	Z,PATHS2
   897  0465  fe3d              	CP	'='
   898  0467  281c              	JR	Z,PATHS2
   899  0469  fe22              	CP	'"'
   900  046b  2818              	JR	Z,PATHS2
   901  046d  fe7c              	CP	'|'
   902  046f  2814              	JR	Z,PATHS2
   903  0471  fe2f              	CP	'/'
   904  0473  2809              	JR	Z,PATHS3
   905  0475  fe5c              	CP	5CH		; '\'
   906  0477  2805              	JR	Z,PATHS3
   907  0479  12                	LD	(DE),A
   908  047a  13                	INC	DE
   909  047b  23                	INC	HL
   910  047c  18db              	JR	PATHS1
   911  047e  3e5c              PATHS3:	LD	A,5CH
   912  0480  12                	LD	(DE),A
   913  0481  13                	INC	DE
   914  0482  23                	INC	HL
   915  0483  18d4              	JR	PATHS1
   916  0485  af                PATHS2:	XOR	A
   917  0486  12                	LD	(DE),A
   918  0487  c9                	RET
   919                          ;
   920                          ;PATHNORM - normalise a path string stored in PATHBUF to a DOS2-friendly form.
   921                          ;   Normalises '/' to '\' and uppercases the drive/path characters.
   922                          ;   The original FCB-based layer still receives the CP/M-compatible name, but
   923                          ;   PATHBUF preserves the full path information needed for a later DOS2 switch.
   924                          ;
   925  0488  f5                PATHNORM:	PUSH	AF
   926  0489  d5                	PUSH	DE
   927  048a  e5                	PUSH	HL
   928  048b  210000            	LD	HL,PATHBUF
   929  048e  7e                PATHN1:	LD	A,(HL)
   930  048f  b7                	OR	A
   931  0490  2815              	JR	Z,PATHNEND
   932  0492  fe2f              	CP	'/'
   933  0494  280b              	JR	Z,PATHN2
   934  0496  fe5c              	CP	5CH
   935  0498  2807              	JR	Z,PATHN2
   936  049a  cdc207            	CALL	UPPRC
   937  049d  77                	LD	(HL),A
   938  049e  23                	INC	HL
   939  049f  18ed              	JR	PATHN1
   940  04a1  3e5c              PATHN2:	LD	A,5CH
   941  04a3  77                	LD	(HL),A
   942  04a4  23                	INC	HL
   943  04a5  18e7              	JR	PATHN1
   944  04a7  e1                PATHNEND:	POP	HL
   945  04a8  d1                	POP	DE
   946  04a9  f1                	POP	AF
   947  04aa  c9                	RET
   948                          
   949                          ; Add the BASIC default extension to PATHBUF when the supplied path has none.
   950                          DOS2_DEFAULT_EXT:
   951  04ab  f5                	PUSH	AF
   952  04ac  c5                	PUSH	BC
   953  04ad  d5                	PUSH	DE
   954  04ae  e5                	PUSH	HL
   955  04af  210000            	LD	HL,PATHBUF
   956  04b2  0600              	LD	B,0
   957                          DOS2_EXT_SCAN:
   958  04b4  7e                	LD	A,(HL)
   959  04b5  b7                	OR	A
   960  04b6  2808              	JR	Z,DOS2_EXT_END
   961  04b8  fe2e              	CP	'.'
   962  04ba  2817              	JR	Z,DOS2_EXT_HAVE
   963  04bc  23                	INC	HL
   964  04bd  04                	INC	B
