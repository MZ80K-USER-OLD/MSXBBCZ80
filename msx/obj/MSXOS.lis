  1296                          ;------------------------------------------------------------------------------
  1297                          ; Check Msx-DOS Version (MSX1 or MSX2)
  1298                          ; ------------------------------------------------------------------------------
  1299                          CheckMSXDOS:
  1300                              ; --- バージョン取得 ---
  1301  06ca  010000                ld   bc, 0000h   ; 初期化
  1302  06cd  0e6f                  ld   c, 6Fh      ; _DOSVER
  1303  06cf  cd0500                call BDOS       ; BDOS
  1304                          
  1305  06d2  78                    ld   a, b        ; メジャーバージョン
  1306  06d3  320000                ld   (DOS_VER), a ; 変数に格納
  1307                          
  1308                              ; --- 判定と表示 ---
  1309  06d6  fe02                  cp   2
  1310  06d8  3006                  jr   nc, print_dos2
  1311                          
  1312                          print_dos1:
  1313  06da  21e606                LD HL, MSG_DOS1
  1314  06dd  c30000                JP msxSTRPUT
  1315                          
  1316                          print_dos2:
  1317  06e0  21f206                LD HL, MSG_DOS2
  1318  06e3  c30000                JP msxSTRPUT
  1319                          
  1320                          
  1321                          ; --- データエリア ---
  1322  06e6  4d53582d444f5320  MSG_DOS1: DEFB "MSX-DOS 1",0DH,0AH,00
              310d0a00          
  1323  06f2  4d53582d444f5320  MSG_DOS2: DEFB "MSX-DOS 2",0DH,0AH,00
              320d0a00          
  1324                          
  1325                          ; ======================================================
  1326                          ; HLレジスタの内容をASCII 4文字で画面に表示する
  1327                          ; ======================================================
  1328                          PrintAddress:
  1329  06fe  7c                    ld  a, h
  1330  06ff  cd0307                call PrintHexByte   ; 上位バイト(H)を表示
  1331  0702  7d                    ld  a, l            ; 下位バイト(L)を表示
  1332                              ; そのまま下の PrintHexByte へ流れる (Fall-through)
  1333                          
  1334                          ; --- 1バイト(A)を16進ASCII 2文字で表示 ---
  1335                          PrintHexByte:
  1336  0703  f5                    push af             ; 下位ニブル保存用
  1337  0704  0f                    rrca
  1338  0705  0f                	rrca 		        ; 上位4ビットを下位へ移動
  1339  0706  0f                    rrca
  1340  0707  0f                	rrca
  1341  0708  cd0c07                call PrintNibble    ; 上位桁を表示
  1342  070b  f1                    pop  af             ; 下位ニブルを戻す
  1343                              ; そのまま下の PrintNibble へ流れる
  1344                          
  1345                          ; --- 下位4ビット(A)をASCII 1文字で表示 (DAAマジック) ---
  1346                          PrintNibble:
  1347  070c  e60f                  and  0Fh            ; 下位4ビットのみにマスク
  1348  070e  c690                  add  a, 90h         ; 10進補正を利用するためのオフセット
  1349  0710  27                    daa                 ; 0-9はそのまま、A-Fは桁上げが発生
  1350  0711  ce40                  adc  a, 40h         ; ASCII '0'(30h)や'A'(41h)への調整
  1351  0713  27                    daa                 ; 最終的なASCIIコードに確定
  1352                          
  1353                          ; --- [システム依存] 1文字出力ルーチン ---
  1354                              ; Aレジスタの文字を表示します。
  1355                              ; お使いの環境に合わせて書き換えてください。
  1356                          PUTCHAR::
  1357  0714  c30000            	JP msxCHPUT ; 画面に表示 (自動的にXが+1される)
  1358                          
  1359                          PUTCRLF:
  1360  0717  3e0d              	LD A,CR
  1361  0719  cd0000            	CALL msxCHPUT
  1362  071c  3e0a              	LD  A,LF
  1363  071e  c30000            	JP  msxCHPUT
  1364                          
  1365                          PROMPT:
  1366  0721  3e3e              	LD A,'>'
  1367  0723  c30000            	JP msxCHPUT
  1368                          ;
  1369                          ; HLレジスタの指す文字列を画面に出力するルーチン
  1370                          ; 文字列はNULL(0)で終端されているもの
  1371                          STRPUT:
  1372  0726  c30000                JP msxSTRPUT ; 文字列出力
  1373                          
  1374                          ;
  1375                          ;
  1376                          ;EDITST:	DEFM	"EDIT"
  1377                          ;LISTST:	DEFM	"LIST"
  1378                          ;
  1379                          BEL	EQU	7
  1380                          BS	EQU	8
  1381                          HT	EQU	9
  1382                          LF	EQU	0AH
  1383                          VT	EQU	0BH
  1384                          CR	EQU	0DH
  1385                          ESC	EQU	1BH
  1386                          DEL	EQU	7FH
  1387                          ;
  1388                          BDOS	EQU	5
  1389                          ;
  1390                          FCB	EQU	5CH
  1391                          DSKBUF	EQU	80H
  1392                          ;
  1393                          FCBSIZ	EQU	128+36+2
  1394                          ;
  1395  0729  0a                TRPCNT:	DEFB	10
  1396  072a  0000000000000000  TABLE:	DEFS	16		;FILE BLOCK POINTERS
              0000000000000000  
  1397  073a  00                FLAGS:	DEFB	0
  1398  073b  00                INKEY:	DEFB	0
  1399  073c  0000              EDPTR:	DEFW	0
  1400  073e  00                OPTVAL:	DEFB	0
