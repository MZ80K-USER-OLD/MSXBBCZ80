  1242                          ;
  1243                          ;OSINIT - Initialise RAM mapping etc.
  1244                          ;If BASIC is entered by BBCBASIC FILENAME then file
  1245                          ;FILENAME.BBC is automatically CHAINed.
  1246                          ;   Outputs: DE = initial value of HIMEM (top of RAM)
  1247                          ;            HL = initial value of PAGE (user program)
  1248                          ;            Z-flag reset indicates AUTO-RUN.
  1249                          ;  Destroys: A,B,C,D,E,H,L,F
  1250                          ;
  1251  06b6  0e2d              OSINIT:	LD	C,45		;*
  1252  06b8  1efe              	LD	E,254		;*
  1253  06ba  cd0500            	CALL	BDOS		;*
  1254  06bd  af                	XOR	A
  1255  06be  0615              	LD	B,INILEN
  1256  06c0  21fe07            	LD	HL,TABLE
  1257  06c3  77                CLRTAB:	LD	(HL),A		;CLEAR FILE TABLE ETC.
  1258  06c4  23                	INC	HL
  1259  06c5  10fc              	DJNZ	CLRTAB
  1260  06c7  110000            	LD	DE,ACCS
  1261  06ca  218000            	LD	HL,DSKBUF
  1262  06cd  4e                	LD	C,(HL)
  1263  06ce  23                	INC	HL
  1264  06cf  b9                	CP	C		;N.B. A=B=0
  1265  06d0  2802              	JR	Z,NOBOOT
  1266  06d2  edb0              	LDIR			;COPY TO ACCS
  1267  06d4  eb                NOBOOT:	EX	DE,HL
  1268  06d5  360d              	LD	(HL),CR
  1269  06d7  ed5b0600          	LD	DE,(6)		;DE = HIMEM
  1270  06db  5f                	LD	E,A		;PAGE BOUNDARY
  1271  06dc  210000            	LD	HL,USER
  1272  06df  c9                	RET
  1273                          ;
  1274                          ;
  1275                          ;TRAP - Test ESCAPE flag and abort if set;
  1276                          ;       every 20th call, test for keypress.
  1277                          ; Destroys: A,H,L,F
  1278                          ;
  1279                          ;LTRAP - Test ESCAPE flag and abort if set.
  1280                          ; Destroys: A,F
  1281                          ;
  1282  06e0  21fd07            TRAP:	LD	HL,TRPCNT
  1283  06e3  35                	DEC	(HL)
  1284  06e4  ccf406            	CALL	Z,TEST20	;TEST KEYBOARD
  1285  06e7  3a0e08            LTRAP:	LD	A,(FLAGS)	;ESCAPE FLAG
  1286  06ea  b7                	OR	A		;TEST
  1287  06eb  f0                	RET	P
  1288  06ec  210e08            ABORT:	LD	HL,FLAGS	;ACKNOWLEDGE
  1289  06ef  cbbe              	RES	7,(HL)		;ESCAPE
  1290  06f1  c30000            	JP	ESCAPE		;AND ABORT
  1291                          ;
  1292                          ;TEST - Sample for ESCape and CTRL/S. If ESCape
  1293                          ;       pressed set ESCAPE flag and return.
  1294                          ; Destroys: A,F
  1295                          ;
  1296  06f4  3614              TEST20:	LD	(HL),20
  1297  06f6  d5                TEST:	PUSH	DE
  1298  06f7  3e06              	LD	A,6
  1299  06f9  1eff              	LD	E,0FFH
  1300  06fb  cd2702            	CALL	BDOS0
  1301  06fe  d1                	POP	DE
  1302  06ff  b7                	OR	A
  1303  0700  c8                	RET	Z
  1304  0701  fe13              	CP	'S' & 1FH	;PAUSE DISPLAY?
  1305  0703  281e              	JR	Z,OSRDCH
  1306  0705  fe1b              	CP	ESC
  1307  0707  2857              	JR	Z,ESCSET
  1308  0709  320f08            	LD	(INKEY),A
  1309  070c  c9                	RET
  1310                          ;
  1311                          ;OSRDCH - Read from the current input stream (keyboard).
  1312                          ;  Outputs: A = character
  1313                          ; Destroys: A,F
  1314                          ;
  1315  070d  dd46f4            KEYGET:	LD	B,(IX-12)	;SCREEN WIDTH
  1316  0710  cd2307            	CALL	OSRDCH
  1317  0713  fe7f              	CP	DEL
  1318  0715  2809              	JR	Z,KEYDEL
  1319  0717  fee0              	CP	224
  1320  0719  c0                	RET	NZ
  1321  071a  cd2307            	CALL	OSRDCH
  1322  071d  d641              	SUB	65
  1323  071f  c9                	RET
  1324                          ;
  1325  0720  3e08              KEYDEL:	LD	A,BS
  1326  0722  c9                	RET
  1327                          ;
  1328  0723  3a0e08            OSRDCH:	LD	A,(FLAGS)
  1329  0726  1f                	RRA			;*EXEC ACTIVE?
  1330  0727  380a              	JR	C,EXECIN
  1331  0729  e5                	PUSH	HL
  1332  072a  ed62              	SBC	HL,HL		;HL=0
  1333  072c  cd4b07            	CALL	OSKEY
  1334  072f  e1                	POP	HL
  1335  0730  d8                	RET	C
  1336  0731  18f0              	JR	OSRDCH
  1337                          ;
  1338                          ;EXECIN - Read byte from EXEC file
  1339                          ;  Outputs: A = byte read
  1340                          ; Destroys: A,F
  1341                          ;
  1342  0733  c5                EXECIN:	PUSH	BC		;SAVE REGISTERS
  1343  0734  d5                	PUSH	DE
  1344  0735  e5                	PUSH	HL
  1345  0736  1e08              	LD	E,8		;SPOOL/EXEC CHANNEL
  1346  0738  210e08            	LD	HL,FLAGS
  1347  073b  cb86              	RES	0,(HL)
  1348  073d  cd6201            	CALL	OSBGET
  1349  0740  cbc6              	SET	0,(HL)
  1350  0742  f5                	PUSH	AF
  1351  0743  dc6300            	CALL	C,SESHUT	;END EXEC IF EOF
  1352  0746  f1                	POP	AF
  1353  0747  e1                	POP	HL		;RESTORE REGISTERS
  1354  0748  d1                	POP	DE
  1355  0749  c1                	POP	BC
  1356  074a  c9                	RET
  1357                          ;
  1358                          ;
  1359                          ;OSKEY - Read key with time-limit, test for ESCape.
  1360                          ;Main function is carried out in user patch.
  1361                          ;   Inputs: HL = time limit (centiseconds)
  1362                          ;  Outputs: Carry reset if time-out
  1363                          ;           If carry set A = character
  1364                          ; Destroys: A,H,L,F
  1365                          ;
  1366  074b  e5                OSKEY:	PUSH	HL
  1367  074c  210f08            	LD	HL,INKEY
  1368  074f  7e                	LD	A,(HL)
  1369  0750  3600              	LD	(HL),0
  1370  0752  e1                	POP	HL
  1371  0753  b7                	OR	A
  1372  0754  37                	SCF
  1373  0755  c0                	RET	NZ
  1374  0756  d5                	PUSH	DE
  1375  0757  cd0000            	CALL	GETKEY
  1376  075a  d1                	POP	DE
  1377  075b  d0                	RET	NC
  1378  075c  fe1b              	CP	ESC
  1379  075e  37                	SCF
  1380  075f  c0                	RET	NZ
  1381  0760  e5                ESCSET:	PUSH	HL
  1382  0761  210e08            	LD	HL,FLAGS
  1383  0764  cb76              	BIT	6,(HL)		;ESC DISABLED?
  1384  0766  2002              	JR	NZ,ESCDIS
  1385  0768  cbfe              	SET	7,(HL)		;SET ESCAPE FLAG
  1386  076a  e1                ESCDIS:	POP	HL
  1387  076b  c9                	RET
  1388                          ;
  1389                          ;OSWRCH - Write a character to console output.
  1390                          ;   Inputs: A = character.
  1391                          ; Destroys: Nothing
  1392                          ;
  1393  076c  f5                OSWRCH:	PUSH	AF
  1394  076d  d5                	PUSH	DE
  1395  076e  e5                	PUSH	HL
  1396  076f  cd0000            	CALL  msxCHPUT
  1397  0772  e1                	POP	HL
  1398  0773  d1                	POP	DE
  1399  0774  f1                	POP	AF
  1400  0775  c9                	RET
  1401                          ;
  1402                          ;OSLINE - Read/edit a complete line, terminated by CR.
  1403                          ;   Inputs: HL addresses destination buffer.
  1404                          ;           (L=0)
  1405                          ;  Outputs: Buffer filled, terminated by CR.
  1406                          ;           A=0.
  1407                          ; Destroys: A,B,C,D,E,H,L,F
  1408                          ;
  1409                          OSLINE:
  1410                          INLINE:
  1411  0776  eb                	EX DE,HL
  1412  0777  d5                	PUSH DE
  1413  0778  cd0000            	CALL msxPINLINE   ; 一行入力 入力先 BUF
  1414  077b  d1                    POP DE
  1415  077c  380d              	JR C,OSLINE_STOP   ; CTRL-STOPが押されたら終わり
  1416                          INLINE0:
  1417  077e  23                	INC HL 		; HL=BUF-1 　だから
  1418  077f  7e                	LD A,(HL)
  1419  0780  12                	LD (DE),A
  1420  0781  13                	INC DE
  1421  0782  b7                	OR A
  1422  0783  20f9              	JR NZ,INLINE0
  1423  0785  12                	LD (DE),A	; NULL 終端
  1424  0786  1b                	DEC DE
  1425  0787  3e0d              	LD A,CR
  1426  0789  12                	LD (DE),A	; 0DH,NULL
  1427  078a  c9                	RET
  1428                          
  1429                          OSLINE_STOP:
  1430  078b  3e0d              	LD A,CR
  1431  078d  12                	LD (DE),A	; 0DH
  1432  078e  13                	INC DE
  1433  078f  af                	XOR A
  1434  0790  12                	LD (DE),A	; NULL 終端
  1435  0791  37                	SCF			; CTRL-STOPが押されたことを示す
  1436  0792  c9                	RET
  1437                          ;
  1438                          ; INIT SCREEN
  1439                          ;
  1440                          INITTXT:
  1441  0793  3e50              	LD A,80
  1442  0795  320000            	LD (WIDTH),A
  1443  0798  c30000            	JP msxINITXT80
  1444                          
  1445                          ;------------------------------------------------------------------------------
  1446                          ; Check Msx-DOS Version (MSX1 or MSX2)
  1447                          ; ------------------------------------------------------------------------------
  1448                          CheckMSXDOS:
  1449                              ; --- バージョン取得 ---
  1450  079b  010000                ld   bc, 0000h   ; 初期化
  1451  079e  0e6f                  ld   c, 6Fh      ; _DOSVER
  1452  07a0  cd0500                call BDOS       ; BDOS
  1453                          
  1454  07a3  78                    ld   a, b        ; メジャーバージョン
  1455  07a4  320000                ld   (DOS_VER), a ; 変数に格納
  1456                          
  1457                              ; --- 判定と表示 ---
  1458  07a7  3a0000            	ld   a, (DOS_VER)
  1459  07aa  fe02                  cp   2
  1460  07ac  3006                  jr   nc, print_dos2
  1461                          
  1462                          print_dos1:
  1463  07ae  21ba07                LD HL, MSG_DOS1
  1464  07b1  c30000                JP msxSTRPUT
  1465                          
  1466                          print_dos2:
  1467  07b4  21c607                LD HL, MSG_DOS2
  1468  07b7  c30000                JP msxSTRPUT
  1469                          
  1470                          
  1471                          ; --- データエリア ---
  1472  07ba  4d53582d444f5320  MSG_DOS1: DEFB "MSX-DOS 1",0DH,0AH,00
              310d0a00          
  1473  07c6  4d53582d444f5320  MSG_DOS2: DEFB "MSX-DOS 2",0DH,0AH,00
              320d0a00          
  1474                          
  1475                          ; ======================================================
  1476                          ; HLレジスタの内容をASCII 4文字で画面に表示する
  1477                          ; ======================================================
  1478                          PrintAddress:
  1479  07d2  7c                    ld  a, h
  1480  07d3  cdd707                call PrintHexByte   ; 上位バイト(H)を表示
  1481  07d6  7d                    ld  a, l            ; 下位バイト(L)を表示
  1482                              ; そのまま下の PrintHexByte へ流れる (Fall-through)
  1483                          
  1484                          ; --- 1バイト(A)を16進ASCII 2文字で表示 ---
  1485                          PrintHexByte:
  1486  07d7  f5                    push af             ; 下位ニブル保存用
  1487  07d8  0f                    rrca
  1488  07d9  0f                	rrca 		        ; 上位4ビットを下位へ移動
  1489  07da  0f                    rrca
  1490  07db  0f                	rrca
  1491  07dc  cde007                call PrintNibble    ; 上位桁を表示
  1492  07df  f1                    pop  af             ; 下位ニブルを戻す
  1493                              ; そのまま下の PrintNibble へ流れる
  1494                          
  1495                          ; --- 下位4ビット(A)をASCII 1文字で表示 (DAAマジック) ---
  1496                          PrintNibble:
  1497  07e0  e60f                  and  0Fh            ; 下位4ビットのみにマスク
  1498  07e2  c690                  add  a, 90h         ; 10進補正を利用するためのオフセット
  1499  07e4  27                    daa                 ; 0-9はそのまま、A-Fは桁上げが発生
  1500  07e5  ce40                  adc  a, 40h         ; ASCII '0'(30h)や'A'(41h)への調整
  1501  07e7  27                    daa                 ; 最終的なASCIIコードに確定
  1502                          
  1503                          ; --- [システム依存] 1文字出力ルーチン ---
  1504                              ; Aレジスタの文字を表示します。
  1505                              ; お使いの環境に合わせて書き換えてください。
  1506                          PUTCHAR::
  1507  07e8  c30000            	JP msxCHPUT ; 画面に表示 (自動的にXが+1される)
  1508                          
  1509                          PUTCRLF:
  1510  07eb  3e0d              	LD A,CR
  1511  07ed  cd0000            	CALL msxCHPUT
  1512  07f0  3e0a              	LD  A,LF
  1513  07f2  c30000            	JP  msxCHPUT
  1514                          
  1515                          PROMPT:
  1516  07f5  3e3e              	LD A,'>'
  1517  07f7  c30000            	JP msxCHPUT
  1518                          ;
  1519                          ; HLレジスタの指す文字列を画面に出力するルーチン
  1520                          ; 文字列はNULL(0)で終端されているもの
  1521                          STRPUT:
  1522  07fa  c30000                JP msxSTRPUT ; 文字列出力
  1523                          
  1524                          ;
  1525                          ;
  1526                          ;EDITST:	DEFM	"EDIT"
  1527                          ;LISTST:	DEFM	"LIST"
  1528                          ;
  1529                          BEL	EQU	7
  1530                          BS	EQU	8
  1531                          HT	EQU	9
  1532                          LF	EQU	0AH
  1533                          VT	EQU	0BH
  1534                          CR	EQU	0DH
  1535                          ESC	EQU	1BH
  1536                          DEL	EQU	7FH
  1537                          ;
  1538                          BDOS	EQU	5
  1539                          ;
  1540                          FCB	EQU	5CH
  1541                          DSKBUF	EQU	80H
  1542                          ;
  1543                          FCBSIZ	EQU	128+36+2
  1544                          ;
  1545  07fd  0a                TRPCNT:	DEFB	10
  1546  07fe  0000000000000000  TABLE:	DEFS	16		;FILE BLOCK POINTERS
              0000000000000000  
  1547  080e  00                FLAGS:	DEFB	0
  1548  080f  00                INKEY:	DEFB	0
  1549  0810  0000              EDPTR:	DEFW	0
  1550  0812  00                OPTVAL:	DEFB	0
  1551                          INILEN	EQU	$-TABLE
  1552                          ;
  1553                          FIN:	;END
