  1053  0580  110000            	LD	DE,PATHBUF
  1054  0583  dd210000          	LD	IX,DIRFIB
  1055  0587  0610              	LD	B,10H		; Include directory entries.
  1056  0589  0e40              	LD	C,40H		; FFIRST
  1057  058b  cd0500            	CALL	BDOS
  1058  058e  b7                	OR	A
  1059  058f  2026              	JR	NZ,DIRD2END
  1060  0591  0604              	LD	B,4		; Four filenames per output line.
  1061                          DIRD22:
