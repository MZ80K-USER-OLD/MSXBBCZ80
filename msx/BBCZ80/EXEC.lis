  3161  12d4  fd7e00            	LD	A,(IY)
  3162  12d7  fedc              	CP	TDATA
  3163  12d9  20d0              	JR	NZ,WSRCH
  3164  12db  fd7e00            WSRCHM:	LD	A,(IY)
  3165  12de  fd23              	INC	IY
  3166  12e0  fe0d              	CP	CR
  3167  12e2  20f7              	JR	NZ,WSRCHM		;Skip to end of line
  3168  12e4  18e1              	JR	WSRCH1
