    69  0031  fd23              ASSEM3:	INC	IY
    70  0033  fd7e00            	LD	A,(IY)
    71  0036  cdac03            	CALL	TERM0
    72  0039  20f6              	JR	NZ,ASSEM3
    73  003b  3a0000            	LD	A,(LISTON)
    74  003e  dde5              	PUSH	IX
    75  0040  e1                	POP	HL
    76  0041  b7                	OR	A
    77  0042  ed52              	SBC	HL,DE
    78  0044  eb                	EX	DE,HL		;DE= NO. OF BYTES
    79  0045  e5                	PUSH	HL
    80  0046  2a0000            	LD	HL,(PC)
    81  0049  e5                	PUSH	HL
    82  004a  19                	ADD	HL,DE
    83  004b  220000            	LD	(PC),HL		;UPDATE PC
    84  004e  cb77              	BIT	6,A
    85  0050  2807              	JR	Z,ASSEM5
    86  0052  2a0000            	LD	HL,(OC)
    87  0055  19                	ADD	HL,DE
    88  0056  220000            	LD	(OC),HL		;UPDATE OC
    89  0059  e1                ASSEM5:	POP	HL		;OLD PC
    90  005a  dde1              	POP	IX		;CODE HERE
    91  005c  cb67              	BIT	4,A
    92  005e  28a0              	JR	Z,ASSEM
    93  0060  7c                	LD	A,H
    94  0061  cda000            	CALL	HEX
    95  0064  7d                	LD	A,L
    96  0065  cd9900            	CALL	HEXSP
    97  0068  af                	XOR	A
    98  0069  bb                	CP	E
    99  006a  2815              	JR	Z,ASSEM2
