   488  0222  cdca09            	CALL	BINDIG
   489  0225  389a              	JR	C,BADHEX
   490  0227  fd23              BIN1:	INC	IY
   491  0229  cb1f              	RR	A
   492  022b  d9                	EXX
   493  022c  ed6a              	ADC	HL,HL
   494  022e  d9                	EXX
   495  022f  ed6a              	ADC	HL,HL
   496  0231  cdca09            	CALL	BINDIG
   497  0234  30f1              	JR	NC,BIN1
   498  0236  af                	XOR	A
   499  0237  c9                	RET
