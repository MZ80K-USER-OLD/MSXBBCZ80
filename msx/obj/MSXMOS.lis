  1776                          DSKBUF	EQU	80H
  1777                          ;
  1778                          FCBSIZ	EQU	128+36+2
  1779                          BLOCKSIZE EQU 256
  1780                          ;
  1781  0960  0a                TRPCNT:	DEFB	10
  1782  0961  0000000000000000  TABLE:	DEFS	16		;FILE BLOCK POINTERS
              0000000000000000  
  1783  0971  00                FLAGS:	DEFB	0
  1784  0972  00                INKEY:	DEFB	0
  1785  0973  0000              EDPTR:	DEFW	0
  1786  0975  00                OPTVAL:	DEFB	0
  1787                          INILEN	EQU	$-TABLE
