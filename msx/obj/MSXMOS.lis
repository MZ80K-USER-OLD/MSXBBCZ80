    86                          ;
    87                          ;
    88                          ;OSSAVE - Save an area of memory to a file.
    89                          ;   Inputs: HL addresses filename (term CR)
    90                          ;           DE = start address of data to save
    91                          ;           BC = length of data to save (bytes)
    92                          ; Destroys: A,B,C,D,E,H,L,F
    93                          ;
    94  0000  cdd805            STSAVE:	CALL	SAVLOD		;*SAVE
    95  0003  daa605            	JP	C,HUH		;"Bad command"
    96  0006  e5                	PUSH	HL
    97  0007  1804              	JR	OSS1
    98                          ;
    99  0009  c5                OSSAVE:	PUSH	BC		;SAVE
   100  000a  cd3404            	CALL	SETUP0
   101  000d  eb                OSS1:	EX	DE,HL
   102  000e  cd4703            	CALL	CREATE
   103  0011  2014              	JR	NZ,SAVE
   104  0013  3ebe              DIRFUL:	LD	A,190
   105  0015  cd0000            	CALL	EXTERR
   106  0018  4469726563746f72  	DEFM	"Directory full"
              792066756c6c      
   107  0026  00                	DEFB	0
   108  0027  cd1903            SAVE:	CALL	WRITE
   109  002a  09                	ADD	HL,BC
   110  002b  e3                	EX	(SP),HL
   111  002c  ed42              	SBC	HL,BC
   112  002e  e3                	EX	(SP),HL
   113  002f  2802              	JR	Z,SAVE1
   114  0031  30f4              	JR	NC,SAVE
   115  0033  c1                SAVE1:	POP	BC
   116  0034  3e10              CLOSE:	LD	A,16
   117  0036  cded02            	CALL	BDOS1
   118  0039  3c                	INC	A
   119  003a  c0                	RET	NZ
   120  003b  3ec8              	LD	A,200
   121  003d  cd0000            	CALL	EXTERR
   122  0040  436c6f7365206572  	DEFM	"Close error"
              726f72            
   123  004b  00                	DEFB	0
   124                          ;
   125                          ;OSSHUT - Close disk file(s).
   126                          ;   Inputs: E = file channel
   127                          ;           If E=0 all files are closed (except SPOOL)
   128                          ; Destroys: A,B,C,D,E,H,L,F
   129                          ;
   130  004c  7b                OSSHUT:	LD	A,E
   131  004d  b7                	OR	A
   132  004e  200b              	JR	NZ,SHUTIT
   133  0050  1c                SHUT0:	INC	E
   134  0051  cb5b              	BIT	3,E
   135  0053  c0                	RET	NZ
   136  0054  d5                	PUSH	DE
   137  0055  cd6c00            	CALL	SHUT1
   138  0058  d1                	POP	DE
   139  0059  18f5              	JR	SHUT0
   140                          ;
   141  005b  cda003            SHUTIT:	CALL	FIND1
   142  005e  2010              	JR	NZ,SHUT2
   143  0060  c38b03            	JP	CHANER
   144                          ;
   145  0063  211809            SESHUT:	LD	HL,FLAGS
   146  0066  cb86              	RES	0,(HL)		;STOP EXEC
   147  0068  cb8e              	RES	1,(HL)		;STOP SPOOL
   148  006a  1e08              	LD	E,8		;SPOOL/EXEC CHANNEL
   149  006c  cda003            SHUT1:	CALL	FIND1
   150  006f  c8                	RET	Z
   151  0070  af                SHUT2:	XOR	A
   152  0071  77                	LD	(HL),A
   153  0072  2b                	DEC	HL
   154  0073  77                	LD	(HL),A
   155  0074  212500            	LD	HL,37
   156  0077  19                	ADD	HL,DE
   157  0078  cb7e              	BIT	7,(HL)
   158  007a  23                	INC	HL
   159  007b  c41903            	CALL	NZ,WRITE
   160  007e  21a600            	LD	HL,FCBSIZ
   161  0081  19                	ADD	HL,DE
   162  0082  ed4b0000          	LD	BC,(FREE)
   163  0086  ed42              	SBC	HL,BC
   164  0088  20aa              	JR	NZ,CLOSE
   165  008a  ed530000          	LD	(FREE),DE	;RELEASE SPACE
   166  008e  18a4              	JR	CLOSE
   167                          ;
   168                          ;TYPE - *TYPE command.
   169                          ;Types file to console output.
   170                          ;
   171  0090  37                TYPE:	SCF			;*TYPE
   172  0091  cdd301            	CALL	OSOPEN
   173  0094  b7                	OR	A
   174  0095  2830              	JR	Z,NOTFND
   175  0097  5f                	LD	E,A
   176  0098  3a1809            TYPE1:	LD	A,(FLAGS)	;TEST
   177  009b  cb7f              	BIT	7,A		;FOR
   178  009d  200a              	JR	NZ,TYPESC	;ESCape
   179  009f  cd3f02            	CALL	OSBGET
   180  00a2  cd7608            	CALL	OSWRCH		;N.B. CALLS "TEST"
   181  00a5  30f1              	JR	NC,TYPE1
   182  00a7  18a3              	JR	OSSHUT
   183                          ;
   184  00a9  cd4c00            TYPESC:	CALL	OSSHUT		;CLOSE!
   185  00ac  c3f607            	JP	ABORT
   186                          ;
   187                          ;OSLOAD - Load an area of memory from a file.
   188                          ;   Inputs: HL addresses filename (term CR)
   189                          ;           DE = address at which to load
   190                          ;           BC = maximum allowed size (bytes)
   191                          ;  Outputs: Carry reset indicates no room for file.
   192                          ; Destroys: A,B,C,D,E,H,L,F
   193                          ;
   194  00af  cdd805            STLOAD:	CALL	SAVLOD		;*LOAD
   195  00b2  e5                	PUSH	HL
   196  00b3  180c              	JR	OSL1
   197                          ;
   198  00b5  3a0000            OSLOAD:	LD	A,(DOS_VER)
   199  00b8  fe02              	CP	2
   200  00ba  d2f200            	JP	NC,OSLOAD_DOS2
   201  00bd  c5                OSLOAD_CPM:	PUSH	BC		;LOAD
   202  00be  cd3404            	CALL	SETUP0
   203  00c1  eb                OSL1:	EX	DE,HL
   204  00c2  cd3d03            	CALL	OPEN
   205  00c5  201d              	JR	NZ,LOAD0
   206  00c7  3ed6              NOTFND:	LD	A,214
   207  00c9  cd0000            	CALL	EXTERR
   208  00cc  46696c65206e6f74  	DEFM	"File not found"
              20666f756e64      
   209  00da  00                	DEFB	0
   210  00db  cde802            LOAD:	CALL	READ
   211  00de  200a              	JR	NZ,LOAD1
   212  00e0  cd3203            	CALL	INCSEC
   213  00e3  09                	ADD	HL,BC
   214  00e4  e3                LOAD0:	EX	(SP),HL
   215  00e5  ed42              	SBC	HL,BC
   216  00e7  e3                	EX	(SP),HL
   217  00e8  30f1              	JR	NC,LOAD
   218  00ea  c1                LOAD1:	POP	BC
   219  00eb  f5                	PUSH	AF
   220  00ec  cd3400            	CALL	CLOSE
   221  00ef  f1                	POP	AF
   222  00f0  3f                	CCF
   223  00f1  c9                OSCALL:	RET
   224                          
   225                          ;OSLOAD_DOS2 - Load through an MSX-DOS2 file handle.
   226                          ; _READ returns the actual byte count in HL.
   227                          ; Each read is limited to 512 bytes.
   228                          ;
   229                          OSLOAD_DOS2:
   230  00f2  ed530000          	LD	(FILE_BUFADRS),DE
   231  00f6  ed430000          	LD	(FILE_MAXSIZE),BC
   232  00fa  cd3404            	CALL	SETUP0
   233  00fd  cde403            	CALL	PATHNORM
   234  0100  cd0704            	CALL	DOS2_DEFAULT_EXT
   235                          
   236  0103  110000            	LD	DE,PATHBUF
   237  0106  3e01              	LD	A,1			; read-only
   238  0108  cd8e01            	CALL	HOPEN
   239  010b  b7                	OR	A
   240  010c  c25c01            	JP	NZ,LOAD_DOS2_NOTFOUND
   241                          
   242                          LOAD_DOS2_LOOP:
   243  010f  2a0000            	LD	HL,(FILE_MAXSIZE)
   244  0112  7c                	LD	A,H
   245  0113  b5                	OR	L
   246  0114  2841              	JR	Z,LOAD_DOS2_CLOSE_OK
   247                          
   248  0116  110001            	LD	DE,BLOCKSIZE
   249  0119  b7                	OR	A
   250  011a  ed52              	SBC	HL,DE
   251  011c  3006              	JR	NC,LOAD_DOS2_FULL_BLOCK
   252  011e  19                	ADD	HL,DE
   253  011f  220000            	LD	(REQ_BYTES),HL
   254  0122  1806              	JR	LOAD_DOS2_HAVE_REQUEST
   255                          
   256                          LOAD_DOS2_FULL_BLOCK:
   257  0124  210001            	LD	HL,BLOCKSIZE
   258  0127  220000            	LD	(REQ_BYTES),HL
   259                          
   260                          LOAD_DOS2_HAVE_REQUEST:
   261  012a  ed5b0000          	LD	DE,(FILE_BUFADRS)
   262  012e  2a0000            	LD	HL,(REQ_BYTES)
   263  0131  cda501            	CALL	HREAD
   264  0134  b7                	OR	A
   265  0135  2039              	JR	NZ,LOAD_DOS2_ERROR
   266  0137  7c                	LD	A,H
   267  0138  b5                	OR	L
   268  0139  281c              	JR	Z,LOAD_DOS2_CLOSE_OK
   269                          
   270  013b  ed530000          	LD	(FILE_BUFADRS),DE
   271  013f  eb                	EX	DE,HL
   272  0140  2a0000            	LD	HL,(FILE_MAXSIZE)
   273  0143  b7                	OR	A
   274  0144  ed52              	SBC	HL,DE
   275  0146  3828              	JR	C,LOAD_DOS2_ERROR
   276  0148  220000            	LD	(FILE_MAXSIZE),HL
   277                          
   278  014b  2a0000            	LD	HL,(REQ_BYTES)
   279  014e  b7                	OR	A
   280  014f  ed52              	SBC	HL,DE
   281  0151  381d              	JR	C,LOAD_DOS2_ERROR
   282  0153  28ba              	JR	Z,LOAD_DOS2_LOOP
   283  0155  1800              	JR	LOAD_DOS2_CLOSE_OK	; short read means EOF
   284                          
   285                          LOAD_DOS2_CLOSE_OK:
   286  0157  cd9b01            	CALL	HCLOSE
   287  015a  37                	SCF
   288  015b  c9                	RET
   289                          
   290                          LOAD_DOS2_NOTFOUND:
   291  015c  3ed6              	LD	A,214
   292  015e  cd0000            	CALL	EXTERR
   293  0161  46696c65206e6f74  	DEFM	"File not found"
              20666f756e64      
   294  016f  00                	DEFB	0
   295                          
   296                          LOAD_DOS2_ERROR:
   297  0170  f5                	PUSH	AF
   298  0171  cd9b01            	CALL	HCLOSE
   299  0174  f1                	POP	AF
   300  0175  3eff              	LD	A,255
   301  0177  cd0000            	CALL	EXTERR
   302  017a  4d53582d444f5332  	DEFM	"MSX-DOS2 file error"
              2066696c65206572  
              726f72            
   303  018d  00                	DEFB	0
   304                          
   305                          ; HOPEN - Open an MSX-DOS2 file.
   306                          ;   Inputs: DE = ASCIIZ filename, A = access mode
   307                          ;  Outputs: A = error code (0 on success), FILE_HANDLE = file handle
   308                          ; Destroys: A,C,DE,HL,F
   309                          HOPEN:
   310  018e  0e43              	LD	C,43H			; _OPEN
   311  0190  cd0500            	CALL	BDOS
   312  0193  b7                	OR	A
   313  0194  c0                	RET	NZ
   314  0195  78                	LD	A,B
   315  0196  320000            	LD	(FILE_HANDLE),A
   316  0199  af                	XOR	A
   317  019a  c9                	RET
   318                          
   319                          ; HCLOSE - Close an MSX-DOS2 file handle.
   320                          ;   Inputs: FILE_HANDLE = file handle
   321                          ;  Outputs: A = error code (0 on success)
   322                          ; Destroys: A,BC,DE,HL,F
   323                          HCLOSE:
   324  019b  3a0000            	LD	A,(FILE_HANDLE)
   325  019e  47                	LD	B,A
   326  019f  0e45              	LD	C,45H			; _CLOSE
   327  01a1  cd0500            	CALL	BDOS
   328  01a4  c9                	RET
   329                          
   330                          ; HREAD - Read bytes through an MSX-DOS2 file handle.
   331                          ;   Inputs: FILE_HANDLE = file handle, DE = destination buffer,
   332                          ;           HL = requested bytes
   333                          ;  Outputs: A = error code (0 on success), DE = next buffer address,
   334                          ;           HL = actual bytes read returned by _READ
   335                          ; Destroys: A,BC,F
   336                          HREAD:
   337  01a5  ed530000          	LD	(FILE_BUFADRS),DE
   338  01a9  220000            	LD	(REQ_BYTES),HL
   339  01ac  3a0000            	LD	A,(FILE_HANDLE)
   340  01af  47                	LD	B,A
   341  01b0  ed5b0000          	LD	DE,(FILE_BUFADRS)
   342  01b4  2a0000            	LD	HL,(REQ_BYTES)
   343  01b7  0e48              	LD	C,48H			; _READ
   344  01b9  cd0500            	CALL	BDOS
   345  01bc  b7                	OR	A
   346  01bd  c0                	RET	NZ
   347  01be  ed5b0000          	LD	DE,(FILE_BUFADRS)
   348  01c2  e5                	PUSH	HL
   349  01c3  19                	ADD	HL,DE
   350  01c4  eb                	EX	DE,HL
   351  01c5  e1                	POP	HL
   352  01c6  c9                	RET
   353                          
   354                          ;OSOPEN - Open a file for reading or writing.
   355                          ;   Inputs: HL addresses filename (term CR)
   356                          ;           Carry set for OPENIN, cleared for OPENOUT.
   357                          ;   Outputs: A = file channel (=0 if cannot open)
   358                          ;            DE = file FCB
   359                          ;   Destroys: A,B,C,D,E,H,L,F
   360                          ;
   361  01c7  f5                OPENIT:	PUSH	AF		;SAVE CARRY
   362  01c8  cd3404            	CALL	SETUP0
   363  01cb  f1                	POP	AF
   364  01cc  d44703            	CALL	NC,CREATE
   365  01cf  dc3d03            	CALL	C,OPEN
   366  01d2  c9                	RET
   367                          ;
   368  01d3  cdc701            OSOPEN:	CALL	OPENIT
   369  01d6  c8                	RET	Z		;ERROR
   370  01d7  0607              	LD	B,7		;MAX. NUMBER OF FILES
   371  01d9  211709            	LD	HL,TABLE+15
   372  01dc  7e                OPEN1:	LD	A,(HL)
   373  01dd  2b                	DEC	HL
   374  01de  b6                	OR	(HL)
   375  01df  281c              	JR	Z,OPEN2		;FREE CHANNEL
   376  01e1  2b                	DEC	HL
   377  01e2  10f8              	DJNZ	OPEN1
   378  01e4  3ec0              	LD	A,192
   379  01e6  cd0000            	CALL	EXTERR
   380  01e9  546f6f206d616e79  	DEFM	"Too many open files"
              206f70656e206669  
              6c6573            
   381  01fc  00                	DEFB	0
   382                          
   383  01fd  ed5b0000          OPEN2:	LD	DE,(FREE)	;FREE SPACE POINTER
   384  0201  73                	LD	(HL),E
   385  0202  23                	INC	HL
   386  0203  72                	LD	(HL),D
   387  0204  78                	LD	A,B		;CHANNEL (1-7)
   388  0205  21a600            	LD	HL,FCBSIZ
   389  0208  19                	ADD	HL,DE		;RESERVE SPACE
   390  0209  220000            	LD	(FREE),HL
   391  020c  215c00            OPEN3:	LD	HL,FCB		;ENTRY FROM SPOOL/EXEC
   392  020f  d5                	PUSH	DE
   393  0210  012400            	LD	BC,36
   394  0213  edb0              	LDIR			;COPY FCB
   395  0215  eb                	EX	DE,HL
   396  0216  23                	INC	HL
   397  0217  71                	LD	(HL),C		;CLEAR PTR
   398  0218  23                	INC	HL
   399  0219  d1                	POP	DE
   400  021a  47                	LD	B,A
   401  021b  cdc802            	CALL	RDF		;READ OR FILL
   402  021e  78                	LD	A,B
   403  021f  c30000            	JP	CHECK
   404                          ;
   405                          ;OSBPUT - Write a byte to a random disk file.
   406                          ;   Inputs: E = file channel
   407                          ;           A = byte to write
   408                          ; Destroys: A,B,C,F
   409                          ;
   410  0222  d5                OSBPUT:	PUSH	DE
   411  0223  e5                	PUSH	HL
   412  0224  47                	LD	B,A
   413  0225  cd7f03            	CALL	FIND
   414  0228  78                	LD	A,B
   415  0229  0600              	LD	B,0
   416  022b  2b                	DEC	HL
   417  022c  70                	LD	(HL),B		;CLEAR EOF
   418  022d  23                	INC	HL
   419  022e  4e                	LD	C,(HL)
   420  022f  cbb9              	RES	7,C
   421  0231  cbfe              	SET	7,(HL)
   422  0233  34                	INC	(HL)
   423  0234  23                	INC	HL
   424  0235  e5                	PUSH	HL
   425  0236  09                	ADD	HL,BC
   426  0237  77                	LD	(HL),A
   427  0238  e1                	POP	HL
   428  0239  ccc502            	CALL	Z,WRRDF		;WRITE THEN READ/FILL
   429  023c  e1                	POP	HL
   430  023d  d1                	POP	DE
   431  023e  c9                	RET
   432                          ;
   433                          ;OSBGET - Read a byte from a random disk file.
   434                          ;   Inputs: E = file channel
   435                          ;  Outputs: A = byte read
   436                          ;           Carry set if LAST BYTE of file
   437                          ; Destroys: A,B,C,F
   438                          ;
   439  023f  d5                OSBGET:	PUSH	DE
   440  0240  e5                	PUSH	HL
   441  0241  cd7f03            	CALL	FIND
   442  0244  4e                	LD	C,(HL)
   443  0245  cbb9              	RES	7,C
   444  0247  34                	INC	(HL)
   445  0248  23                	INC	HL
   446  0249  e5                	PUSH	HL
   447  024a  0600              	LD	B,0
   448  024c  09                	ADD	HL,BC
   449  024d  46                	LD	B,(HL)
   450  024e  e1                	POP	HL
   451  024f  ece002            	CALL	PE,INCRDF	;INC SECTOR THEN READ
   452  0252  ccc502            	CALL	Z,WRRDF		;WRITE THEN READ/FILL
   453  0255  78                	LD	A,B
   454  0256  e1                	POP	HL
   455  0257  d1                	POP	DE
   456  0258  c9                	RET
   457                          ;
   458                          ;OSSTAT - Read file status.
   459                          ;   Inputs: E = file channel
   460                          ;  Outputs: Z flag set - EOF
   461                          ;           (If Z then A=0)
   462                          ;           DE = address of file block.
   463                          ; Destroys: A,D,E,H,L,F
   464                          ;
   465  0259  cd7f03            OSSTAT:	CALL	FIND
   466  025c  2b                	DEC	HL
   467  025d  7e                	LD	A,(HL)
   468  025e  3c                	INC	A
   469  025f  c9                	RET
   470                          ;
   471                          ;GETEXT - Find file size.
   472                          ;   Inputs: E = file channel
   473                          ;  Outputs: DEHL = file size (0-&800000)
   474                          ; Destroys: A,B,C,D,E,H,L,F
   475                          ;
   476  0260  cd7f03            GETEXT:	CALL	FIND
   477  0263  eb                	EX	DE,HL
   478  0264  115c00            	LD	DE,FCB
   479  0267  012400            	LD	BC,36
   480  026a  d5                	PUSH	DE
   481  026b  edb0              	LDIR			;COPY FCB
   482  026d  eb                	EX	DE,HL
   483  026e  e3                	EX	(SP),HL
   484  026f  eb                	EX	DE,HL
   485  0270  3e23              	LD	A,35
   486  0272  cded02            	CALL	BDOS1		;COMPUTE SIZE
   487  0275  e1                	POP	HL
