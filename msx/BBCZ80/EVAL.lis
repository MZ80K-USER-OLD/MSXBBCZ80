   908  049a  1831              	JR	COUNT0
   909  049c  cde701            LEN:	CALL	ITEMS
   910  049f  eb                	EX	DE,HL
   911  04a0  182b              	JR	COUNT0
   912  04a2  2a0000            LOMEMV:	LD	HL,(LOMEM)
   913  04a5  1828              	JR	COUNT1
   914  04a7  2a0000            HIMEMV:	LD	HL,(HIMEM)
   915  04aa  1823              	JR	COUNT1
   916  04ac  2a0000            PAGEV:	LD	HL,(PAGE)
   917  04af  181e              	JR	COUNT1
   918  04b1  fd7e00            TOPV:	LD	A,(IY)
