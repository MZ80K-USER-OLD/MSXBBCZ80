    79                          ;
    80                          ;
    81                          ;OSSAVE - Save an area of memory to a file.
    82                          ;   Inputs: HL addresses filename (term CR)
    83                          ;           DE = start address of data to save
    84                          ;           BC = length of data to save (bytes)
    85                          ; Destroys: A,B,C,D,E,H,L,F
    86                          ;
    87  0000  cdce04            STSAVE:	CALL	SAVLOD		;*SAVE
    88  0003  da9c04            	JP	C,HUH		;"Bad command"
    89  0006  e5                	PUSH	HL
    90  0007  1804              	JR	OSS1
    91                          ;
    92  0009  c5                OSSAVE:	PUSH	BC		;SAVE
    93  000a  cd2a03            	CALL	SETUP0
    94  000d  eb                OSS1:	EX	DE,HL
    95  000e  cd6a02            	CALL	CREATE
    96  0011  2014              	JR	NZ,SAVE
    97  0013  3ebe              DIRFUL:	LD	A,190
    98  0015  cd0000            	CALL	EXTERR
    99  0018  4469726563746f72  	DEFM	"Directory full"
              792066756c6c      
   100  0026  00                	DEFB	0
   101  0027  cd3c02            SAVE:	CALL	WRITE
   102  002a  09                	ADD	HL,BC
   103  002b  e3                	EX	(SP),HL
   104  002c  ed42              	SBC	HL,BC
   105  002e  e3                	EX	(SP),HL
   106  002f  2802              	JR	Z,SAVE1
   107  0031  30f4              	JR	NC,SAVE
   108  0033  c1                SAVE1:	POP	BC
   109  0034  3e10              CLOSE:	LD	A,16
   110  0036  cd1002            	CALL	BDOS1
   111  0039  3c                	INC	A
   112  003a  c0                	RET	NZ
   113  003b  3ec8              	LD	A,200
   114  003d  cd0000            	CALL	EXTERR
   115  0040  436c6f7365206572  	DEFM	"Close error"
              726f72            
   116  004b  00                	DEFB	0
   117                          ;
   118                          ;OSSHUT - Close disk file(s).
   119                          ;   Inputs: E = file channel
   120                          ;           If E=0 all files are closed (except SPOOL)
   121                          ; Destroys: A,B,C,D,E,H,L,F
   122                          ;
   123  004c  7b                OSSHUT:	LD	A,E
   124  004d  b7                	OR	A
   125  004e  200b              	JR	NZ,SHUTIT
   126  0050  1c                SHUT0:	INC	E
   127  0051  cb5b              	BIT	3,E
   128  0053  c0                	RET	NZ
   129  0054  d5                	PUSH	DE
   130  0055  cd6c00            	CALL	SHUT1
   131  0058  d1                	POP	DE
   132  0059  18f5              	JR	SHUT0
   133                          ;
   134  005b  cdc302            SHUTIT:	CALL	FIND1
   135  005e  2010              	JR	NZ,SHUT2
   136  0060  c3ae02            	JP	CHANER
   137                          ;
   138  0063  210e08            SESHUT:	LD	HL,FLAGS
   139  0066  cb86              	RES	0,(HL)		;STOP EXEC
   140  0068  cb8e              	RES	1,(HL)		;STOP SPOOL
   141  006a  1e08              	LD	E,8		;SPOOL/EXEC CHANNEL
   142  006c  cdc302            SHUT1:	CALL	FIND1
   143  006f  c8                	RET	Z
   144  0070  af                SHUT2:	XOR	A
   145  0071  77                	LD	(HL),A
   146  0072  2b                	DEC	HL
   147  0073  77                	LD	(HL),A
   148  0074  212500            	LD	HL,37
   149  0077  19                	ADD	HL,DE
   150  0078  cb7e              	BIT	7,(HL)
   151  007a  23                	INC	HL
   152  007b  c43c02            	CALL	NZ,WRITE
   153  007e  21a600            	LD	HL,FCBSIZ
   154  0081  19                	ADD	HL,DE
   155  0082  ed4b0000          	LD	BC,(FREE)
   156  0086  ed42              	SBC	HL,BC
   157  0088  20aa              	JR	NZ,CLOSE
   158  008a  ed530000          	LD	(FREE),DE	;RELEASE SPACE
   159  008e  18a4              	JR	CLOSE
   160                          ;
   161                          ;TYPE - *TYPE command.
   162                          ;Types file to console output.
   163                          ;
   164  0090  37                TYPE:	SCF			;*TYPE
   165  0091  cdf600            	CALL	OSOPEN
   166  0094  b7                	OR	A
   167  0095  2828              	JR	Z,NOTFND
   168  0097  5f                	LD	E,A
   169  0098  3a0e08            TYPE1:	LD	A,(FLAGS)	;TEST
   170  009b  cb7f              	BIT	7,A		;FOR
   171  009d  200a              	JR	NZ,TYPESC	;ESCape
   172  009f  cd6201            	CALL	OSBGET
   173  00a2  cd6c07            	CALL	OSWRCH		;N.B. CALLS "TEST"
   174  00a5  30f1              	JR	NC,TYPE1
   175  00a7  18a3              	JR	OSSHUT
   176                          ;
   177  00a9  cd4c00            TYPESC:	CALL	OSSHUT		;CLOSE!
   178  00ac  c3ec06            	JP	ABORT
   179                          ;
   180                          ;OSLOAD - Load an area of memory from a file.
   181                          ;   Inputs: HL addresses filename (term CR)
   182                          ;           DE = address at which to load
   183                          ;           BC = maximum allowed size (bytes)
   184                          ;  Outputs: Carry reset indicates no room for file.
   185                          ; Destroys: A,B,C,D,E,H,L,F
   186                          ;
   187  00af  cdce04            STLOAD:	CALL	SAVLOD		;*LOAD
   188  00b2  e5                	PUSH	HL
   189  00b3  1804              	JR	OSL1
   190                          ;
   191  00b5  c5                OSLOAD:	PUSH	BC		;LOAD
   192  00b6  cd2a03            	CALL	SETUP0
   193  00b9  eb                OSL1:	EX	DE,HL
   194  00ba  cd6002            	CALL	OPEN
   195  00bd  201d              	JR	NZ,LOAD0
   196  00bf  3ed6              NOTFND:	LD	A,214
   197  00c1  cd0000            	CALL	EXTERR
   198  00c4  46696c65206e6f74  	DEFM	"File not found"
              20666f756e64      
   199  00d2  00                	DEFB	0
   200  00d3  cd0b02            LOAD:	CALL	READ
   201  00d6  200a              	JR	NZ,LOAD1
   202  00d8  cd5502            	CALL	INCSEC
   203  00db  09                	ADD	HL,BC
   204  00dc  e3                LOAD0:	EX	(SP),HL
   205  00dd  ed42              	SBC	HL,BC
   206  00df  e3                	EX	(SP),HL
   207  00e0  30f1              	JR	NC,LOAD
   208  00e2  c1                LOAD1:	POP	BC
   209  00e3  f5                	PUSH	AF
   210  00e4  cd3400            	CALL	CLOSE
   211  00e7  f1                	POP	AF
   212  00e8  3f                	CCF
   213  00e9  c9                OSCALL:	RET
   214                          ;
   215                          ;OSOPEN - Open a file for reading or writing.
   216                          ;   Inputs: HL addresses filename (term CR)
   217                          ;           Carry set for OPENIN, cleared for OPENOUT.
   218                          ;  Outputs: A = file channel (=0 if cannot open)
   219                          ;           DE = file FCB
   220                          ; Destroys: A,B,C,D,E,H,L,F
   221                          ;
   222  00ea  f5                OPENIT:	PUSH	AF		;SAVE CARRY
   223  00eb  cd2a03            	CALL	SETUP0
   224  00ee  f1                	POP	AF
   225  00ef  d46a02            	CALL	NC,CREATE
   226  00f2  dc6002            	CALL	C,OPEN
   227  00f5  c9                	RET
   228                          ;
   229  00f6  cdea00            OSOPEN:	CALL	OPENIT
   230  00f9  c8                	RET	Z		;ERROR
   231  00fa  0607              	LD	B,7		;MAX. NUMBER OF FILES
   232  00fc  210d08            	LD	HL,TABLE+15
   233  00ff  7e                OPEN1:	LD	A,(HL)
   234  0100  2b                	DEC	HL
   235  0101  b6                	OR	(HL)
   236  0102  281c              	JR	Z,OPEN2		;FREE CHANNEL
   237  0104  2b                	DEC	HL
   238  0105  10f8              	DJNZ	OPEN1
   239  0107  3ec0              	LD	A,192
   240  0109  cd0000            	CALL	EXTERR
   241  010c  546f6f206d616e79  	DEFM	"Too many open files"
              206f70656e206669  
              6c6573            
   242  011f  00                	DEFB	0
   243                          ;
   244  0120  ed5b0000          OPEN2:	LD	DE,(FREE)	;FREE SPACE POINTER
   245  0124  73                	LD	(HL),E
   246  0125  23                	INC	HL
   247  0126  72                	LD	(HL),D
   248  0127  78                	LD	A,B		;CHANNEL (1-7)
   249  0128  21a600            	LD	HL,FCBSIZ
   250  012b  19                	ADD	HL,DE		;RESERVE SPACE
   251  012c  220000            	LD	(FREE),HL
   252  012f  215c00            OPEN3:	LD	HL,FCB		;ENTRY FROM SPOOL/EXEC
   253  0132  d5                	PUSH	DE
   254  0133  012400            	LD	BC,36
   255  0136  edb0              	LDIR			;COPY FCB
   256  0138  eb                	EX	DE,HL
   257  0139  23                	INC	HL
   258  013a  71                	LD	(HL),C		;CLEAR PTR
   259  013b  23                	INC	HL
   260  013c  d1                	POP	DE
   261  013d  47                	LD	B,A
   262  013e  cdeb01            	CALL	RDF		;READ OR FILL
   263  0141  78                	LD	A,B
   264  0142  c30000            	JP	CHECK
   265                          ;
   266                          ;OSBPUT - Write a byte to a random disk file.
   267                          ;   Inputs: E = file channel
   268                          ;           A = byte to write
   269                          ; Destroys: A,B,C,F
   270                          ;
   271  0145  d5                OSBPUT:	PUSH	DE
   272  0146  e5                	PUSH	HL
   273  0147  47                	LD	B,A
   274  0148  cda202            	CALL	FIND
   275  014b  78                	LD	A,B
   276  014c  0600              	LD	B,0
   277  014e  2b                	DEC	HL
   278  014f  70                	LD	(HL),B		;CLEAR EOF
   279  0150  23                	INC	HL
   280  0151  4e                	LD	C,(HL)
   281  0152  cbb9              	RES	7,C
   282  0154  cbfe              	SET	7,(HL)
   283  0156  34                	INC	(HL)
   284  0157  23                	INC	HL
   285  0158  e5                	PUSH	HL
   286  0159  09                	ADD	HL,BC
   287  015a  77                	LD	(HL),A
   288  015b  e1                	POP	HL
   289  015c  cce801            	CALL	Z,WRRDF		;WRITE THEN READ/FILL
   290  015f  e1                	POP	HL
   291  0160  d1                	POP	DE
   292  0161  c9                	RET
   293                          ;
   294                          ;OSBGET - Read a byte from a random disk file.
   295                          ;   Inputs: E = file channel
   296                          ;  Outputs: A = byte read
   297                          ;           Carry set if LAST BYTE of file
   298                          ; Destroys: A,B,C,F
   299                          ;
   300  0162  d5                OSBGET:	PUSH	DE
   301  0163  e5                	PUSH	HL
   302  0164  cda202            	CALL	FIND
   303  0167  4e                	LD	C,(HL)
   304  0168  cbb9              	RES	7,C
   305  016a  34                	INC	(HL)
   306  016b  23                	INC	HL
   307  016c  e5                	PUSH	HL
   308  016d  0600              	LD	B,0
   309  016f  09                	ADD	HL,BC
   310  0170  46                	LD	B,(HL)
   311  0171  e1                	POP	HL
   312  0172  ec0302            	CALL	PE,INCRDF	;INC SECTOR THEN READ
   313  0175  cce801            	CALL	Z,WRRDF		;WRITE THEN READ/FILL
   314  0178  78                	LD	A,B
   315  0179  e1                	POP	HL
   316  017a  d1                	POP	DE
   317  017b  c9                	RET
   318                          ;
   319                          ;OSSTAT - Read file status.
   320                          ;   Inputs: E = file channel
   321                          ;  Outputs: Z flag set - EOF
   322                          ;           (If Z then A=0)
   323                          ;           DE = address of file block.
   324                          ; Destroys: A,D,E,H,L,F
   325                          ;
   326  017c  cda202            OSSTAT:	CALL	FIND
   327  017f  2b                	DEC	HL
   328  0180  7e                	LD	A,(HL)
   329  0181  3c                	INC	A
   330  0182  c9                	RET
   331                          ;
   332                          ;GETEXT - Find file size.
   333                          ;   Inputs: E = file channel
   334                          ;  Outputs: DEHL = file size (0-&800000)
   335                          ; Destroys: A,B,C,D,E,H,L,F
   336                          ;
   337  0183  cda202            GETEXT:	CALL	FIND
   338  0186  eb                	EX	DE,HL
   339  0187  115c00            	LD	DE,FCB
   340  018a  012400            	LD	BC,36
   341  018d  d5                	PUSH	DE
   342  018e  edb0              	LDIR			;COPY FCB
   343  0190  eb                	EX	DE,HL
   344  0191  e3                	EX	(SP),HL
   345  0192  eb                	EX	DE,HL
   346  0193  3e23              	LD	A,35
   347  0195  cd1002            	CALL	BDOS1		;COMPUTE SIZE
   348  0198  e1                	POP	HL
   349  0199  af                	XOR	A
   350  019a  1806              	JR	GETPT1
   351                          ;
   352                          ;GETPTR - Return file pointer.
   353                          ;   Inputs: E = file channel
   354                          ;  Outputs: DEHL = pointer (0-&7FFFFF)
   355                          ; Destroys: A,B,C,D,E,H,L,F
   356                          ;
   357  019c  cda202            GETPTR:	CALL	FIND
   358  019f  7e                	LD	A,(HL)
   359  01a0  87                	ADD	A,A
   360  01a1  2b                	DEC	HL
   361  01a2  2b                GETPT1:	DEC	HL
   362  01a3  56                	LD	D,(HL)
   363  01a4  2b                	DEC	HL
   364  01a5  5e                	LD	E,(HL)
   365  01a6  2b                	DEC	HL
   366  01a7  66                	LD	H,(HL)
   367  01a8  6f                	LD	L,A
   368  01a9  cb3a              	SRL	D
   369  01ab  cb1b              	RR	E
   370  01ad  cb1c              	RR	H
   371  01af  cb1d              	RR	L
   372  01b1  c9                	RET
   373                          ;
   374                          ;PUTPTR - Update file pointer.
   375                          ;   Inputs: A = file channel
   376                          ;           DEHL = new pointer (0-&7FFFFF)
   377                          ; Destroys: A,B,C,D,E,H,L,F
   378                          ;
   379  01b2  55                PUTPTR:	LD	D,L
   380  01b3  29                	ADD	HL,HL
   381  01b4  cb13              	RL	E
   382  01b6  43                	LD	B,E
   383  01b7  4c                	LD	C,H
   384  01b8  5f                	LD	E,A		;CHANNEL
   385  01b9  d5                	PUSH	DE
   386  01ba  cda202            	CALL	FIND
   387  01bd  f1                	POP	AF
   388  01be  e67f              	AND	7FH
   389  01c0  cb7e              	BIT	7,(HL)		;PENDING WRITE?
   390  01c2  2802              	JR	Z,PUTPT1
   391  01c4  f680              	OR	80H
   392  01c6  77                PUTPT1:	LD	(HL),A
   393  01c7  d5                	PUSH	DE
   394  01c8  e5                	PUSH	HL
   395  01c9  2b                	DEC	HL
   396  01ca  2b                	DEC	HL
   397  01cb  2b                	DEC	HL
   398  01cc  56                	LD	D,(HL)
   399  01cd  2b                	DEC	HL
   400  01ce  5e                	LD	E,(HL)
   401  01cf  eb                	EX	DE,HL
   402  01d0  b7                	OR	A
   403  01d1  ed42              	SBC	HL,BC
   404  01d3  e1                	POP	HL
   405  01d4  d1                	POP	DE
   406  01d5  c8                	RET	Z
   407  01d6  23                	INC	HL
   408  01d7  b7                	OR	A
   409  01d8  fc3c02            	CALL	M,WRITE
   410  01db  e5                	PUSH	HL
   411  01dc  2b                	DEC	HL
   412  01dd  2b                	DEC	HL
   413  01de  2b                	DEC	HL
   414  01df  3600              	LD	(HL),0
   415  01e1  2b                	DEC	HL
   416  01e2  70                	LD	(HL),B
   417  01e3  2b                	DEC	HL
   418  01e4  71                	LD	(HL),C		;NEW RECORD NO.
   419  01e5  e1                	POP	HL
   420  01e6  1803              	JR	RDF
   421                          ;
   422                          ;WRRDF - Write, read; if EOF fill with zeroes.
   423                          ;RDF - Read; if EOF fill with zeroes.
   424                          ;   Inputs: DE address FCB.
   425                          ;           HL addresses data buffer.
   426                          ;  Outputs: A=0, Z-flag set.
   427                          ;           Carry set if fill done (EOF)
   428                          ; Destroys: A,H,L,F
   429                          ;
   430  01e8  cd3c02            WRRDF:	CALL	WRITE
   431  01eb  cd0b02            RDF:	CALL	READ
   432  01ee  2b                	DEC	HL
   433  01ef  cbbe              	RES	7,(HL)
   434  01f1  2b                	DEC	HL
   435  01f2  77                	LD	(HL),A		;CLEAR EOF FLAG
   436  01f3  c8                	RET	Z
   437  01f4  36ff              	LD	(HL),-1		;SET EOF FLAG
   438  01f6  23                	INC	HL
   439  01f7  23                	INC	HL
   440  01f8  c5                	PUSH	BC
   441  01f9  af                	XOR	A
   442  01fa  0680              	LD	B,128
   443  01fc  77                FILL:	LD	(HL),A
   444  01fd  23                	INC	HL
   445  01fe  10fc              	DJNZ	FILL
   446  0200  c1                	POP	BC
   447  0201  37                	SCF
   448  0202  c9                	RET
   449                          ;
   450                          ;INCRDF - Increment record, read; if EOF fill.
   451                          ;   Inputs: DE addresses FCB.
   452                          ;           HL addresses data buffer.
   453                          ;  Outputs: A=1, Z-flag reset.
   454                          ;           Carry set if fill done (EOF)
   455                          ; Destroys: A,H,L,F
   456                          ;
   457  0203  cd5502            INCRDF:	CALL	INCSEC
   458  0206  cdeb01            	CALL	RDF
   459  0209  3c                	INC	A
   460  020a  c9                	RET
   461                          ;
   462                          ;READ - Read a record from a disk file.
   463                          ;   Inputs: DE addresses FCB.
   464                          ;           HL = address to store data.
   465                          ;  Outputs: A<>0 & Z-flag reset indicates EOF.
   466                          ;           Carry = 0
   467                          ; Destroys: A,F
   468                          ;
   469                          ;BDOS1 - CP/M BDOS call.
   470                          ;   Inputs: A = function number
   471                          ;          DE = parameter
   472                          ;  Outputs: AF = result (carry=0)
   473                          ; Destroys: A,F
   474                          ;
   475  020b  cd9a02            READ:	CALL	SETDMA
   476  020e  3e21              	LD	A,33
   477  0210  cd2702            BDOS1:	CALL	BDOS0
   478  0213  2002              	JR	NZ,CPMERR
   479  0215  b7                	OR	A
   480  0216  c9                	RET
   481  0217  3eff              CPMERR:	LD	A,255
   482  0219  cd0000            	CALL	EXTERR
   483  021c  43502f4d20457272  	DEFM	"CP/M Error"
              6f72              
   484  0226  00                	DEFB	0
   485                          ;
   486  0227  c5                BDOS0:	PUSH	BC
   487  0228  d5                	PUSH	DE
   488  0229  e5                	PUSH	HL
   489  022a  dde5              	PUSH	IX
   490  022c  fde5              	PUSH	IY
   491  022e  4f                	LD	C,A
   492  022f  cd0500            	CALL	BDOS
   493  0232  24                	INC	H
   494  0233  25                	DEC	H
