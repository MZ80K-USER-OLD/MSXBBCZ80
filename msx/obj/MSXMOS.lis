  1406  0797  fe0d              	CP	CR		;JUST SHUT?
  1407  0799  c8                	RET	Z
  1408  079a  3abc09            	LD	A,(FLAGS)
  1409  079d  b0                	OR	B
  1410  079e  32bc09            	LD	(FLAGS),A	;SPOOL/EXEC FLAG
  1411  07a1  1f                	RRA			;CARRY=1 FOR EXEC
  1412  07a2  cd6b02            	CALL	OPENIT		;OPEN SPOOL/EXEC FILE
  1413  07a5  c8                	RET	Z		;DIR FULL / NOT FOUND
  1414  07a6  dde1              	POP	IX		;RETURN ADDRESS
  1415  07a8  2a0000            	LD	HL,(HIMEM)
  1416  07ab  b7                	OR	A
  1417  07ac  ed72              	SBC	HL,SP		;SP=HIMEM?
  1418  07ae  39                	ADD	HL,SP
  1419  07af  200f              	JR	NZ,JPIX		;ABORT
  1420  07b1  015aff            	LD	BC,-FCBSIZ
  1421  07b4  09                	ADD	HL,BC		;HL=HL-FCBSIZ
  1422  07b5  220000            	LD	(HIMEM),HL	;NEW HIMEM
  1423  07b8  22ac09            	LD	(TABLE),HL	;FCB/BUFFER
  1424  07bb  f9                	LD	SP,HL		;NEW SP
  1425  07bc  eb                	EX	DE,HL
  1426  07bd  cdb002            	CALL	OPEN3		;FINISH OPEN OPERATION
  1427  07c0  dde9              JPIX:	JP	(IX)		;"RETURN"
  1428                          ;
