  1329  0789  3e00              	LD	A,0
  1330  078b  38b5              	JR	C,STR22
  1331                          ;
  1332                          ;At this point, the decimal character string is stored
  1333                          ; on the stack. Trailing zeroes are suppressed and may
  1334                          ; need to be replaced.
  1335                          ;B register holds decimal point position.
  1336                          ;Now format number and store as ASCII string:
  1337                          ;
  1338  078d  eb                STR3:	EX	DE,HL		;STRING POINTER
  1339  078e  0eff              	LD	C,-1		;FLAG "E"
  1340  0790  1601              	LD	D,1
  1341  0792  dd5e01            	LD	E,(IX+1)	;f2
  1342  0795  ddcb0246          	BIT	0,(IX+2)
