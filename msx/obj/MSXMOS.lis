    85                          IFNDEF BDOS
    86                          BDOS		EQU	$0005			; MSX-DOS API CALL
    87                          ENDIF
    88                          ;
    89                          ;
    90                          ;OSSAVE - Save an area of memory to a file.
    91                          ;   Inputs: HL addresses filename (term CR)
    92                          ;           DE = start address of data to save
    93                          ;           BC = length of data to save (bytes)
    94                          ; Destroys: A,B,C,D,E,H,L,F
    95                          ;
    96  0000  cd7c06            STSAVE:	CALL	SAVLOD		;*SAVE
    97  0003  da4a06            	JP	C,HUH		;"Bad command"
    98  0006  e5                	PUSH	HL
    99  0007  180c              	JR	OSS1
   100                          ;
   101                          OSSAVE:
   102  0009  3a0000            	LD	A,(DOS_VER)
   103  000c  fe02              	CP	2
   104  000e  d2ac01            	JP	NC,OSSAVE_DOS2
   105                          
   106  0011  c5                	PUSH	BC		;SAVE
   107  0012  cdd804            	CALL	SETUP0
   108  0015  eb                OSS1:	EX	DE,HL
   109  0016  cdeb03            	CALL	CREATE
   110  0019  2014              	JR	NZ,SAVE
   111  001b  3ebe              DIRFUL:	LD	A,190
   112  001d  cd0000            	CALL	EXTERR
   113  0020  4469726563746f72  	DEFM	"Directory full"
              792066756c6c      
   114  002e  00                	DEFB	0
   115  002f  cdbd03            SAVE:	CALL	WRITE
   116  0032  09                	ADD	HL,BC
   117  0033  e3                	EX	(SP),HL
   118  0034  ed42              	SBC	HL,BC
   119  0036  e3                	EX	(SP),HL
   120  0037  2802              	JR	Z,SAVE1
   121  0039  30f4              	JR	NC,SAVE
   122  003b  c1                SAVE1:	POP	BC
   123  003c  3e10              CLOSE:	LD	A,16
   124  003e  cd9103            	CALL	BDOS1
   125  0041  3c                	INC	A
   126  0042  c0                	RET	NZ
   127  0043  3ec8              	LD	A,200
   128  0045  cd0000            	CALL	EXTERR
   129  0048  436c6f7365206572  	DEFM	"Close error"
              726f72            
   130  0053  00                	DEFB	0
   131                          ;
   132                          ;OSSHUT - Close disk file(s).
   133                          ;   Inputs: E = file channel
   134                          ;           If E=0 all files are closed (except SPOOL)
   135                          ; Destroys: A,B,C,D,E,H,L,F
   136                          ;
   137  0054  7b                OSSHUT:	LD	A,E
   138  0055  b7                	OR	A
   139  0056  200b              	JR	NZ,SHUTIT
   140  0058  1c                SHUT0:	INC	E
   141  0059  cb5b              	BIT	3,E
   142  005b  c0                	RET	NZ
   143  005c  d5                	PUSH	DE
   144  005d  cd7400            	CALL	SHUT1
   145  0060  d1                	POP	DE
   146  0061  18f5              	JR	SHUT0
   147                          ;
   148  0063  cd4404            SHUTIT:	CALL	FIND1
   149  0066  2010              	JR	NZ,SHUT2
   150  0068  c32f04            	JP	CHANER
   151                          ;
   152  006b  21bc09            SESHUT:	LD	HL,FLAGS
   153  006e  cb86              	RES	0,(HL)		;STOP EXEC
   154  0070  cb8e              	RES	1,(HL)		;STOP SPOOL
   155  0072  1e08              	LD	E,8		;SPOOL/EXEC CHANNEL
   156  0074  cd4404            SHUT1:	CALL	FIND1
   157  0077  c8                	RET	Z
   158  0078  af                SHUT2:	XOR	A
   159  0079  77                	LD	(HL),A
   160  007a  2b                	DEC	HL
   161  007b  77                	LD	(HL),A
   162  007c  212500            	LD	HL,37
   163  007f  19                	ADD	HL,DE
   164  0080  cb7e              	BIT	7,(HL)
   165  0082  23                	INC	HL
   166  0083  c4bd03            	CALL	NZ,WRITE
   167  0086  21a600            	LD	HL,FCBSIZ
   168  0089  19                	ADD	HL,DE
   169  008a  ed4b0000          	LD	BC,(FREE)
   170  008e  ed42              	SBC	HL,BC
   171  0090  20aa              	JR	NZ,CLOSE
   172  0092  ed530000          	LD	(FREE),DE	;RELEASE SPACE
   173  0096  18a4              	JR	CLOSE
   174                          ;
   175                          ;TYPE - *TYPE command.
   176                          ;Types file to console output.
   177                          ;
   178  0098  37                TYPE:	SCF			;*TYPE
   179  0099  cd7702            	CALL	OSOPEN
   180  009c  b7                	OR	A
   181  009d  2830              	JR	Z,NOTFND
   182  009f  5f                	LD	E,A
   183  00a0  3abc09            TYPE1:	LD	A,(FLAGS)	;TEST
   184  00a3  cb7f              	BIT	7,A		;FOR
   185  00a5  200a              	JR	NZ,TYPESC	;ESCape
   186  00a7  cde302            	CALL	OSBGET
   187  00aa  cd1a09            	CALL	OSWRCH		;N.B. CALLS "TEST"
   188  00ad  30f1              	JR	NC,TYPE1
   189  00af  18a3              	JR	OSSHUT
   190                          ;
   191  00b1  cd5400            TYPESC:	CALL	OSSHUT		;CLOSE!
   192  00b4  c39a08            	JP	ABORT
   193                          ;
   194                          ;OSLOAD - Load an area of memory from a file.
   195                          ;   Inputs: HL addresses filename (term CR)
   196                          ;           DE = address at which to load
   197                          ;           BC = maximum allowed size (bytes)
   198                          ;  Outputs: Carry reset indicates no room for file.
   199                          ; Destroys: A,B,C,D,E,H,L,F
   200                          ;
   201  00b7  cd7c06            STLOAD:	CALL	SAVLOD		;*LOAD
   202  00ba  e5                	PUSH	HL
   203  00bb  180c              	JR	OSL1
   204                          ;
   205                          OSLOAD:
   206  00bd  3a0000            	LD	A,(DOS_VER)
   207  00c0  fe02              	CP	2
   208  00c2  d2fa00            	JP	NC,OSLOAD_DOS2
   209  00c5  c5                OSLOAD_CPM:	PUSH	BC		;LOAD
   210  00c6  cdd804            	CALL	SETUP0
   211  00c9  eb                OSL1:	EX	DE,HL
   212  00ca  cde103            	CALL	OPEN
   213  00cd  201d              	JR	NZ,LOAD0
   214  00cf  3ed6              NOTFND:	LD	A,214
   215  00d1  cd0000            	CALL	EXTERR
   216  00d4  46696c65206e6f74  	DEFM	"File not found"
              20666f756e64      
   217  00e2  00                	DEFB	0
   218  00e3  cd8c03            LOAD:	CALL	READ
   219  00e6  200a              	JR	NZ,LOAD1
   220  00e8  cdd603            	CALL	INCSEC
   221  00eb  09                	ADD	HL,BC
   222  00ec  e3                LOAD0:	EX	(SP),HL
   223  00ed  ed42              	SBC	HL,BC
   224  00ef  e3                	EX	(SP),HL
   225  00f0  30f1              	JR	NC,LOAD
   226  00f2  c1                LOAD1:	POP	BC
   227  00f3  f5                	PUSH	AF
   228  00f4  cd3c00            	CALL	CLOSE
   229  00f7  f1                	POP	AF
   230  00f8  3f                	CCF
   231  00f9  c9                OSCALL:	RET
   232                          
   233                          ;OSLOAD_DOS2 - Load through an MSX-DOS2 file handle.
   234                          ; _READ returns the actual byte count in HL.
   235                          ; Each read is limited to 512 bytes.
   236                          ;
   237                          OSLOAD_DOS2:
   238  00fa  ed530000          	LD	(FILE_BUFADRS),DE
   239  00fe  ed430000          	LD	(FILE_MAXSIZE),BC
   240  0102  cdd804            	CALL	SETUP0
   241  0105  cd8804            	CALL	PATHNORM
   242  0108  cdab04            	CALL	DOS2_DEFAULT_EXT
   243                          
   244  010b  110000            	LD	DE,PATHBUF
   245  010e  3e01              	LD	A,1			; read-only
   246  0110  cd1102            	CALL	HOPEN
   247  0113  b7                	OR	A
   248  0114  c25f01            	JP	NZ,FILE_DOS2_NOTFOUND
   249                          
   250                          LOAD_DOS2_LOOP:
   251  0117  2a0000            	LD	HL,(FILE_MAXSIZE)
   252  011a  7c                	LD	A,H
   253  011b  b5                	OR	L
   254  011c  283c              	JR	Z,FILE_DOS2_CLOSE_OK
   255                          
   256  011e  110001            	LD	DE,BLOCKSIZE
   257  0121  b7                	OR	A
   258  0122  ed52              	SBC	HL,DE
   259  0124  3003              	JR	NC,LOAD_DOS2_FULL_BLOCK
   260  0126  19                	ADD	HL,DE
   261  0127  1803              	JR	LOAD_DOS2_HAVE_REQUEST
   262                          
   263                          LOAD_DOS2_FULL_BLOCK:
   264  0129  210001            	LD	HL,BLOCKSIZE
   265                          LOAD_DOS2_HAVE_REQUEST:
   266  012c  220000            	LD	(REQ_BYTES),HL
   267                          
   268  012f  ed5b0000          	LD	DE,(FILE_BUFADRS)
   269  0133  2a0000            	LD	HL,(REQ_BYTES)
   270  0136  cd3702            	CALL	HREAD
   271  0139  b7                	OR	A
   272  013a  2052              	JR	NZ,FILE_DOS2_ERROR
   273  013c  7c                	LD	A,H
   274  013d  b5                	OR	L
   275  013e  281a              	JR	Z,FILE_DOS2_CLOSE_OK
   276                          
   277  0140  ed530000          	LD	(FILE_BUFADRS),DE
   278  0144  eb                	EX	DE,HL
   279  0145  2a0000            	LD	HL,(FILE_MAXSIZE)
   280  0148  b7                	OR	A
   281  0149  ed52              	SBC	HL,DE
   282  014b  3841              	JR	C,FILE_DOS2_ERROR
   283  014d  220000            	LD	(FILE_MAXSIZE),HL
   284                          
   285  0150  2a0000            	LD	HL,(REQ_BYTES)
   286  0153  b7                	OR	A
   287  0154  ed52              	SBC	HL,DE
   288  0156  3836              	JR	C,FILE_DOS2_ERROR
   289  0158  28bd              	JR	Z,LOAD_DOS2_LOOP
   290                          FILE_DOS2_CLOSE_OK:
   291  015a  cd2d02            	CALL	HCLOSE
   292  015d  37                	SCF
   293  015e  c9                	RET
   294                          
   295                          FILE_DOS2_NOTFOUND:
   296  015f  3ed6              	LD	A,214
   297  0161  cd0000            	CALL	EXTERR
   298  0164  46696c65206e6f74  	DEFM	"File not found"
              20666f756e64      
   299  0172  00                	DEFB	0
   300                          
   301                          FILE_DOS2_CREATE_ERROR:
   302  0173  3eff              	LD	A,255
   303  0175  cd0000            	CALL	EXTERR
   304  0178  4d53582d444f5332  	DEFM	"MSX-DOS2 create error"
              2063726561746520  
              6572726f72        
   305  018d  00                	DEFB	0
   306                          
   307                          FILE_DOS2_ERROR:
   308  018e  f5                	PUSH	AF
   309  018f  cd2d02            	CALL	HCLOSE
   310  0192  f1                	POP	AF
   311  0193  3eff              	LD	A,255
   312  0195  cd0000            	CALL	EXTERR
   313  0198  4d53582d444f5332  	DEFM	"MSX-DOS2 file error"
              2066696c65206572  
              726f72            
   314  01ab  00                	DEFB	0
   315                          
   316                          ;
   317                          ;OSSAVE_DOS2 - Save through an MSX-DOS2 file handle.
   318                          ; _WRITE returns the actual byte count in HL.
   319                          ; Each write is limited to 512 bytes.
   320                          ;  DE=FILE BUFFER
   321                          ;  BC=FILE SIZE (bytes)
   322                          OSSAVE_DOS2:
   323  01ac  ed530000          	LD	(FILE_BUFADRS),DE
   324  01b0  ed430000          	LD	(FILE_MAXSIZE),BC
   325  01b4  cdd804            	CALL	SETUP0
   326  01b7  cd8804            	CALL	PATHNORM
   327  01ba  cdab04            	CALL	DOS2_DEFAULT_EXT
   328                          
   329  01bd  110000            	LD	DE,PATHBUF
   330  01c0  cd1e02            	CALL	HCREATE
   331  01c3  b7                	OR	A
   332  01c4  c27301            	JP	NZ,FILE_DOS2_CREATE_ERROR
   333                          SAVE_DOS2_LOOP:
   334  01c7  2a0000            	LD	HL,(FILE_MAXSIZE)   ;FILE remaining size
   335  01ca  7c                	LD	A,H
   336  01cb  b5                	OR	L
   337  01cc  288c              	JR	Z,FILE_DOS2_CLOSE_OK
   338                          
   339  01ce  110001            	LD	DE,BLOCKSIZE
   340  01d1  b7                	OR	A
   341  01d2  ed52              	SBC	HL,DE
   342  01d4  3003              	JR	NC,SAVE_DOS2_FULL_BLOCK	; BLOCK SIZE WRITE
   343  01d6  19                	ADD	HL,DE
   344  01d7  1803              	JR	SAVE_DOS2_SIZE; short block write
   345                          
   346                          SAVE_DOS2_FULL_BLOCK:
   347  01d9  210001            	LD	HL,BLOCKSIZE	; full block write
   348                          
   349                          SAVE_DOS2_SIZE:
   350  01dc  220000            	LD	(REQ_BYTES),HL
   351  01df  ed5b0000          	LD	DE,(FILE_BUFADRS)
   352  01e3  2a0000            	LD	HL,(REQ_BYTES)
   353  01e6  cd5902            	CALL	HWRITE
   354  01e9  b7                	OR	A
   355  01ea  c28e01            	JP	NZ,FILE_DOS2_ERROR
   356  01ed  7c                	LD	A,H
   357  01ee  b5                	OR	L
   358  01ef  ca5a01            	JP	Z,FILE_DOS2_CLOSE_OK
   359                          
   360  01f2  ed530000          	LD	(FILE_BUFADRS),DE
   361  01f6  eb                	EX	DE,HL
   362  01f7  2a0000            	LD	HL,(FILE_MAXSIZE)
   363  01fa  b7                	OR	A
   364  01fb  ed52              	SBC	HL,DE
   365  01fd  da8e01            	JP	C,FILE_DOS2_ERROR
   366  0200  220000            	LD	(FILE_MAXSIZE),HL
   367                          
   368  0203  2a0000            	LD	HL,(REQ_BYTES)
   369  0206  b7                	OR	A
   370  0207  ed52              	SBC	HL,DE
   371  0209  da8e01            	JP	C,FILE_DOS2_ERROR	;
   372  020c  28b9              	JR	Z,SAVE_DOS2_LOOP
   373  020e  c35a01            	JP	FILE_DOS2_CLOSE_OK	; short read means EOF
   374                          
   375                          
   376                          ; HOPEN - Open an MSX-DOS2 file.
   377                          ;   Inputs: DE = ASCIIZ filename, A = access mode
   378                          ;  Outputs: A = error code (0 on success), FILE_HANDLE = file handle
   379                          ; Destroys: A,C,DE,HL,F
   380                          HOPEN:
   381  0211  0e43              	LD	C,43H			; _OPEN
   382  0213  cd0500            	CALL	BDOS
   383  0216  b7                	OR	A
   384  0217  c0                	RET	NZ
   385  0218  78                	LD	A,B
   386  0219  320000            	LD	(FILE_HANDLE),A
   387  021c  af                	XOR	A
   388  021d  c9                	RET
   389                          
   390                          ; HCREATE - Create/truncate an MSX-DOS2 file.
   391                          ;   Inputs: DE = ASCIIZ filename
   392                          ;  Outputs: A = error code (0 on success), FILE_HANDLE = file handle
   393                          ;  Destroys: A,B,C,DE,HL,F
   394                          HCREATE:
   395  021e  0600              	LD	B,0			; normal file attribute
   396  0220  0e44              	LD	C,44H			; _CREATE
   397  0222  cd0500            	CALL	BDOS
   398  0225  b7                	OR	A
   399  0226  c0                	RET	NZ
   400  0227  78                	LD	A,B
   401  0228  320000            	LD	(FILE_HANDLE),A
   402  022b  af                	XOR	A
   403  022c  c9                	RET
   404                          
   405                          ; HCLOSE - Close an MSX-DOS2 file handle.
   406                          ;   Inputs: FILE_HANDLE = file handle
   407                          ;  Outputs: A = error code (0 on success)
   408                          ; Destroys: A,BC,DE,HL,F
   409                          HCLOSE:
   410  022d  3a0000            	LD	A,(FILE_HANDLE)
   411  0230  47                	LD	B,A
   412  0231  0e45              	LD	C,45H			; _CLOSE
   413  0233  cd0500            	CALL	BDOS
   414  0236  c9                	RET
   415                          
   416                          ; HREAD - Read bytes through an MSX-DOS2 file handle.
   417                          ;   Inputs: FILE_HANDLE = file handle, DE = destination buffer,
   418                          ;           HL = requested bytes
   419                          ;  Outputs: A = error code (0 on success), DE = next buffer address,
   420                          ;           HL = actual bytes read returned by _READ
   421                          ; Destroys: A,BC,F
   422                          HREAD:
   423  0237  ed530000          	LD	(FILE_BUFADRS),DE
   424  023b  220000            	LD	(REQ_BYTES),HL
   425  023e  3a0000            	LD	A,(FILE_HANDLE)
   426  0241  47                	LD	B,A
   427  0242  ed5b0000          	LD	DE,(FILE_BUFADRS)
   428  0246  2a0000            	LD	HL,(REQ_BYTES)
   429  0249  0e48              	LD	C,48H			; _READ
   430  024b  cd0500            	CALL	BDOS
   431  024e  b7                	OR	A
   432  024f  c0                	RET	NZ
   433  0250  ed5b0000          	LD	DE,(FILE_BUFADRS)
   434  0254  e5                	PUSH	HL
   435  0255  19                	ADD	HL,DE
   436  0256  eb                	EX	DE,HL
   437  0257  e1                	POP	HL
   438  0258  c9                	RET
   439                          ;
   440                          ; HWRITE - Write bytes through an MSX-DOS2 file handle.
   441                          ;   Inputs: FILE_HANDLE = file handle,
   442                          ;           DE = source buffer,
   443                          ;           HL = requested bytes
   444                          ;  Outputs: A = error code (0 on success),
   445                          ;           DE = next buffer address,
   446                          ;           HL = actual bytes written returned by _WRITE
   447                          ; Destroys: A,BC,F
   448                          HWRITE:
   449  0259  3a0000            	LD	A,(FILE_HANDLE)
   450  025c  47                	LD	B,A
   451  025d  0e49              	LD	C,49H			; _WRITE
   452  025f  d5                	PUSH DE
   453  0260  cd0500            	CALL	BDOS
   454  0263  d1                	POP DE
   455  0264  b7                	OR	A
   456  0265  c0                	RET	NZ
   457  0266  e5                	PUSH	HL
   458  0267  19                	ADD	HL,DE
   459  0268  eb                	EX	DE,HL
   460  0269  e1                	POP	HL
   461  026a  c9                	RET
   462                          
   463                          ;OSOPEN - Open a file for reading or writing.
   464                          ;   Inputs: HL addresses filename (term CR)
   465                          ;           Carry set for OPENIN, cleared for OPENOUT.
   466                          ;   Outputs: A = file channel (=0 if cannot open)
   467                          ;            DE = file FCB
   468                          ;   Destroys: A,B,C,D,E,H,L,F
   469                          ;
   470  026b  f5                OPENIT:	PUSH	AF		;SAVE CARRY
   471  026c  cdd804            	CALL	SETUP0
   472  026f  f1                	POP	AF
   473  0270  d4eb03            	CALL	NC,CREATE
   474  0273  dce103            	CALL	C,OPEN
   475  0276  c9                	RET
   476                          ;
   477  0277  cd6b02            OSOPEN:	CALL	OPENIT
   478  027a  c8                	RET	Z		;ERROR
   479  027b  0607              	LD	B,7		;MAX. NUMBER OF FILES
   480  027d  21bb09            	LD	HL,TABLE+15
   481  0280  7e                OPEN1:	LD	A,(HL)
   482  0281  2b                	DEC	HL
   483  0282  b6                	OR	(HL)
   484  0283  281c              	JR	Z,OPEN2		;FREE CHANNEL
   485  0285  2b                	DEC	HL
   486  0286  10f8              	DJNZ	OPEN1
