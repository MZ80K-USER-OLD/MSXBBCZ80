    35                          TAND	EQU	80H
    36                          TOR	EQU	84H
    37                          TERROR	EQU	85H
    38                          TCALL	EQU	0D6H
    39                          TDEF	EQU	0DDH
    40                          ;
    41                          ;ASSEMBLER:
    42                          ;LANGUAGE-INDEPENDENT CONTROL SECTION:
    43                          ; Outputs: A=delimiter, carry set if syntax error.
    44                          ;
    45  0000  cd8803            ASSEM:	CALL	SKIP
    46  0003  fd23              	INC	IY
    47  0005  fe3a              	CP	':'
    48  0007  28f7              	JR	Z,ASSEM
    49  0009  fe5d              	CP	']'
    50  000b  c8                	RET	Z
    51  000c  fe0d              	CP	CR
    52  000e  c8                	RET	Z
    53  000f  fd2b              	DEC	IY
    54  0011  dd2a0000          	LD	IX,(PC)		;PROGRAM COUNTER
    55  0015  210000            	LD	HL,LISTON
    56  0018  cb76              	BIT	6,(HL)
    57  001a  2804              	JR	Z,ASSEM0
    58  001c  dd2a0000          	LD	IX,(OC)		;ORIGIN of CODE
    59  0020  dde5              ASSEM0:	PUSH	IX
    60  0022  fde5              	PUSH	IY
    61  0024  cdb400            	CALL	ASMB
    62  0027  c1                	POP	BC
    63  0028  d1                	POP	DE
    64  0029  d8                	RET	C
    65  002a  cd8803            	CALL	SKIP
    66  002d  37                	SCF
