  1077                          ;PTEXT - Print text
  1078                          ;   Inputs: HL = address of text
  1079                          ;            B = number of characters to print
  1080                          ; Destroys: A,B,H,L,F
  1081                          ;
  1082  05d1  f5                CPTEXT:	PUSH	AF
  1083  05d2  3e3a              	LD	A,':'
  1084  05d4  cd9b06            	CALL	OSWRCH
  1085  05d7  f1                	POP	AF
  1086  05d8  cd9b06            SPTEXT:	CALL	OSWRCH
  1087  05db  7e                PTEXT:	LD	A,(HL)
  1088  05dc  e67f              	AND	7FH
  1089  05de  23                	INC	HL
  1090  05df  cd9b06            	CALL	OSWRCH
  1091  05e2  10f7              	DJNZ	PTEXT
  1092  05e4  c9                	RET
  1093                          ;
  1094                          ;OSINIT - Initialise RAM mapping etc.
  1095                          ;If BASIC is entered by BBCBASIC FILENAME then file
  1096                          ;FILENAME.BBC is automatically CHAINed.
  1097                          ;   Outputs: DE = initial value of HIMEM (top of RAM)
  1098                          ;            HL = initial value of PAGE (user program)
  1099                          ;            Z-flag reset indicates AUTO-RUN.
  1100                          ;  Destroys: A,B,C,D,E,H,L,F
  1101                          ;
  1102  05e5  0e2d              OSINIT:	LD	C,45		;*
  1103  05e7  1efe              	LD	E,254		;*
  1104  05e9  cd0500            	CALL	BDOS		;*
  1105  05ec  af                	XOR	A
  1106  05ed  0615              	LD	B,INILEN
  1107  05ef  212a07            	LD	HL,TABLE
  1108  05f2  77                CLRTAB:	LD	(HL),A		;CLEAR FILE TABLE ETC.
  1109  05f3  23                	INC	HL
  1110  05f4  10fc              	DJNZ	CLRTAB
  1111  05f6  110000            	LD	DE,ACCS
  1112  05f9  218000            	LD	HL,DSKBUF
  1113  05fc  4e                	LD	C,(HL)
  1114  05fd  23                	INC	HL
  1115  05fe  b9                	CP	C		;N.B. A=B=0
  1116  05ff  2802              	JR	Z,NOBOOT
  1117  0601  edb0              	LDIR			;COPY TO ACCS
  1118  0603  eb                NOBOOT:	EX	DE,HL
  1119  0604  360d              	LD	(HL),CR
  1120  0606  ed5b0600          	LD	DE,(6)		;DE = HIMEM
  1121  060a  5f                	LD	E,A		;PAGE BOUNDARY
  1122  060b  210000            	LD	HL,USER
  1123  060e  c9                	RET
  1124                          ;
  1125                          ;
  1126                          ;TRAP - Test ESCAPE flag and abort if set;
  1127                          ;       every 20th call, test for keypress.
  1128                          ; Destroys: A,H,L,F
  1129                          ;
  1130                          ;LTRAP - Test ESCAPE flag and abort if set.
  1131                          ; Destroys: A,F
  1132                          ;
  1133  060f  212907            TRAP:	LD	HL,TRPCNT
  1134  0612  35                	DEC	(HL)
  1135  0613  cc2306            	CALL	Z,TEST20	;TEST KEYBOARD
  1136  0616  3a3a07            LTRAP:	LD	A,(FLAGS)	;ESCAPE FLAG
  1137  0619  b7                	OR	A		;TEST
  1138  061a  f0                	RET	P
  1139  061b  213a07            ABORT:	LD	HL,FLAGS	;ACKNOWLEDGE
  1140  061e  cbbe              	RES	7,(HL)		;ESCAPE
  1141  0620  c30000            	JP	ESCAPE		;AND ABORT
  1142                          ;
  1143                          ;TEST - Sample for ESCape and CTRL/S. If ESCape
  1144                          ;       pressed set ESCAPE flag and return.
  1145                          ; Destroys: A,F
  1146                          ;
  1147  0623  3614              TEST20:	LD	(HL),20
  1148  0625  d5                TEST:	PUSH	DE
  1149  0626  3e06              	LD	A,6
  1150  0628  1eff              	LD	E,0FFH
  1151  062a  cd2702            	CALL	BDOS0
  1152  062d  d1                	POP	DE
  1153  062e  b7                	OR	A
  1154  062f  c8                	RET	Z
  1155  0630  fe13              	CP	'S' & 1FH	;PAUSE DISPLAY?
  1156  0632  281e              	JR	Z,OSRDCH
  1157  0634  fe1b              	CP	ESC
  1158  0636  2857              	JR	Z,ESCSET
  1159  0638  323b07            	LD	(INKEY),A
  1160  063b  c9                	RET
  1161                          ;
  1162                          ;OSRDCH - Read from the current input stream (keyboard).
  1163                          ;  Outputs: A = character
  1164                          ; Destroys: A,F
  1165                          ;
  1166  063c  dd46f4            KEYGET:	LD	B,(IX-12)	;SCREEN WIDTH
  1167  063f  cd5206            	CALL	OSRDCH
  1168  0642  fe7f              	CP	DEL
  1169  0644  2809              	JR	Z,KEYDEL
  1170  0646  fee0              	CP	224
  1171  0648  c0                	RET	NZ
  1172  0649  cd5206            	CALL	OSRDCH
  1173  064c  d641              	SUB	65
  1174  064e  c9                	RET
  1175                          ;
  1176  064f  3e08              KEYDEL:	LD	A,BS
  1177  0651  c9                	RET
  1178                          ;
  1179  0652  3a3a07            OSRDCH:	LD	A,(FLAGS)
  1180  0655  1f                	RRA			;*EXEC ACTIVE?
  1181  0656  380a              	JR	C,EXECIN
  1182  0658  e5                	PUSH	HL
  1183  0659  ed62              	SBC	HL,HL		;HL=0
  1184  065b  cd7a06            	CALL	OSKEY
  1185  065e  e1                	POP	HL
  1186  065f  d8                	RET	C
  1187  0660  18f0              	JR	OSRDCH
  1188                          ;
  1189                          ;EXECIN - Read byte from EXEC file
  1190                          ;  Outputs: A = byte read
  1191                          ; Destroys: A,F
  1192                          ;
  1193  0662  c5                EXECIN:	PUSH	BC		;SAVE REGISTERS
  1194  0663  d5                	PUSH	DE
  1195  0664  e5                	PUSH	HL
  1196  0665  1e08              	LD	E,8		;SPOOL/EXEC CHANNEL
  1197  0667  213a07            	LD	HL,FLAGS
  1198  066a  cb86              	RES	0,(HL)
  1199  066c  cd6201            	CALL	OSBGET
  1200  066f  cbc6              	SET	0,(HL)
  1201  0671  f5                	PUSH	AF
  1202  0672  dc6300            	CALL	C,SESHUT	;END EXEC IF EOF
  1203  0675  f1                	POP	AF
  1204  0676  e1                	POP	HL		;RESTORE REGISTERS
  1205  0677  d1                	POP	DE
  1206  0678  c1                	POP	BC
  1207  0679  c9                	RET
  1208                          ;
  1209                          ;
  1210                          ;OSKEY - Read key with time-limit, test for ESCape.
  1211                          ;Main function is carried out in user patch.
  1212                          ;   Inputs: HL = time limit (centiseconds)
  1213                          ;  Outputs: Carry reset if time-out
  1214                          ;           If carry set A = character
  1215                          ; Destroys: A,H,L,F
  1216                          ;
  1217  067a  e5                OSKEY:	PUSH	HL
  1218  067b  213b07            	LD	HL,INKEY
  1219  067e  7e                	LD	A,(HL)
  1220  067f  3600              	LD	(HL),0
  1221  0681  e1                	POP	HL
  1222  0682  b7                	OR	A
  1223  0683  37                	SCF
  1224  0684  c0                	RET	NZ
  1225  0685  d5                	PUSH	DE
  1226  0686  cd0000            	CALL	GETKEY
  1227  0689  d1                	POP	DE
  1228  068a  d0                	RET	NC
  1229  068b  fe1b              	CP	ESC
  1230  068d  37                	SCF
  1231  068e  c0                	RET	NZ
  1232  068f  e5                ESCSET:	PUSH	HL
  1233  0690  213a07            	LD	HL,FLAGS
  1234  0693  cb76              	BIT	6,(HL)		;ESC DISABLED?
  1235  0695  2002              	JR	NZ,ESCDIS
  1236  0697  cbfe              	SET	7,(HL)		;SET ESCAPE FLAG
  1237  0699  e1                ESCDIS:	POP	HL
  1238  069a  c9                	RET
  1239                          ;
  1240                          ;OSWRCH - Write a character to console output.
  1241                          ;   Inputs: A = character.
  1242                          ; Destroys: Nothing
  1243                          ;
  1244  069b  f5                OSWRCH:	PUSH	AF
  1245  069c  d5                	PUSH	DE
  1246  069d  e5                	PUSH	HL
  1247  069e  cd0000            	CALL  msxCHPUT
  1248  06a1  e1                	POP	HL
  1249  06a2  d1                	POP	DE
  1250  06a3  f1                	POP	AF
  1251  06a4  c9                	RET
  1252                          ;
  1253                          ;OSLINE - Read/edit a complete line, terminated by CR.
  1254                          ;   Inputs: HL addresses destination buffer.
  1255                          ;           (L=0)
  1256                          ;  Outputs: Buffer filled, terminated by CR.
  1257                          ;           A=0.
  1258                          ; Destroys: A,B,C,D,E,H,L,F
  1259                          ;
  1260                          OSLINE:
  1261                          INLINE:
  1262  06a5  eb                	EX DE,HL
  1263  06a6  d5                	PUSH DE
  1264  06a7  cd0000            	CALL msxPINLINE   ; 一行入力 入力先 BUF
  1265  06aa  d1                    POP DE
  1266  06ab  380d              	JR C,OSLINE_STOP   ; CTRL-STOPが押されたら終わり
  1267                          INLINE0:
  1268  06ad  23                	INC HL 		; HL=BUF-1 　だから
  1269  06ae  7e                	LD A,(HL)
  1270  06af  12                	LD (DE),A
  1271  06b0  13                	INC DE
  1272  06b1  b7                	OR A
  1273  06b2  20f9              	JR NZ,INLINE0
  1274  06b4  12                	LD (DE),A	; NULL 終端
  1275  06b5  1b                	DEC DE
  1276  06b6  3e0d              	LD A,CR
  1277  06b8  12                	LD (DE),A	; 0DH,NULL
  1278  06b9  c9                	RET
  1279                          
  1280                          OSLINE_STOP:
  1281  06ba  3e0d              	LD A,CR
  1282  06bc  12                	LD (DE),A	; 0DH
  1283  06bd  13                	INC DE
  1284  06be  af                	XOR A
  1285  06bf  12                	LD (DE),A	; NULL 終端
  1286  06c0  37                	SCF			; CTRL-STOPが押されたことを示す
  1287  06c1  c9                	RET
  1288                          ;
  1289                          ; INIT SCREEN
  1290                          ;
  1291                          INITTXT:
  1292  06c2  3e50              	LD A,80
  1293  06c4  320000            	LD (WIDTH),A
  1294  06c7  c30000            	JP msxINITXT80
