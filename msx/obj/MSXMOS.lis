   849  0410  7e                	LD	A,(HL)
   850  0411  b7                	OR	A
   851  0412  2808              	JR	Z,DOS2_EXT_END
   852  0414  fe2e              	CP	'.'
   853  0416  2817              	JR	Z,DOS2_EXT_HAVE
   854  0418  23                	INC	HL
   855  0419  04                	INC	B
