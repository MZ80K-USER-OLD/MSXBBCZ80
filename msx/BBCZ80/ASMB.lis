   138                          ;
   139                          ;PROCESSOR-SPECIFIC TRANSLATION SECTION:
   140                          ;
   141                          ;REGISTER USAGE: B - TYPE OF MOST RECENT OPERAND
   142                          ;                C - OPCODE BEING BUILT
   143                          ;                D - (IX) OR (IY) FLAG
   144                          ;                E - OFFSET FROM IX OR IY
   145                          ;               HL - NUMERIC OPERAND VALUE
   146                          ;               IX - CODE DESTINATION
   147                          ;               IY - SOURCE TEXT POINTER
   148                          ;   Inputs: A = initial character
   149                          ;  Outputs: Carry set if syntax error.
   150                          ;
   151  00b4  fe2e              ASMB:	CP	'.'
   152  00b6  2028              	JR	NZ,ASMB1
   153  00b8  fd23              	INC	IY
   154  00ba  dde5              	PUSH	IX
   155  00bc  cd0000            	CALL	VAR
