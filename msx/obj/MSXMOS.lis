   860  041f  300e              	JR	NC,DOS2_EXT_HAVE
   861  0421  362e              	LD	(HL),'.'
   862  0423  23                	INC	HL
   863  0424  3642              	LD	(HL),'B'
   864  0426  23                	INC	HL
   865  0427  3642              	LD	(HL),'B'
   866  0429  23                	INC	HL
   867  042a  3643              	LD	(HL),'C'
   868  042c  23                	INC	HL
   869  042d  3600              	LD	(HL),0
   870                          DOS2_EXT_HAVE:
   871  042f  e1                	POP	HL
   872  0430  d1                	POP	DE
   873  0431  c1                	POP	BC
   874  0432  f1                	POP	AF
   875  0433  c9                	RET
   876                          ;
   877                          ;FCB FORMAT (36 BYTES TOTAL):
   878                          ; 0      0=SAME DISK, 1=DISK A, 2=DISK B (ETC.)
   879                          ; 1-8    FILENAME, PADDED WITH SPACES
   880                          ; 9-11   EXTENSION, PADDED WITH SPACES
   881                          ; 12     CURRENT EXTENT, SET TO ZERO
   882                          ; 32-35  CLEARED TO ZERO
   883                          ;
   884  0434  3e20              SETUP0:	LD	A,' '
   885  0436  d5                SETUP:	PUSH	DE
   886  0437  e5                	PUSH	HL
   887  0438  f5                	PUSH	AF
