   966  050e  3e02              SPOOL:	LD	A,00000010B	;*SPOOL
   967  0510  f5                	PUSH	AF
   968  0511  e5                	PUSH	HL
   969  0512  cd6300            	CALL	SESHUT		;STOP SPOOL/EXEC
   970  0515  e1                	POP	HL
   971  0516  c1                	POP	BC
   972  0517  7e                	LD	A,(HL)
   973  0518  fe0d              	CP	CR		;JUST SHUT?
   974  051a  c8                	RET	Z
   975  051b  3a3a07            	LD	A,(FLAGS)
   976  051e  b0                	OR	B
   977  051f  323a07            	LD	(FLAGS),A	;SPOOL/EXEC FLAG
   978  0522  1f                	RRA			;CARRY=1 FOR EXEC
   979  0523  cdea00            	CALL	OPENIT		;OPEN SPOOL/EXEC FILE
   980  0526  c8                	RET	Z		;DIR FULL / NOT FOUND
   981  0527  dde1              	POP	IX		;RETURN ADDRESS
   982  0529  2a0000            	LD	HL,(HIMEM)
   983  052c  b7                	OR	A
   984  052d  ed72              	SBC	HL,SP		;SP=HIMEM?
   985  052f  39                	ADD	HL,SP
   986  0530  200f              	JR	NZ,JPIX		;ABORT
   987  0532  015aff            	LD	BC,-FCBSIZ
   988  0535  09                	ADD	HL,BC		;HL=HL-FCBSIZ
   989  0536  220000            	LD	(HIMEM),HL	;NEW HIMEM
   990  0539  222a07            	LD	(TABLE),HL	;FCB/BUFFER
   991  053c  f9                	LD	SP,HL		;NEW SP
   992  053d  eb                	EX	DE,HL
   993  053e  cd2f01            	CALL	OPEN3		;FINISH OPEN OPERATION
   994  0541  dde9              JPIX:	JP	(IX)		;"RETURN"
