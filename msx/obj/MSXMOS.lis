  1397  07a8  c5                	DEFB	'E'+80H
  1398  07a9  9000              	DEFW	TYPE
  1399  07ab  ff                	DEFB	0FFH
  1400                          ;
  1401                          ;PTEXT - Print text
  1402                          ;   Inputs: HL = address of text
  1403                          ;            B = number of characters to print
  1404                          ; Destroys: A,B,H,L,F
  1405                          ;
  1406  07ac  f5                CPTEXT:	PUSH	AF
  1407  07ad  3e3a              	LD	A,':'
  1408  07af  cd7608            	CALL	OSWRCH
  1409  07b2  f1                	POP	AF
  1410  07b3  cd7608            SPTEXT:	CALL	OSWRCH
  1411  07b6  7e                PTEXT:	LD	A,(HL)
  1412  07b7  e67f              	AND	7FH
  1413  07b9  23                	INC	HL
  1414  07ba  cd7608            	CALL	OSWRCH
  1415  07bd  10f7              	DJNZ	PTEXT
  1416  07bf  c9                	RET
  1417                          ;
  1418                          ;OSINIT - Initialise RAM mapping etc.
  1419                          ;If BASIC is entered by BBCBASIC FILENAME then file
  1420                          ;FILENAME.BBC is automatically CHAINed.
  1421                          ;   Outputs: DE = initial value of HIMEM (top of RAM)
  1422                          ;            HL = initial value of PAGE (user program)
  1423                          ;            Z-flag reset indicates AUTO-RUN.
  1424                          ;  Destroys: A,B,C,D,E,H,L,F
  1425                          ;
  1426  07c0  0e2d              OSINIT:	LD	C,45		;*
  1427  07c2  1efe              	LD	E,254		;*
  1428  07c4  cd0500            	CALL	BDOS		;*
  1429  07c7  af                	XOR	A
  1430  07c8  0615              	LD	B,INILEN
  1431  07ca  210809            	LD	HL,TABLE
  1432  07cd  77                CLRTAB:	LD	(HL),A		;CLEAR FILE TABLE ETC.
  1433  07ce  23                	INC	HL
  1434  07cf  10fc              	DJNZ	CLRTAB
  1435  07d1  110000            	LD	DE,ACCS
  1436  07d4  218000            	LD	HL,DSKBUF
  1437  07d7  4e                	LD	C,(HL)
  1438  07d8  23                	INC	HL
  1439  07d9  b9                	CP	C		;N.B. A=B=0
  1440  07da  2802              	JR	Z,NOBOOT
  1441  07dc  edb0              	LDIR			;COPY TO ACCS
  1442  07de  eb                NOBOOT:	EX	DE,HL
  1443  07df  360d              	LD	(HL),CR
  1444  07e1  ed5b0600          	LD	DE,(6)		;DE = HIMEM
  1445  07e5  5f                	LD	E,A		;PAGE BOUNDARY
  1446  07e6  210000            	LD	HL,USER
  1447  07e9  c9                	RET
  1448                          ;
  1449                          ;
  1450                          ;TRAP - Test ESCAPE flag and abort if set;
  1451                          ;       every 20th call, test for keypress.
  1452                          ; Destroys: A,H,L,F
  1453                          ;
  1454                          ;LTRAP - Test ESCAPE flag and abort if set.
  1455                          ; Destroys: A,F
  1456                          ;
  1457  07ea  210709            TRAP:	LD	HL,TRPCNT
  1458  07ed  35                	DEC	(HL)
  1459  07ee  ccfe07            	CALL	Z,TEST20	;TEST KEYBOARD
  1460  07f1  3a1809            LTRAP:	LD	A,(FLAGS)	;ESCAPE FLAG
  1461  07f4  b7                	OR	A		;TEST
  1462  07f5  f0                	RET	P
  1463  07f6  211809            ABORT:	LD	HL,FLAGS	;ACKNOWLEDGE
  1464  07f9  cbbe              	RES	7,(HL)		;ESCAPE
  1465  07fb  c30000            	JP	ESCAPE		;AND ABORT
  1466                          ;
  1467                          ;TEST - Sample for ESCape and CTRL/S. If ESCape
  1468                          ;       pressed set ESCAPE flag and return.
  1469                          ; Destroys: A,F
  1470                          ;
  1471  07fe  3614              TEST20:	LD	(HL),20
  1472  0800  d5                TEST:	PUSH	DE
  1473  0801  3e06              	LD	A,6
  1474  0803  1eff              	LD	E,0FFH
  1475  0805  cd0403            	CALL	BDOS0
  1476  0808  d1                	POP	DE
  1477  0809  b7                	OR	A
  1478  080a  c8                	RET	Z
  1479  080b  fe13              	CP	'S' & 1FH	;PAUSE DISPLAY?
  1480  080d  281e              	JR	Z,OSRDCH
  1481  080f  fe1b              	CP	ESC
  1482  0811  2857              	JR	Z,ESCSET
  1483  0813  321909            	LD	(INKEY),A
  1484  0816  c9                	RET
  1485                          ;
  1486                          ;OSRDCH - Read from the current input stream (keyboard).
  1487                          ;  Outputs: A = character
  1488                          ; Destroys: A,F
  1489                          ;
  1490  0817  dd46f4            KEYGET:	LD	B,(IX-12)	;SCREEN WIDTH
  1491  081a  cd2d08            	CALL	OSRDCH
  1492  081d  fe7f              	CP	DEL
  1493  081f  2809              	JR	Z,KEYDEL
  1494  0821  fee0              	CP	224
  1495  0823  c0                	RET	NZ
  1496  0824  cd2d08            	CALL	OSRDCH
  1497  0827  d641              	SUB	65
  1498  0829  c9                	RET
  1499                          ;
  1500  082a  3e08              KEYDEL:	LD	A,BS
  1501  082c  c9                	RET
  1502                          ;
  1503  082d  3a1809            OSRDCH:	LD	A,(FLAGS)
  1504  0830  1f                	RRA			;*EXEC ACTIVE?
  1505  0831  380a              	JR	C,EXECIN
  1506  0833  e5                	PUSH	HL
  1507  0834  ed62              	SBC	HL,HL		;HL=0
  1508  0836  cd5508            	CALL	OSKEY
  1509  0839  e1                	POP	HL
  1510  083a  d8                	RET	C
  1511  083b  18f0              	JR	OSRDCH
  1512                          ;
  1513                          ;EXECIN - Read byte from EXEC file
  1514                          ;  Outputs: A = byte read
  1515                          ; Destroys: A,F
  1516                          ;
  1517  083d  c5                EXECIN:	PUSH	BC		;SAVE REGISTERS
  1518  083e  d5                	PUSH	DE
  1519  083f  e5                	PUSH	HL
  1520  0840  1e08              	LD	E,8		;SPOOL/EXEC CHANNEL
  1521  0842  211809            	LD	HL,FLAGS
  1522  0845  cb86              	RES	0,(HL)
  1523  0847  cd3f02            	CALL	OSBGET
  1524  084a  cbc6              	SET	0,(HL)
  1525  084c  f5                	PUSH	AF
  1526  084d  dc6300            	CALL	C,SESHUT	;END EXEC IF EOF
  1527  0850  f1                	POP	AF
  1528  0851  e1                	POP	HL		;RESTORE REGISTERS
  1529  0852  d1                	POP	DE
  1530  0853  c1                	POP	BC
  1531  0854  c9                	RET
  1532                          ;
  1533                          ;
  1534                          ;OSKEY - Read key with time-limit, test for ESCape.
  1535                          ;Main function is carried out in user patch.
  1536                          ;   Inputs: HL = time limit (centiseconds)
  1537                          ;  Outputs: Carry reset if time-out
  1538                          ;           If carry set A = character
  1539                          ; Destroys: A,H,L,F
  1540                          ;
  1541  0855  e5                OSKEY:	PUSH	HL
  1542  0856  211909            	LD	HL,INKEY
  1543  0859  7e                	LD	A,(HL)
  1544  085a  3600              	LD	(HL),0
  1545  085c  e1                	POP	HL
  1546  085d  b7                	OR	A
  1547  085e  37                	SCF
  1548  085f  c0                	RET	NZ
  1549  0860  d5                	PUSH	DE
  1550  0861  cd0000            	CALL	GETKEY
  1551  0864  d1                	POP	DE
  1552  0865  d0                	RET	NC
  1553  0866  fe1b              	CP	ESC
  1554  0868  37                	SCF
  1555  0869  c0                	RET	NZ
  1556  086a  e5                ESCSET:	PUSH	HL
  1557  086b  211809            	LD	HL,FLAGS
  1558  086e  cb76              	BIT	6,(HL)		;ESC DISABLED?
  1559  0870  2002              	JR	NZ,ESCDIS
  1560  0872  cbfe              	SET	7,(HL)		;SET ESCAPE FLAG
  1561  0874  e1                ESCDIS:	POP	HL
  1562  0875  c9                	RET
  1563                          ;
  1564                          ;OSWRCH - Write a character to console output.
  1565                          ;   Inputs: A = character.
  1566                          ; Destroys: Nothing
  1567                          ;
  1568  0876  f5                OSWRCH:	PUSH	AF
  1569  0877  d5                	PUSH	DE
  1570  0878  e5                	PUSH	HL
  1571  0879  cd0000            	CALL  msxCHPUT
  1572  087c  e1                	POP	HL
  1573  087d  d1                	POP	DE
  1574  087e  f1                	POP	AF
  1575  087f  c9                	RET
  1576                          ;
  1577                          ;OSLINE - Read/edit a complete line, terminated by CR.
  1578                          ;   Inputs: HL addresses destination buffer.
  1579                          ;           (L=0)
  1580                          ;  Outputs: Buffer filled, terminated by CR.
  1581                          ;           A=0.
  1582                          ; Destroys: A,B,C,D,E,H,L,F
  1583                          ;
  1584                          OSLINE:
  1585                          INLINE:
  1586  0880  eb                	EX DE,HL
  1587  0881  d5                	PUSH DE
  1588  0882  cd0000            	CALL msxPINLINE   ; 一行入力 入力先 BUF
  1589  0885  d1                    POP DE
  1590  0886  380d              	JR C,OSLINE_STOP   ; CTRL-STOPが押されたら終わり
  1591                          INLINE0:
  1592  0888  23                	INC HL 		; HL=BUF-1 　だから
  1593  0889  7e                	LD A,(HL)
  1594  088a  12                	LD (DE),A
  1595  088b  13                	INC DE
  1596  088c  b7                	OR A
  1597  088d  20f9              	JR NZ,INLINE0
  1598  088f  12                	LD (DE),A	; NULL 終端
  1599  0890  1b                	DEC DE
  1600  0891  3e0d              	LD A,CR
  1601  0893  12                	LD (DE),A	; 0DH,NULL
  1602  0894  c9                	RET
  1603                          
  1604                          OSLINE_STOP:
  1605  0895  3e0d              	LD A,CR
  1606  0897  12                	LD (DE),A	; 0DH
  1607  0898  13                	INC DE
  1608  0899  af                	XOR A
  1609  089a  12                	LD (DE),A	; NULL 終端
  1610  089b  37                	SCF			; CTRL-STOPが押されたことを示す
  1611  089c  c9                	RET
  1612                          ;
  1613                          ; INIT SCREEN
  1614                          ;
  1615                          INITTXT:
  1616  089d  3e50              	LD A,80
  1617  089f  320000            	LD (WIDTH),A
  1618  08a2  c30000            	JP msxINITXT80
  1619                          
  1620                          ;------------------------------------------------------------------------------
  1621                          ; Check Msx-DOS Version (MSX1 or MSX2)
  1622                          ; ------------------------------------------------------------------------------
  1623                          CheckMSXDOS:
  1624                              ; --- バージョン取得 ---
  1625  08a5  010000                ld   bc, 0000h   ; 初期化
  1626  08a8  0e6f                  ld   c, 6Fh      ; _DOSVER
  1627  08aa  cd0500                call BDOS       ; BDOS
  1628                          
  1629  08ad  78                    ld   a, b        ; メジャーバージョン
  1630  08ae  320000                ld   (DOS_VER), a ; 変数に格納
  1631                          
  1632                              ; --- 判定と表示 ---
  1633  08b1  3a0000            	ld   a, (DOS_VER)
  1634  08b4  fe02                  cp   2
  1635  08b6  3006                  jr   nc, print_dos2
  1636                          
  1637                          print_dos1:
  1638  08b8  21c408                LD HL, MSG_DOS1
  1639  08bb  c30000                JP msxSTRPUT
  1640                          
  1641                          print_dos2:
  1642  08be  21d008                LD HL, MSG_DOS2
  1643  08c1  c30000                JP msxSTRPUT
  1644                          
  1645                          
  1646                          ; --- データエリア ---
  1647  08c4  4d53582d444f5320  MSG_DOS1: DEFB "MSX-DOS 1",0DH,0AH,00
              310d0a00          
  1648  08d0  4d53582d444f5320  MSG_DOS2: DEFB "MSX-DOS 2",0DH,0AH,00
              320d0a00          
  1649                          
  1650                          ; ======================================================
  1651                          ; HLレジスタの内容をASCII 4文字で画面に表示する
  1652                          ; ======================================================
  1653                          PrintAddress:
  1654  08dc  7c                    ld  a, h
  1655  08dd  cde108                call PrintHexByte   ; 上位バイト(H)を表示
  1656  08e0  7d                    ld  a, l            ; 下位バイト(L)を表示
  1657                              ; そのまま下の PrintHexByte へ流れる (Fall-through)
  1658                          
  1659                          ; --- 1バイト(A)を16進ASCII 2文字で表示 ---
  1660                          PrintHexByte:
  1661  08e1  f5                    push af             ; 下位ニブル保存用
  1662  08e2  0f                    rrca
  1663  08e3  0f                	rrca 		        ; 上位4ビットを下位へ移動
  1664  08e4  0f                    rrca
  1665  08e5  0f                	rrca
  1666  08e6  cdea08                call PrintNibble    ; 上位桁を表示
  1667  08e9  f1                    pop  af             ; 下位ニブルを戻す
  1668                              ; そのまま下の PrintNibble へ流れる
  1669                          
  1670                          ; --- 下位4ビット(A)をASCII 1文字で表示 (DAAマジック) ---
  1671                          PrintNibble:
  1672  08ea  e60f                  and  0Fh            ; 下位4ビットのみにマスク
  1673  08ec  c690                  add  a, 90h         ; 10進補正を利用するためのオフセット
  1674  08ee  27                    daa                 ; 0-9はそのまま、A-Fは桁上げが発生
  1675  08ef  ce40                  adc  a, 40h         ; ASCII '0'(30h)や'A'(41h)への調整
  1676  08f1  27                    daa                 ; 最終的なASCIIコードに確定
  1677                          
  1678                          ; --- [システム依存] 1文字出力ルーチン ---
  1679                              ; Aレジスタの文字を表示します。
  1680                              ; お使いの環境に合わせて書き換えてください。
  1681                          PUTCHAR::
  1682  08f2  c30000            	JP msxCHPUT ; 画面に表示 (自動的にXが+1される)
  1683                          
  1684                          PUTCRLF:
  1685  08f5  3e0d              	LD A,CR
  1686  08f7  cd0000            	CALL msxCHPUT
  1687  08fa  3e0a              	LD  A,LF
  1688  08fc  c30000            	JP  msxCHPUT
  1689                          
  1690                          PROMPT:
  1691  08ff  3e3e              	LD A,'>'
  1692  0901  c30000            	JP msxCHPUT
  1693                          ;
  1694                          ; HLレジスタの指す文字列を画面に出力するルーチン
  1695                          ; 文字列はNULL(0)で終端されているもの
  1696                          STRPUT:
  1697  0904  c30000                JP msxSTRPUT ; 文字列出力
  1698                          
  1699                          ;
  1700                          ;
  1701                          ;EDITST:	DEFM	"EDIT"
  1702                          ;LISTST:	DEFM	"LIST"
  1703                          ;
  1704                          BEL	EQU	7
  1705                          BS	EQU	8
  1706                          HT	EQU	9
  1707                          LF	EQU	0AH
  1708                          VT	EQU	0BH
  1709                          CR	EQU	0DH
  1710                          ESC	EQU	1BH
  1711                          DEL	EQU	7FH
  1712                          ;
  1713                          BDOS	EQU	5
  1714                          ;
  1715                          FCB	EQU	5CH
  1716                          DSKBUF	EQU	80H
  1717                          ;
  1718                          FCBSIZ	EQU	128+36+2
  1719                          BLOCKSIZE EQU 256
  1720                          ;
  1721  0907  0a                TRPCNT:	DEFB	10
  1722  0908  0000000000000000  TABLE:	DEFS	16		;FILE BLOCK POINTERS
              0000000000000000  
  1723  0918  00                FLAGS:	DEFB	0
  1724  0919  00                INKEY:	DEFB	0
  1725  091a  0000              EDPTR:	DEFW	0
  1726  091c  00                OPTVAL:	DEFB	0
  1727                          INILEN	EQU	$-TABLE
  1728                          ;
  1729                          FIN:	;END
