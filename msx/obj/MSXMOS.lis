  1460                          ;
  1461                          ;PTEXT - Print text
  1462                          ;   Inputs: HL = address of text
  1463                          ;            B = number of characters to print
  1464                          ; Destroys: A,B,H,L,F
  1465                          ;
  1466  0805  f5                CPTEXT:	PUSH	AF
  1467  0806  3e3a              	LD	A,':'
  1468  0808  cdcf08            	CALL	OSWRCH
  1469  080b  f1                	POP	AF
  1470  080c  cdcf08            SPTEXT:	CALL	OSWRCH
  1471  080f  7e                PTEXT:	LD	A,(HL)
  1472  0810  e67f              	AND	7FH
  1473  0812  23                	INC	HL
  1474  0813  cdcf08            	CALL	OSWRCH
  1475  0816  10f7              	DJNZ	PTEXT
  1476  0818  c9                	RET
  1477                          ;
  1478                          ;OSINIT - Initialise RAM mapping etc.
  1479                          ;If BASIC is entered by BBCBASIC FILENAME then file
  1480                          ;FILENAME.BBC is automatically CHAINed.
  1481                          ;   Outputs: DE = initial value of HIMEM (top of RAM)
  1482                          ;            HL = initial value of PAGE (user program)
  1483                          ;            Z-flag reset indicates AUTO-RUN.
  1484                          ;  Destroys: A,B,C,D,E,H,L,F
  1485                          ;
  1486  0819  0e2d              OSINIT:	LD	C,45		;*
  1487  081b  1efe              	LD	E,254		;*
  1488  081d  cd0500            	CALL	BDOS		;*
  1489  0820  af                	XOR	A
  1490  0821  0615              	LD	B,INILEN
  1491  0823  216109            	LD	HL,TABLE
  1492  0826  77                CLRTAB:	LD	(HL),A		;CLEAR FILE TABLE ETC.
  1493  0827  23                	INC	HL
  1494  0828  10fc              	DJNZ	CLRTAB
  1495  082a  110000            	LD	DE,ACCS
  1496  082d  218000            	LD	HL,DSKBUF
  1497  0830  4e                	LD	C,(HL)
  1498  0831  23                	INC	HL
  1499  0832  b9                	CP	C		;N.B. A=B=0
  1500  0833  2802              	JR	Z,NOBOOT
  1501  0835  edb0              	LDIR			;COPY TO ACCS
  1502  0837  eb                NOBOOT:	EX	DE,HL
  1503  0838  360d              	LD	(HL),CR
  1504  083a  ed5b0600          	LD	DE,(6)		;DE = HIMEM
  1505  083e  5f                	LD	E,A		;PAGE BOUNDARY
  1506  083f  210000            	LD	HL,USER
  1507  0842  c9                	RET
  1508                          ;
  1509                          ;
  1510                          ;TRAP - Test ESCAPE flag and abort if set;
  1511                          ;       every 20th call, test for keypress.
  1512                          ; Destroys: A,H,L,F
  1513                          ;
  1514                          ;LTRAP - Test ESCAPE flag and abort if set.
  1515                          ; Destroys: A,F
  1516                          ;
  1517  0843  216009            TRAP:	LD	HL,TRPCNT
  1518  0846  35                	DEC	(HL)
  1519  0847  cc5708            	CALL	Z,TEST20	;TEST KEYBOARD
  1520  084a  3a7109            LTRAP:	LD	A,(FLAGS)	;ESCAPE FLAG
  1521  084d  b7                	OR	A		;TEST
  1522  084e  f0                	RET	P
  1523  084f  217109            ABORT:	LD	HL,FLAGS	;ACKNOWLEDGE
  1524  0852  cbbe              	RES	7,(HL)		;ESCAPE
  1525  0854  c30000            	JP	ESCAPE		;AND ABORT
  1526                          ;
  1527                          ;TEST - Sample for ESCape and CTRL/S. If ESCape
  1528                          ;       pressed set ESCAPE flag and return.
  1529                          ; Destroys: A,F
  1530                          ;
  1531  0857  3614              TEST20:	LD	(HL),20
  1532  0859  d5                TEST:	PUSH	DE
  1533  085a  3e06              	LD	A,6
  1534  085c  1eff              	LD	E,0FFH
  1535  085e  cd5d03            	CALL	BDOS0
  1536  0861  d1                	POP	DE
  1537  0862  b7                	OR	A
  1538  0863  c8                	RET	Z
  1539  0864  fe13              	CP	'S' & 1FH	;PAUSE DISPLAY?
  1540  0866  281e              	JR	Z,OSRDCH
  1541  0868  fe1b              	CP	ESC
  1542  086a  2857              	JR	Z,ESCSET
  1543  086c  327209            	LD	(INKEY),A
  1544  086f  c9                	RET
  1545                          ;
  1546                          ;OSRDCH - Read from the current input stream (keyboard).
  1547                          ;  Outputs: A = character
  1548                          ; Destroys: A,F
  1549                          ;
  1550  0870  dd46f4            KEYGET:	LD	B,(IX-12)	;SCREEN WIDTH
  1551  0873  cd8608            	CALL	OSRDCH
  1552  0876  fe7f              	CP	DEL
  1553  0878  2809              	JR	Z,KEYDEL
  1554  087a  fee0              	CP	224
  1555  087c  c0                	RET	NZ
  1556  087d  cd8608            	CALL	OSRDCH
  1557  0880  d641              	SUB	65
  1558  0882  c9                	RET
  1559                          ;
  1560  0883  3e08              KEYDEL:	LD	A,BS
  1561  0885  c9                	RET
  1562                          ;
  1563  0886  3a7109            OSRDCH:	LD	A,(FLAGS)
  1564  0889  1f                	RRA			;*EXEC ACTIVE?
  1565  088a  380a              	JR	C,EXECIN
  1566  088c  e5                	PUSH	HL
  1567  088d  ed62              	SBC	HL,HL		;HL=0
  1568  088f  cdae08            	CALL	OSKEY
  1569  0892  e1                	POP	HL
  1570  0893  d8                	RET	C
  1571  0894  18f0              	JR	OSRDCH
  1572                          ;
  1573                          ;EXECIN - Read byte from EXEC file
  1574                          ;  Outputs: A = byte read
  1575                          ; Destroys: A,F
  1576                          ;
  1577  0896  c5                EXECIN:	PUSH	BC		;SAVE REGISTERS
  1578  0897  d5                	PUSH	DE
  1579  0898  e5                	PUSH	HL
  1580  0899  1e08              	LD	E,8		;SPOOL/EXEC CHANNEL
  1581  089b  217109            	LD	HL,FLAGS
  1582  089e  cb86              	RES	0,(HL)
  1583  08a0  cd9802            	CALL	OSBGET
  1584  08a3  cbc6              	SET	0,(HL)
  1585  08a5  f5                	PUSH	AF
  1586  08a6  dc6300            	CALL	C,SESHUT	;END EXEC IF EOF
  1587  08a9  f1                	POP	AF
  1588  08aa  e1                	POP	HL		;RESTORE REGISTERS
  1589  08ab  d1                	POP	DE
  1590  08ac  c1                	POP	BC
  1591  08ad  c9                	RET
  1592                          ;
  1593                          ;
  1594                          ;OSKEY - Read key with time-limit, test for ESCape.
  1595                          ;Main function is carried out in user patch.
  1596                          ;   Inputs: HL = time limit (centiseconds)
  1597                          ;  Outputs: Carry reset if time-out
  1598                          ;           If carry set A = character
  1599                          ; Destroys: A,H,L,F
  1600                          ;
  1601  08ae  e5                OSKEY:	PUSH	HL
  1602  08af  217209            	LD	HL,INKEY
  1603  08b2  7e                	LD	A,(HL)
  1604  08b3  3600              	LD	(HL),0
  1605  08b5  e1                	POP	HL
  1606  08b6  b7                	OR	A
  1607  08b7  37                	SCF
  1608  08b8  c0                	RET	NZ
  1609  08b9  d5                	PUSH	DE
  1610  08ba  cd0000            	CALL	GETKEY
  1611  08bd  d1                	POP	DE
  1612  08be  d0                	RET	NC
  1613  08bf  fe1b              	CP	ESC
  1614  08c1  37                	SCF
  1615  08c2  c0                	RET	NZ
  1616  08c3  e5                ESCSET:	PUSH	HL
  1617  08c4  217109            	LD	HL,FLAGS
  1618  08c7  cb76              	BIT	6,(HL)		;ESC DISABLED?
  1619  08c9  2002              	JR	NZ,ESCDIS
  1620  08cb  cbfe              	SET	7,(HL)		;SET ESCAPE FLAG
  1621  08cd  e1                ESCDIS:	POP	HL
  1622  08ce  c9                	RET
  1623                          ;
  1624                          ;OSWRCH - Write a character to console output.
  1625                          ;   Inputs: A = character.
  1626                          ; Destroys: Nothing
  1627                          ;
  1628  08cf  f5                OSWRCH:	PUSH	AF
  1629  08d0  d5                	PUSH	DE
  1630  08d1  e5                	PUSH	HL
  1631  08d2  cd0000            	CALL  msxCHPUT
  1632  08d5  e1                	POP	HL
  1633  08d6  d1                	POP	DE
  1634  08d7  f1                	POP	AF
  1635  08d8  c9                	RET
  1636                          ;
  1637                          ;OSLINE - Read/edit a complete line, terminated by CR.
  1638                          ;   Inputs: HL addresses destination buffer.
  1639                          ;           (L=0)
  1640                          ;  Outputs: Buffer filled, terminated by CR.
  1641                          ;           A=0.
  1642                          ; Destroys: A,B,C,D,E,H,L,F
  1643                          ;
  1644                          OSLINE:
  1645                          INLINE:
  1646  08d9  eb                	EX DE,HL
  1647  08da  d5                	PUSH DE
  1648  08db  cd0000            	CALL msxPINLINE   ; 一行入力 入力先 BUF
  1649  08de  d1                    POP DE
  1650  08df  380d              	JR C,OSLINE_STOP   ; CTRL-STOPが押されたら終わり
  1651                          INLINE0:
  1652  08e1  23                	INC HL 		; HL=BUF-1 　だから
  1653  08e2  7e                	LD A,(HL)
  1654  08e3  12                	LD (DE),A
  1655  08e4  13                	INC DE
  1656  08e5  b7                	OR A
  1657  08e6  20f9              	JR NZ,INLINE0
  1658  08e8  12                	LD (DE),A	; NULL 終端
  1659  08e9  1b                	DEC DE
  1660  08ea  3e0d              	LD A,CR
  1661  08ec  12                	LD (DE),A	; 0DH,NULL
  1662  08ed  c9                	RET
  1663                          
  1664                          OSLINE_STOP:
  1665  08ee  3e0d              	LD A,CR
  1666  08f0  12                	LD (DE),A	; 0DH
  1667  08f1  13                	INC DE
  1668  08f2  af                	XOR A
  1669  08f3  12                	LD (DE),A	; NULL 終端
  1670  08f4  37                	SCF			; CTRL-STOPが押されたことを示す
  1671  08f5  c9                	RET
  1672                          ;
  1673                          ; INIT SCREEN
  1674                          ;
  1675                          INITTXT:
  1676  08f6  3e50              	LD A,80
  1677  08f8  320000            	LD (WIDTH),A
  1678  08fb  c30000            	JP msxINITXT80
