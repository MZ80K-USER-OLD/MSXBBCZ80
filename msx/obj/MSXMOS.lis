   560                          ;
   561                          ;WRRDF - Write, read; if EOF fill with zeroes.
   562                          ;RDF - Read; if EOF fill with zeroes.
   563                          ;   Inputs: DE address FCB.
   564                          ;           HL addresses data buffer.
   565                          ;  Outputs: A=0, Z-flag set.
   566                          ;           Carry set if fill done (EOF)
   567                          ; Destroys: A,H,L,F
   568                          ;
   569  02c5  cd1903            WRRDF:	CALL	WRITE
   570  02c8  cde802            RDF:	CALL	READ
   571  02cb  2b                	DEC	HL
   572  02cc  cbbe              	RES	7,(HL)
   573  02ce  2b                	DEC	HL
   574  02cf  77                	LD	(HL),A		;CLEAR EOF FLAG
   575  02d0  c8                	RET	Z
