   318  0125  fe2b              	CP	'+'
   319  0127  c0                	RET	NZ
   320  0128  08                	EX	AF,AF'
   321  0129  fa3801            	JP	M,EXPR3S
   322  012c  08                	EX	AF,AF'
   323  012d  cdf309            EXPR3B:	CALL	SAVE
