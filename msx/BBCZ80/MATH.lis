../BBCZ80/MATH.asm:
     1                          ;	TITLE	'(C) COPYRIGHT R.T.RUSSELL 1986-2025'
     2                          ;
     3                          ;Z80 FLOATING POINT PACKAGE
     4                          ;(C) COPYRIGHT  R.T.RUSSELL  1986-2024
     5                          ;VERSION 0.0, 26-10-1986
     6                          ;VERSION 0.1, 14-12-1988 (BUG FIX)
     7                          ;VERSION 5.0, 16-06-2024 (SHIFTS ADDED)
     8                          ;VERSION 5.1, 16-03-2025 (Shifts moved to new codes)
     9                          ;
    10                          ;BINARY FLOATING POINT REPRESENTATION:
    11                          ;   32 BIT SIGN-MAGNITUDE NORMALIZED MANTISSA
    12                          ;    8 BIT EXCESS-128 SIGNED EXPONENT
    13                          ;   SIGN BIT REPLACES MANTISSA MSB (IMPLIED "1")
    14                          ;   MANTISSA=0 & EXPONENT=0 IMPLIES VALUE IS ZERO.
    15                          ;
    16                          ;BINARY INTEGER REPRESENTATION:
    17                          ;   32 BIT 2'S-COMPLEMENT SIGNED INTEGER
    18                          ;    "EXPONENT" BYTE = 0 (WHEN PRESENT)
    19                          ;
    20                          ;NORMAL REGISTER ALLOCATION: MANTISSA - HLH'L'
    21                          ;                            EXPONENT - C
    22                          ;ALTERNATE REGISTER ALLOCATION: MANTISSA - DED'E'
    23                          ;                               EXPONENT - B
    24                          ;
    25                          ;Error codes:
    26                          ;
    27                          	SECTION BASIC
    28                          
    29                          BADOP	EQU	1		;Bad operation code
    30                          DIVBY0	EQU	18		;Division by zero
    31                          TOOBIG	EQU	20		;Too big
    32                          NGROOT	EQU	21		;Negative root
    33                          LOGRNG	EQU	22		;Log range
    34                          ACLOST	EQU	23		;Accuracy lost
    35                          EXPRNG	EQU	24		;Exp range
    36                          ;
    37                          	GLOBAL	FPP
    38                          	EXTERN	STORE5
    39                          	EXTERN	DLOAD5
    40                          ;
    41                          ;Call entry and despatch code:
    42                          ;
    43  0000  fde5              FPP:	PUSH	IY		;Save IY
    44  0002  fd210000          	LD	IY,0
    45  0006  fd39              	ADD	IY,SP		;Save SP in IY
    46  0008  cd1700            	CALL	OP		;Perform operation
    47  000b  bf                	CP	A		;Good return (Z, NC)
    48  000c  fde1              EXIT:	POP	IY		;Restore IY
    49  000e  c9                	RET			;Return to caller
    50                          ;
    51                          ;Error exit:
    52                          ;
    53  000f  3e01              BAD:	LD	A,BADOP		;"Bad operation code"
    54  0011  fdf9              ERROR:	LD	SP,IY		;Restore SP from IY
    55  0013  b7                	OR	A		;Set NZ
    56  0014  37                	SCF			;Set C
    57  0015  18f5              	JR	EXIT
    58                          ;
    59                          ;Perform operation or function:
    60                          ;
    61  0017  fe30              OP:	CP	(RTABLE-DTABLE)/2
    62  0019  30f4              	JR	NC,BAD
    63  001b  fe10              	CP	(FTABLE-DTABLE)/2
    64  001d  3007              	JR	NC,DISPAT
    65  001f  08                	EX	AF,AF'
    66  0020  78                	LD	A,B
    67  0021  b1                	OR	C		;Both integer?
    68  0022  c49009            	CALL	NZ,FLOATA	;No, so float both
    69  0025  08                	EX	AF,AF'
    70  0026  e5                DISPAT:	PUSH	HL
    71  0027  213700            	LD	HL,DTABLE
    72  002a  c5                	PUSH	BC
    73  002b  87                	ADD	A,A		;A = op-code * 2
    74  002c  4f                	LD	C,A
    75  002d  0600              	LD	B,0		;BC = op-code * 2
    76  002f  09                	ADD	HL,BC
    77  0030  7e                	LD	A,(HL)		;Get low byte
    78  0031  23                	INC	HL
    79  0032  66                	LD	H,(HL)		;Get high byte
    80  0033  6f                	LD	L,A
    81  0034  c1                	POP	BC
    82  0035  e3                	EX	(SP),HL
    83  0036  c9                	RET			;Off to routine
    84                          ;
    85                          ;Despatch table:
    86                          ;
    87  0037  ba00              DTABLE:	DEFW	IAND		;0  AND (INTEGER)
    88  0039  0701              	DEFW	IBDIV		;1  DIV
    89  003b  cc00              	DEFW	IEOR		;2  EOR
    90  003d  f000              	DEFW	IMOD		;3  MOD
    91  003f  de00              	DEFW	IOR		;4  OR
    92  0041  0503              	DEFW	ILE		;5  <=
    93  0043  1203              	DEFW	INE		;6  <>
    94  0045  fa02              	DEFW	IGE		;7  >=
    95  0047  e302              	DEFW	ILT		;8  <
    96  0049  1d03              	DEFW	IEQ		;9  =
    97  004b  d101              	DEFW	IMUL		;10 *
    98  004d  2a01              	DEFW	IADD		;11 +
    99  004f  ee02              	DEFW	IGT		;12 >
   100  0051  1401              	DEFW	ISUB		;13 -
   101  0053  4c02              	DEFW	IPOW		;14 ^
   102  0055  8901              	DEFW	IDIV		;15 /
   103                          ;
   104  0057  6903              FTABLE:	DEFW	ABS		;16 ABS
   105  0059  c506              	DEFW	ACS		;17 ACS
   106  005b  2106              	DEFW	ASN		;18 ASN
   107  005d  4606              	DEFW	ATN		;19 ATN
   108  005f  5f04              	DEFW	COS		;20 COS
   109  0061  9303              	DEFW	DEG		;21 DEG
   110  0063  0405              	DEFW	EXP		;22 EXP
   111  0065  d903              	DEFW	INT		;23 INT
   112  0067  8f05              	DEFW	LN		;24 LN
   113  0069  0f06              	DEFW	LOG		;25 LOG
   114  006b  7403              	DEFW	CPL		;26 NOT
   115  006d  9b03              	DEFW	RAD		;27 RAD
   116  006f  b103              	DEFW	SGN		;28 SGN
   117  0071  6a04              	DEFW	SIN		;29 SIN
   118  0073  ef03              	DEFW	SQR		;30 SQR
   119  0075  4204              	DEFW	TAN		;31 TAN
   120                          ;
   121  0077  0c0a              	DEFW	ZERO		;32 ZERO
   122  0079  e304              	DEFW	FONE		;33 FONE
   123  007b  2103              	DEFW	TRUE		;34 TRUE
   124  007d  8703              	DEFW	PI		;35 PI
   125                          ;
   126  007f  c103              	DEFW	VAL		;36 VAL
   127  0081  cd06              	DEFW	STR		;37 STR$
   128                          ;
   129  0083  e208              	DEFW	SFIX		;38 FIX
   130  0085  9d09              	DEFW	SFLOAT		;39 FLOAT
   131                          ;
   132  0087  e209              	DEFW	FTEST		;40 TEST
   133  0089  f309              	DEFW	FCOMP		;41 COMPARE
   134                          ;
   135  008b  0f00              	DEFW	BAD		;42 Reserved for Z88
   136  008d  0f00              	DEFW	BAD		;43 Reserved for Z88
   137                          ;
   138  008f  2c03              	DEFW	ISHL		;44 <<
   139  0091  2c03              	DEFW	ISHX		;45 <<<
   140  0093  3803              	DEFW	ISAR		;46 >>
   141  0095  4903              	DEFW	ISHR		;47 >>>
   142                          ;
   143  0097  b700              RTABLE:	DEFW	FAND		;AND (FLOATING-POINT)
   144  0099  0401              	DEFW	FBDIV		;DIV
   145  009b  c900              	DEFW	FEOR		;EOR
   146  009d  ed00              	DEFW	FMOD		;MOD
   147  009f  db00              	DEFW	FOR		;OR
   148  00a1  0003              	DEFW	FLE		;<=
   149  00a3  0d03              	DEFW	FNE		;<>
   150  00a5  f502              	DEFW	FGE		;>=
   151  00a7  de02              	DEFW	FLT		;<
   152  00a9  1803              	DEFW	FEQ		;=
   153  00ab  fc01              	DEFW	FMUL		;*
   154  00ad  3401              	DEFW	FADD		;+
   155  00af  e902              	DEFW	FGT		;>
   156  00b1  1e01              	DEFW	FSUB		;-
   157  00b3  b402              	DEFW	FPOW		;^
   158  00b5  8c01              	DEFW	FDIV		;/
   159                          ;
   160                          ;ARITHMETIC AND LOGICAL OPERATORS:
   161                          ;All take two arguments, in HLH'L'C & DED'E'B.
   162                          ;Output in HLH'L'C
   163                          ;All registers except IX, IY destroyed.
   164                          ; (N.B. FPOW destroys IX).
   165                          ;
   166                          ;FAND - Floating-point AND.
   167                          ;IAND - Integer AND.
   168                          ;
   169  00b7  cdd908            FAND:	CALL	FIX2
   170  00ba  7c                IAND:	LD	A,H
   171  00bb  a2                	AND	D
   172  00bc  67                	LD	H,A
   173  00bd  7d                	LD	A,L
   174  00be  a3                	AND	E
   175  00bf  6f                	LD	L,A
   176  00c0  d9                	EXX
   177  00c1  7c                	LD	A,H
   178  00c2  a2                	AND	D
   179  00c3  67                	LD	H,A
   180  00c4  7d                	LD	A,L
   181  00c5  a3                	AND	E
   182  00c6  6f                	LD	L,A
   183  00c7  d9                	EXX
   184  00c8  c9                	RET
   185                          ;
   186                          ;FEOR - Floating-point exclusive-OR.
   187                          ;IEOR - Integer exclusive-OR.
   188                          ;
   189  00c9  cdd908            FEOR:	CALL	FIX2
   190  00cc  7c                IEOR:	LD	A,H
   191  00cd  aa                	XOR	D
   192  00ce  67                	LD	H,A
   193  00cf  7d                	LD	A,L
   194  00d0  ab                	XOR	E
   195  00d1  6f                	LD	L,A
   196  00d2  d9                	EXX
   197  00d3  7c                	LD	A,H
   198  00d4  aa                	XOR	D
   199  00d5  67                	LD	H,A
   200  00d6  7d                	LD	A,L
   201  00d7  ab                	XOR	E
   202  00d8  6f                	LD	L,A
   203  00d9  d9                	EXX
   204  00da  c9                	RET
   205                          ;
   206                          ;FOR - Floating-point OR.
   207                          ;IOR - Integer OR.
   208                          ;
   209  00db  cdd908            FOR:	CALL	FIX2
   210  00de  7c                IOR:	LD	A,H
   211  00df  b2                	OR	D
   212  00e0  67                	LD	H,A
   213  00e1  7d                	LD	A,L
   214  00e2  b3                	OR	E
   215  00e3  6f                	LD	L,A
   216  00e4  d9                	EXX
   217  00e5  7c                	LD	A,H
   218  00e6  b2                	OR	D
   219  00e7  67                	LD	H,A
   220  00e8  7d                	LD	A,L
   221  00e9  b3                	OR	E
   222  00ea  6f                	LD	L,A
   223  00eb  d9                	EXX
   224  00ec  c9                	RET
   225                          ;
   226                          ;FMOD - Floating-point remainder.
   227                          ;IMOD - Integer remainder.
   228                          ;
   229  00ed  cdd908            FMOD:	CALL	FIX2
   230  00f0  7c                IMOD:	LD	A,H
   231  00f1  aa                	XOR	D		;DIV RESULT SIGN
   232  00f2  cb7c              	BIT	7,H
   233  00f4  cde00b            	CALL	ABS2		;MAKE BOTH POSITIVE
   234  00f7  3edf              	LD	A,-33
   235  00f9  cd1c0b            	CALL	DIVA		;DIVIDE
   236  00fc  d9                	EXX
   237  00fd  0e00              	LD	C,0		;INTEGER MARKER
   238  00ff  08                	EX	AF,AF'
   239  0100  c8                	RET	Z
   240  0101  c3f108            	JP	NEGATE
   241                          ;
   242                          ;BDIV - Integer division.
   243                          ;
   244  0104  cdd908            FBDIV:	CALL	FIX2
   245  0107  cdf000            IBDIV:	CALL	IMOD
   246  010a  b7                	OR	A
   247  010b  cdc709            	CALL	SWAP
   248  010e  0e00              	LD	C,0
   249  0110  f0                	RET	P
   250  0111  c3f108            	JP	NEGATE
   251                          ;
   252                          ;ISUB - Integer subtraction.
   253                          ;FSUB - Floating point subtraction with rounding.
   254                          ;
   255  0114  cd4f0a            ISUB:	CALL	SUB
   256  0117  e0                	RET	PO
   257  0118  cd490a            	CALL	ADD
   258  011b  cd9409            	CALL	FLOAT2
   259  011e  7a                FSUB:	LD	A,D
   260  011f  ee80              	XOR	80H		;CHANGE SIGN THEN ADD
   261  0121  57                	LD	D,A
   262  0122  1810              	JR	FADD
   263                          ;
   264                          ;Reverse subtract.
   265                          ;
   266  0124  7c                RSUB:	LD	A,H
   267  0125  ee80              	XOR	80H
   268  0127  67                	LD	H,A
   269  0128  180a              	JR	FADD
   270                          ;
   271                          ;IADD - Integer addition.
   272                          ;FADD - Floating point addition with rounding.
   273                          ;
   274  012a  cd490a            IADD:	CALL	ADD
   275  012d  e0                	RET	PO
   276  012e  cd4f0a            	CALL	SUB
   277  0131  cd9409            	CALL	FLOAT2
   278  0134  05                FADD:	DEC	B
   279  0135  04                	INC	B
   280  0136  c8                	RET	Z		;ARG 2 ZERO
   281  0137  0d                	DEC	C
   282  0138  0c                	INC	C
   283  0139  cac709            	JP	Z,SWAP		;ARG 1 ZERO
   284  013c  d9                	EXX
   285  013d  010000            	LD	BC,0		;INITIALISE
   286  0140  d9                	EXX
   287  0141  7c                	LD	A,H
   288  0142  aa                	XOR	D		;XOR SIGNS
   289  0143  f5                	PUSH	AF
   290  0144  78                	LD	A,B
   291  0145  b9                	CP	C		;COMPARE EXPONENTS
   292  0146  dcc709            	CALL	C,SWAP		;MAKE DED'E'B LARGEST
   293  0149  78                	LD	A,B
   294  014a  cbfc              	SET	7,H		;IMPLIED 1
   295  014c  c4c908            	CALL	NZ,FIX		;ALIGN
   296  014f  f1                	POP	AF
   297  0150  7a                	LD	A,D		;SIGN OF LARGER
   298  0151  cbfa              	SET	7,D		;IMPLIED 1
   299  0153  fa6001            	JP	M,FADD3		;SIGNS DIFFERENT
   300  0156  cd490a            	CALL	ADD		;HLH'L'=HLH'L'+DED'E'
   301  0159  dccf09            	CALL	C,DIV2		;NORMALISE
   302  015c  cbfc              	SET	7,H
   303  015e  180a              	JR	FADD4
   304                          ;
   305  0160  cd4f0a            FADD3:	CALL	SUB		;HLH'L'=HLH'L'-DED'E'
   306  0163  dc0509            	CALL	C,NEG		;NEGATE HLH'L'B'C'
   307  0166  cd7109            	CALL	FLO48
   308  0169  2f                	CPL			;CHANGE RESULT SIGN
   309  016a  d9                FADD4:	EXX
   310  016b  eb                	EX	DE,HL
   311  016c  210080            	LD	HL,8000H
   312  016f  b7                	OR	A		;CLEAR CARRY
   313  0170  ed42              	SBC	HL,BC
   314  0172  eb                	EX	DE,HL
   315  0173  d9                	EXX
   316  0174  ccc109            	CALL	Z,ODD		;ROUND UNBIASSED
   317  0177  dcb309            	CALL	C,ADD1		;ROUND UP
   318  017a  dcdb09            	CALL	C,INCC
   319  017d  cbbc              	RES	7,H
   320  017f  0d                	DEC	C
   321  0180  0c                	INC	C
   322  0181  ca0c0a            	JP	Z,ZERO
   323  0184  b7                	OR	A		;RESULT SIGNQ
   324  0185  f0                	RET	P		;POSITIVE
   325  0186  cbfc              	SET	7,H		;NEGATIVE
   326  0188  c9                	RET
   327                          ;
   328                          ;IDIV - Integer division.
   329                          ;FDIV - Floating point division with rounding.
   330                          ;
   331  0189  cd9409            IDIV:	CALL	FLOAT2
   332  018c  05                FDIV:	DEC	B		;TEST FOR ZERO
   333  018d  04                	INC	B
   334  018e  3e12              	LD	A,DIVBY0
   335  0190  ca1100            	JP	Z,ERROR		;"Division by zero"
   336  0193  0d                	DEC	C		;TEST FOR ZERO
   337  0194  0c                	INC	C
   338  0195  c8                	RET	Z
   339  0196  7c                	LD	A,H
   340  0197  aa                	XOR	D		;CALC. RESULT SIGN
   341  0198  08                	EX	AF,AF'		;SAVE SIGN
   342  0199  cbfa              	SET	7,D		;REPLACE IMPLIED 1's
   343  019b  cbfc              	SET	7,H
   344  019d  c5                	PUSH	BC		;SAVE EXPONENTS
   345  019e  42                	LD	B,D		;LOAD REGISTERS
   346  019f  4b                	LD	C,E
   347  01a0  110000            	LD	DE,0
   348  01a3  d9                	EXX
   349  01a4  42                	LD	B,D
   350  01a5  4b                	LD	C,E
   351  01a6  110000            	LD	DE,0
   352  01a9  3ee0              	LD	A,-32		;LOOP COUNTER
   353  01ab  cd1c0b            	CALL	DIVA		;DIVIDE
   354  01ae  d9                	EXX
   355  01af  cb7a              	BIT	7,D
   356  01b1  d9                	EXX
   357  01b2  cc370b            	CALL	Z,DIVB		;NORMALISE & INC A
   358  01b5  eb                	EX	DE,HL
   359  01b6  d9                	EXX
   360  01b7  cb38              	SRL	B		;DIVISOR/2
   361  01b9  cb19              	RR	C
   362  01bb  b7                	OR	A		;CLEAR CARRY
   363  01bc  ed42              	SBC	HL,BC		;REMAINDER-DIVISOR/2
   364  01be  3f                	CCF
   365  01bf  eb                	EX	DE,HL		;RESULT IN HLH'L'
   366  01c0  ccc109            	CALL	Z,ODD		;ROUND UNBIASSED
   367  01c3  dcb309            	CALL	C,ADD1		;ROUND UP
   368  01c6  c1                	POP	BC		;RESTORE EXPONENTS
   369  01c7  dcdb09            	CALL	C,INCC
   370  01ca  1f                	RRA			;LSB OF A TO CARRY
   371  01cb  79                	LD	A,C		;COMPUTE NEW EXPONENT
   372  01cc  98                	SBC	A,B
   373  01cd  3f                	CCF
   374  01ce  c33502            	JP	CHKOVF
   375                          ;
   376                          ;IMUL - Integer multiplication.
   377                          ;
   378  01d1  7c                IMUL:	LD	A,H
   379  01d2  aa                	XOR	D
   380  01d3  cde00b            	CALL	ABS2		;MAKE BOTH POSITIVE
   381  01d6  3edf              	LD	A,-33
   382  01d8  cd4a0b            	CALL	MULA		;MULTIPLY
   383  01db  d9                	EXX
   384  01dc  0ebf              	LD	C,191		;PRESET EXPONENT
   385  01de  cdec09            	CALL	TEST		;TEST RANGE
   386  01e1  200d              	JR	NZ,IMUL1	;TOO BIG
   387  01e3  cb7a              	BIT	7,D
   388  01e5  2009              	JR	NZ,IMUL1
   389  01e7  cdc709            	CALL	SWAP
   390  01ea  4a                	LD	C,D		;INTEGER MARKER
   391  01eb  08                	EX	AF,AF'
   392  01ec  f0                	RET	P
   393  01ed  c3f108            	JP	NEGATE
   394                          ;
   395  01f0  0d                IMUL1:	DEC	C
   396  01f1  cdb30b            	CALL	SLA8
   397  01f4  f2f001            	JP	P,IMUL1		;NORMALISE
   398  01f7  08                	EX	AF,AF'
   399  01f8  f8                	RET	M
   400  01f9  cbbc              	RES	7,H		;POSITIVE
   401  01fb  c9                	RET
   402                          ;
   403                          ;FMUL - Floating point multiplication with rounding.
   404                          ;
   405  01fc  05                FMUL:	DEC	B		;TEST FOR ZERO
   406  01fd  04                	INC	B
   407  01fe  ca0c0a            	JP	Z,ZERO
   408  0201  0d                	DEC	C		;TEST FOR ZERO
   409  0202  0c                	INC	C
   410  0203  c8                	RET	Z
   411  0204  7c                	LD	A,H
   412  0205  aa                	XOR	D		;CALC. RESULT SIGN
   413  0206  08                	EX	AF,AF'
   414  0207  cbfa              	SET	7,D		;REPLACE IMPLIED 1's
   415  0209  cbfc              	SET	7,H
   416  020b  c5                	PUSH	BC		;SAVE EXPONENTS
   417  020c  44                	LD	B,H		;LOAD REGISTERS
   418  020d  4d                	LD	C,L
   419  020e  210000            	LD	HL,0
   420  0211  d9                	EXX
   421  0212  44                	LD	B,H
   422  0213  4d                	LD	C,L
   423  0214  210000            	LD	HL,0
   424  0217  3ee0              	LD	A,-32		;LOOP COUNTER
   425  0219  cd4a0b            	CALL	MULA		;MULTIPLY
   426  021c  dc5e0b            	CALL	C,MULB		;NORMALISE & INC A
   427  021f  d9                	EXX
   428  0220  e5                	PUSH	HL
   429  0221  210080            	LD	HL,8000H
   430  0224  b7                	OR	A		;CLEAR CARRY
   431  0225  ed52              	SBC	HL,DE
   432  0227  e1                	POP	HL
   433  0228  ccc109            	CALL	Z,ODD		;ROUND UNBIASSED
   434  022b  dcb309            	CALL	C,ADD1		;ROUND UP
   435  022e  c1                	POP	BC		;RESTORE EXPONENTS
   436  022f  dcdb09            	CALL	C,INCC
   437  0232  1f                	RRA			;LSB OF A TO CARRY
   438  0233  79                	LD	A,C		;COMPUTE NEW EXPONENT
   439  0234  88                	ADC	A,B
   440  0235  3805              CHKOVF:	JR	C,CHKO1
   441  0237  f20c0a            	JP	P,ZERO		;UNDERFLOW
