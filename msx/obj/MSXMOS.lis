   760  03af  b3                	OR	E
   761  03b0  c9                	RET
   762                          ;
   763                          ;SETUP - Set up File Control Block.
   764                          ;   Inputs: HL addresses filename
   765                          ;           Format  [A:]FILENAME[.EXT]
   766                          ;           Device defaults to current drive
   767                          ;           Extension defaults to .BBC
   768                          ;           A = fill character
   769                          ;  Outputs: HL updated
   770                          ;           A = terminator
   771                          ;           BC = 128
   772                          ; Destroys: A,B,C,H,L,F
   773                          ;
   774                          ; MSX-DOS2 path-aware compatibility shim.
   775                          ; Keep the raw path string in PATHBUF so command handlers can migrate from
   776                          ; CP/M FCB parsing to path-based DOS calls without immediately breaking the
   777                          ; legacy file layer.
   778                          ;
   779  03b1  110000            PATHSAVE:	LD	DE,PATHBUF
   780  03b4  af                	XOR	A
   781  03b5  7e                PATHS1:	LD	A,(HL)
   782  03b6  b7                	OR	A
   783  03b7  2828              	JR	Z,PATHS2
   784  03b9  fe0d              	CP	CR
   785  03bb  2824              	JR	Z,PATHS2
   786  03bd  fe20              	CP	' '
   787  03bf  2820              	JR	Z,PATHS2
   788  03c1  fe3d              	CP	'='
   789  03c3  281c              	JR	Z,PATHS2
   790  03c5  fe22              	CP	'"'
   791  03c7  2818              	JR	Z,PATHS2
   792  03c9  fe7c              	CP	'|'
   793  03cb  2814              	JR	Z,PATHS2
   794  03cd  fe2f              	CP	'/'
   795  03cf  2809              	JR	Z,PATHS3
   796  03d1  fe5c              	CP	5CH		; '\'
   797  03d3  2805              	JR	Z,PATHS3
   798  03d5  12                	LD	(DE),A
   799  03d6  13                	INC	DE
   800  03d7  23                	INC	HL
   801  03d8  18db              	JR	PATHS1
   802  03da  3e5c              PATHS3:	LD	A,5CH
   803  03dc  12                	LD	(DE),A
   804  03dd  13                	INC	DE
   805  03de  23                	INC	HL
   806  03df  18d4              	JR	PATHS1
   807  03e1  af                PATHS2:	XOR	A
   808  03e2  12                	LD	(DE),A
   809  03e3  c9                	RET
   810                          ;
   811                          ;PATHNORM - normalise a path string stored in PATHBUF to a DOS2-friendly form.
   812                          ;   Normalises '/' to '\' and uppercases the drive/path characters.
   813                          ;   The original FCB-based layer still receives the CP/M-compatible name, but
   814                          ;   PATHBUF preserves the full path information needed for a later DOS2 switch.
   815                          ;
   816  03e4  f5                PATHNORM:	PUSH	AF
   817  03e5  d5                	PUSH	DE
   818  03e6  e5                	PUSH	HL
   819  03e7  210000            	LD	HL,PATHBUF
   820  03ea  7e                PATHN1:	LD	A,(HL)
   821  03eb  b7                	OR	A
   822  03ec  2815              	JR	Z,PATHNEND
   823  03ee  fe2f              	CP	'/'
   824  03f0  280b              	JR	Z,PATHN2
   825  03f2  fe5c              	CP	5CH
   826  03f4  2807              	JR	Z,PATHN2
   827  03f6  cd1e07            	CALL	UPPRC
   828  03f9  77                	LD	(HL),A
   829  03fa  23                	INC	HL
   830  03fb  18ed              	JR	PATHN1
   831  03fd  3e5c              PATHN2:	LD	A,5CH
   832  03ff  77                	LD	(HL),A
   833  0400  23                	INC	HL
   834  0401  18e7              	JR	PATHN1
   835  0403  e1                PATHNEND:	POP	HL
   836  0404  d1                	POP	DE
   837  0405  f1                	POP	AF
   838  0406  c9                	RET
   839                          
   840                          ; Add the BASIC default extension to PATHBUF when the supplied path has none.
   841                          DOS2_DEFAULT_EXT:
   842  0407  f5                	PUSH	AF
   843  0408  c5                	PUSH	BC
   844  0409  d5                	PUSH	DE
   845  040a  e5                	PUSH	HL
   846  040b  210000            	LD	HL,PATHBUF
   847  040e  0600              	LD	B,0
