  3079                          ; NSCAN - scan for token at start of line, with nesting of inner structures
  3080                          ; Alternative entry at NSCAN1 with L = level (used by CASE)
  3081                          ;
  3082                          ;   Inputs: B = token to find (1, start of line)
  3083                          ;           C = token to find (2, start of line)
  3084                          ;           E = token to nest (end of line)
  3085                          ;           D = token to unnest (start of line)
  3086                          ;           IY = start search area (line length byte)
  3087                          ;  Outputs: NZ if not found
  3088                          ;           Z if found, IY points to byte after token
  3089                          ; Destroys: A,B,C,L,IY,F
  3090                          ;
  3091  126c  2e00              NSCAN:	LD	L,0		;nest level
  3092  126e  fd7e00            NSCAN1:	LD	A,(IY)		;get line length
  3093  1271  b7                	OR	A		;test zero = end of prog
  3094  1272  2834              	JR	Z,NSCAN6
  3095  1274  fd7e03            	LD	A,(IY+3)	;initial token
  3096  1277  b8                	CP	B		;test value reqd
  3097  1278  281d              	JR	Z,NSCAN3	;found (1)
  3098  127a  b9                	CP	C
  3099  127b  281a              	JR	Z,NSCAN3	;found (2)
  3100  127d  ba                NSCAN7:	CP	D		;unnest?
  3101  127e  2822              	JR	Z,NSCAN5
  3102  1280  c5                NSCAN2:	PUSH	BC
  3103  1281  0600              	LD	B,0
  3104  1283  fd4e00            	LD	C,(IY)
  3105  1286  fd09              	ADD	IY,BC		;go to next line
  3106  1288  fd7efe            	LD	A,(IY-2)
  3107  128b  bb                	CP	E		;nest?
  3108  128c  79                	LD	A,C
  3109  128d  c1                	POP	BC
  3110  128e  20de              	JR	NZ,NSCAN1	;continue
  3111  1290  fe05              	CP	5		;empty line ?
  3112  1292  38da              	JR	C,NSCAN1	;continue
  3113  1294  2c                	INC	L		;increment nest level
  3114  1295  18d7              	JR	NSCAN1		;continue
  3115                          ;
  3116  1297  2c                NSCAN3:	INC	L
  3117  1298  2d                	DEC	L
  3118  1299  20e2              	JR	NZ,NSCAN7
  3119  129b  010400            NSCAN4:	LD	BC,4
  3120  129e  fd09              	ADD	IY,BC
  3121  12a0  af                	XOR	A		;Z
  3122  12a1  c9                	RET
  3123                          ;
  3124  12a2  2d                NSCAN5:	DEC	L		;decrement nest level
  3125  12a3  f28012            	JP	P,NSCAN2
  3126  12a6  18f3              	JR	NSCAN4
  3127                          ;
  3128  12a8  f601              NSCAN6:	OR	1		;NZ
  3129  12aa  c9                	RET
