  1729                          ;------------------------------------------------------------------------------
  1730                          ; Check Msx-DOS Version (MSX1 or MSX2)
  1731                          ; ------------------------------------------------------------------------------
  1732                          CheckMSXDOS:
  1733                              ; --- バージョン取得 ---
  1734  0949  010000                ld   bc, 0000h   ; 初期化
  1735  094c  0e6f                  ld   c, 6Fh      ; _DOSVER
  1736  094e  cd0500                call BDOS       ; BDOS
  1737                          
  1738  0951  78                    ld   a, b        ; メジャーバージョン
  1739  0952  320000                ld   (DOS_VER), a ; 変数に格納
  1740                          
  1741                              ; --- 判定と表示 ---
  1742  0955  3a0000            	ld   a, (DOS_VER)
  1743  0958  fe02                  cp   2
  1744  095a  3006                  jr   nc, print_dos2
  1745                          
  1746                          print_dos1:
  1747  095c  216809                LD HL, MSG_DOS1
  1748  095f  c30000                JP msxSTRPUT
  1749                          
  1750                          print_dos2:
  1751  0962  217409                LD HL, MSG_DOS2
  1752  0965  c30000                JP msxSTRPUT
  1753                          
  1754                          
  1755                          ; --- データエリア ---
  1756  0968  4d53582d444f5320  MSG_DOS1: DEFB "MSX-DOS 1",0DH,0AH,00
              310d0a00          
  1757  0974  4d53582d444f5320  MSG_DOS2: DEFB "MSX-DOS 2",0DH,0AH,00
              320d0a00          
  1758                          
  1759                          ; ======================================================
  1760                          ; HLレジスタの内容をASCII 4文字で画面に表示する
  1761                          ; ======================================================
  1762                          PrintAddress:
  1763  0980  7c                    ld  a, h
  1764  0981  cd8509                call PrintHexByte   ; 上位バイト(H)を表示
  1765  0984  7d                    ld  a, l            ; 下位バイト(L)を表示
  1766                              ; そのまま下の PrintHexByte へ流れる (Fall-through)
  1767                          
  1768                          ; --- 1バイト(A)を16進ASCII 2文字で表示 ---
  1769                          PrintHexByte:
  1770  0985  f5                    push af             ; 下位ニブル保存用
  1771  0986  0f                    rrca
  1772  0987  0f                	rrca 		        ; 上位4ビットを下位へ移動
  1773  0988  0f                    rrca
  1774  0989  0f                	rrca
  1775  098a  cd8e09                call PrintNibble    ; 上位桁を表示
  1776  098d  f1                    pop  af             ; 下位ニブルを戻す
  1777                              ; そのまま下の PrintNibble へ流れる
  1778                          
  1779                          ; --- 下位4ビット(A)をASCII 1文字で表示 (DAAマジック) ---
  1780                          PrintNibble:
  1781  098e  e60f                  and  0Fh            ; 下位4ビットのみにマスク
  1782  0990  c690                  add  a, 90h         ; 10進補正を利用するためのオフセット
  1783  0992  27                    daa                 ; 0-9はそのまま、A-Fは桁上げが発生
  1784  0993  ce40                  adc  a, 40h         ; ASCII '0'(30h)や'A'(41h)への調整
  1785  0995  27                    daa                 ; 最終的なASCIIコードに確定
  1786                          
  1787                          ; --- [システム依存] 1文字出力ルーチン ---
  1788                              ; Aレジスタの文字を表示します。
  1789                              ; お使いの環境に合わせて書き換えてください。
  1790                          PUTCHAR::
  1791  0996  c30000            	JP msxCHPUT ; 画面に表示 (自動的にXが+1される)
  1792                          
  1793                          PUTCRLF:
  1794  0999  3e0d              	LD A,CR
  1795  099b  cd0000            	CALL msxCHPUT
  1796  099e  3e0a              	LD  A,LF
  1797  09a0  c30000            	JP  msxCHPUT
  1798                          
  1799                          PROMPT:
  1800  09a3  3e3e              	LD A,'>'
  1801  09a5  c30000            	JP msxCHPUT
  1802                          ;
  1803                          ; HLレジスタの指す文字列を画面に出力するルーチン
  1804                          ; 文字列はNULL(0)で終端されているもの
  1805                          STRPUT:
  1806  09a8  c30000                JP msxSTRPUT ; 文字列出力
  1807                          
  1808                          ;
  1809                          ;
  1810                          ;EDITST:	DEFM	"EDIT"
  1811                          ;LISTST:	DEFM	"LIST"
  1812                          ;
  1813                          BEL	EQU	7
  1814                          BS	EQU	8
  1815                          HT	EQU	9
  1816                          LF	EQU	0AH
  1817                          VT	EQU	0BH
  1818                          CR	EQU	0DH
  1819                          ESC	EQU	1BH
  1820                          DEL	EQU	7FH
  1821                          ;
  1822                          FCB	EQU	5CH
  1823                          DSKBUF	EQU	80H
  1824                          ;
  1825                          FCBSIZ	EQU	128+36+2
  1826                          BLOCKSIZE EQU 256
  1827                          ;
  1828  09ab  0a                TRPCNT:	DEFB	10
  1829  09ac  0000000000000000  TABLE:	DEFS	16		;FILE BLOCK POINTERS
              0000000000000000  
  1830  09bc  00                FLAGS:	DEFB	0
  1831  09bd  00                INKEY:	DEFB	0
  1832  09be  0000              EDPTR:	DEFW	0
  1833  09c0  00                OPTVAL:	DEFB	0
  1834                          INILEN	EQU	$-TABLE
  1835                          ;
  1836                          FIN:	;END
