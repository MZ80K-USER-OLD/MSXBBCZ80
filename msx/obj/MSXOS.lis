    77                          ;
    78                          ;
    79                          ;OSSAVE - Save an area of memory to a file.
    80                          ;   Inputs: HL addresses filename (term CR)
    81                          ;           DE = start address of data to save
    82                          ;           BC = length of data to save (bytes)
    83                          ; Destroys: A,B,C,D,E,H,L,F
    84                          ;
    85  0000  cd6d04            STSAVE:	CALL	SAVLOD		;*SAVE
    86  0003  da3b04            	JP	C,HUH		;"Bad command"
    87  0006  e5                	PUSH	HL
    88  0007  1804              	JR	OSS1
    89                          ;
    90  0009  c5                OSSAVE:	PUSH	BC		;SAVE
    91  000a  cdd402            	CALL	SETUP0
    92  000d  eb                OSS1:	EX	DE,HL
    93  000e  cd6a02            	CALL	CREATE
    94  0011  2014              	JR	NZ,SAVE
    95  0013  3ebe              DIRFUL:	LD	A,190
    96  0015  cd0000            	CALL	EXTERR
    97  0018  4469726563746f72  	DEFM	"Directory full"
              792066756c6c      
    98  0026  00                	DEFB	0
    99  0027  cd3c02            SAVE:	CALL	WRITE
   100  002a  09                	ADD	HL,BC
   101  002b  e3                	EX	(SP),HL
   102  002c  ed42              	SBC	HL,BC
   103  002e  e3                	EX	(SP),HL
   104  002f  2802              	JR	Z,SAVE1
   105  0031  30f4              	JR	NC,SAVE
   106  0033  c1                SAVE1:	POP	BC
   107  0034  3e10              CLOSE:	LD	A,16
   108  0036  cd1002            	CALL	BDOS1
   109  0039  3c                	INC	A
   110  003a  c0                	RET	NZ
   111  003b  3ec8              	LD	A,200
   112  003d  cd0000            	CALL	EXTERR
   113  0040  436c6f7365206572  	DEFM	"Close error"
              726f72            
   114  004b  00                	DEFB	0
   115                          ;
   116                          ;OSSHUT - Close disk file(s).
   117                          ;   Inputs: E = file channel
   118                          ;           If E=0 all files are closed (except SPOOL)
   119                          ; Destroys: A,B,C,D,E,H,L,F
   120                          ;
   121  004c  7b                OSSHUT:	LD	A,E
   122  004d  b7                	OR	A
   123  004e  200b              	JR	NZ,SHUTIT
   124  0050  1c                SHUT0:	INC	E
   125  0051  cb5b              	BIT	3,E
   126  0053  c0                	RET	NZ
   127  0054  d5                	PUSH	DE
   128  0055  cd6c00            	CALL	SHUT1
   129  0058  d1                	POP	DE
   130  0059  18f5              	JR	SHUT0
   131                          ;
   132  005b  cdc302            SHUTIT:	CALL	FIND1
   133  005e  2010              	JR	NZ,SHUT2
   134  0060  c3ae02            	JP	CHANER
   135                          ;
   136  0063  213a07            SESHUT:	LD	HL,FLAGS
   137  0066  cb86              	RES	0,(HL)		;STOP EXEC
   138  0068  cb8e              	RES	1,(HL)		;STOP SPOOL
   139  006a  1e08              	LD	E,8		;SPOOL/EXEC CHANNEL
   140  006c  cdc302            SHUT1:	CALL	FIND1
   141  006f  c8                	RET	Z
   142  0070  af                SHUT2:	XOR	A
   143  0071  77                	LD	(HL),A
   144  0072  2b                	DEC	HL
   145  0073  77                	LD	(HL),A
   146  0074  212500            	LD	HL,37
   147  0077  19                	ADD	HL,DE
   148  0078  cb7e              	BIT	7,(HL)
   149  007a  23                	INC	HL
   150  007b  c43c02            	CALL	NZ,WRITE
   151  007e  21a600            	LD	HL,FCBSIZ
   152  0081  19                	ADD	HL,DE
   153  0082  ed4b0000          	LD	BC,(FREE)
   154  0086  ed42              	SBC	HL,BC
   155  0088  20aa              	JR	NZ,CLOSE
   156  008a  ed530000          	LD	(FREE),DE	;RELEASE SPACE
   157  008e  18a4              	JR	CLOSE
   158                          ;
   159                          ;TYPE - *TYPE command.
   160                          ;Types file to console output.
   161                          ;
   162  0090  37                TYPE:	SCF			;*TYPE
   163  0091  cdf600            	CALL	OSOPEN
   164  0094  b7                	OR	A
   165  0095  2828              	JR	Z,NOTFND
   166  0097  5f                	LD	E,A
   167  0098  3a3a07            TYPE1:	LD	A,(FLAGS)	;TEST
   168  009b  cb7f              	BIT	7,A		;FOR
   169  009d  200a              	JR	NZ,TYPESC	;ESCape
   170  009f  cd6201            	CALL	OSBGET
   171  00a2  cd9b06            	CALL	OSWRCH		;N.B. CALLS "TEST"
   172  00a5  30f1              	JR	NC,TYPE1
   173  00a7  18a3              	JR	OSSHUT
   174                          ;
   175  00a9  cd4c00            TYPESC:	CALL	OSSHUT		;CLOSE!
   176  00ac  c31b06            	JP	ABORT
   177                          ;
   178                          ;OSLOAD - Load an area of memory from a file.
   179                          ;   Inputs: HL addresses filename (term CR)
   180                          ;           DE = address at which to load
   181                          ;           BC = maximum allowed size (bytes)
   182                          ;  Outputs: Carry reset indicates no room for file.
   183                          ; Destroys: A,B,C,D,E,H,L,F
   184                          ;
   185  00af  cd6d04            STLOAD:	CALL	SAVLOD		;*LOAD
   186  00b2  e5                	PUSH	HL
   187  00b3  1804              	JR	OSL1
   188                          ;
   189  00b5  c5                OSLOAD:	PUSH	BC		;LOAD
   190  00b6  cdd402            	CALL	SETUP0
   191  00b9  eb                OSL1:	EX	DE,HL
   192  00ba  cd6002            	CALL	OPEN
   193  00bd  201d              	JR	NZ,LOAD0
   194  00bf  3ed6              NOTFND:	LD	A,214
   195  00c1  cd0000            	CALL	EXTERR
   196  00c4  46696c65206e6f74  	DEFM	"File not found"
              20666f756e64      
   197  00d2  00                	DEFB	0
   198  00d3  cd0b02            LOAD:	CALL	READ
   199  00d6  200a              	JR	NZ,LOAD1
   200  00d8  cd5502            	CALL	INCSEC
   201  00db  09                	ADD	HL,BC
   202  00dc  e3                LOAD0:	EX	(SP),HL
   203  00dd  ed42              	SBC	HL,BC
   204  00df  e3                	EX	(SP),HL
   205  00e0  30f1              	JR	NC,LOAD
   206  00e2  c1                LOAD1:	POP	BC
   207  00e3  f5                	PUSH	AF
   208  00e4  cd3400            	CALL	CLOSE
   209  00e7  f1                	POP	AF
   210  00e8  3f                	CCF
   211  00e9  c9                OSCALL:	RET
   212                          ;
   213                          ;OSOPEN - Open a file for reading or writing.
   214                          ;   Inputs: HL addresses filename (term CR)
   215                          ;           Carry set for OPENIN, cleared for OPENOUT.
   216                          ;  Outputs: A = file channel (=0 if cannot open)
   217                          ;           DE = file FCB
   218                          ; Destroys: A,B,C,D,E,H,L,F
   219                          ;
   220  00ea  f5                OPENIT:	PUSH	AF		;SAVE CARRY
   221  00eb  cdd402            	CALL	SETUP0
   222  00ee  f1                	POP	AF
   223  00ef  d46a02            	CALL	NC,CREATE
   224  00f2  dc6002            	CALL	C,OPEN
   225  00f5  c9                	RET
   226                          ;
   227  00f6  cdea00            OSOPEN:	CALL	OPENIT
   228  00f9  c8                	RET	Z		;ERROR
   229  00fa  0607              	LD	B,7		;MAX. NUMBER OF FILES
   230  00fc  213907            	LD	HL,TABLE+15
   231  00ff  7e                OPEN1:	LD	A,(HL)
   232  0100  2b                	DEC	HL
   233  0101  b6                	OR	(HL)
   234  0102  281c              	JR	Z,OPEN2		;FREE CHANNEL
   235  0104  2b                	DEC	HL
   236  0105  10f8              	DJNZ	OPEN1
   237  0107  3ec0              	LD	A,192
   238  0109  cd0000            	CALL	EXTERR
   239  010c  546f6f206d616e79  	DEFM	"Too many open files"
              206f70656e206669  
              6c6573            
   240  011f  00                	DEFB	0
   241                          ;
   242  0120  ed5b0000          OPEN2:	LD	DE,(FREE)	;FREE SPACE POINTER
   243  0124  73                	LD	(HL),E
   244  0125  23                	INC	HL
   245  0126  72                	LD	(HL),D
   246  0127  78                	LD	A,B		;CHANNEL (1-7)
   247  0128  21a600            	LD	HL,FCBSIZ
   248  012b  19                	ADD	HL,DE		;RESERVE SPACE
   249  012c  220000            	LD	(FREE),HL
   250  012f  215c00            OPEN3:	LD	HL,FCB		;ENTRY FROM SPOOL/EXEC
   251  0132  d5                	PUSH	DE
   252  0133  012400            	LD	BC,36
   253  0136  edb0              	LDIR			;COPY FCB
   254  0138  eb                	EX	DE,HL
   255  0139  23                	INC	HL
   256  013a  71                	LD	(HL),C		;CLEAR PTR
   257  013b  23                	INC	HL
   258  013c  d1                	POP	DE
   259  013d  47                	LD	B,A
   260  013e  cdeb01            	CALL	RDF		;READ OR FILL
   261  0141  78                	LD	A,B
   262  0142  c30000            	JP	CHECK
   263                          ;
   264                          ;OSBPUT - Write a byte to a random disk file.
   265                          ;   Inputs: E = file channel
   266                          ;           A = byte to write
   267                          ; Destroys: A,B,C,F
   268                          ;
   269  0145  d5                OSBPUT:	PUSH	DE
   270  0146  e5                	PUSH	HL
   271  0147  47                	LD	B,A
   272  0148  cda202            	CALL	FIND
   273  014b  78                	LD	A,B
   274  014c  0600              	LD	B,0
   275  014e  2b                	DEC	HL
   276  014f  70                	LD	(HL),B		;CLEAR EOF
   277  0150  23                	INC	HL
   278  0151  4e                	LD	C,(HL)
   279  0152  cbb9              	RES	7,C
   280  0154  cbfe              	SET	7,(HL)
   281  0156  34                	INC	(HL)
   282  0157  23                	INC	HL
   283  0158  e5                	PUSH	HL
   284  0159  09                	ADD	HL,BC
   285  015a  77                	LD	(HL),A
   286  015b  e1                	POP	HL
   287  015c  cce801            	CALL	Z,WRRDF		;WRITE THEN READ/FILL
   288  015f  e1                	POP	HL
   289  0160  d1                	POP	DE
   290  0161  c9                	RET
   291                          ;
   292                          ;OSBGET - Read a byte from a random disk file.
   293                          ;   Inputs: E = file channel
   294                          ;  Outputs: A = byte read
   295                          ;           Carry set if LAST BYTE of file
   296                          ; Destroys: A,B,C,F
   297                          ;
   298  0162  d5                OSBGET:	PUSH	DE
   299  0163  e5                	PUSH	HL
   300  0164  cda202            	CALL	FIND
   301  0167  4e                	LD	C,(HL)
   302  0168  cbb9              	RES	7,C
   303  016a  34                	INC	(HL)
   304  016b  23                	INC	HL
   305  016c  e5                	PUSH	HL
   306  016d  0600              	LD	B,0
   307  016f  09                	ADD	HL,BC
   308  0170  46                	LD	B,(HL)
   309  0171  e1                	POP	HL
   310  0172  ec0302            	CALL	PE,INCRDF	;INC SECTOR THEN READ
   311  0175  cce801            	CALL	Z,WRRDF		;WRITE THEN READ/FILL
   312  0178  78                	LD	A,B
   313  0179  e1                	POP	HL
   314  017a  d1                	POP	DE
   315  017b  c9                	RET
   316                          ;
   317                          ;OSSTAT - Read file status.
   318                          ;   Inputs: E = file channel
   319                          ;  Outputs: Z flag set - EOF
   320                          ;           (If Z then A=0)
   321                          ;           DE = address of file block.
   322                          ; Destroys: A,D,E,H,L,F
   323                          ;
   324  017c  cda202            OSSTAT:	CALL	FIND
   325  017f  2b                	DEC	HL
   326  0180  7e                	LD	A,(HL)
   327  0181  3c                	INC	A
   328  0182  c9                	RET
   329                          ;
   330                          ;GETEXT - Find file size.
   331                          ;   Inputs: E = file channel
   332                          ;  Outputs: DEHL = file size (0-&800000)
   333                          ; Destroys: A,B,C,D,E,H,L,F
   334                          ;
   335  0183  cda202            GETEXT:	CALL	FIND
   336  0186  eb                	EX	DE,HL
   337  0187  115c00            	LD	DE,FCB
   338  018a  012400            	LD	BC,36
   339  018d  d5                	PUSH	DE
   340  018e  edb0              	LDIR			;COPY FCB
   341  0190  eb                	EX	DE,HL
   342  0191  e3                	EX	(SP),HL
   343  0192  eb                	EX	DE,HL
   344  0193  3e23              	LD	A,35
   345  0195  cd1002            	CALL	BDOS1		;COMPUTE SIZE
   346  0198  e1                	POP	HL
   347  0199  af                	XOR	A
   348  019a  1806              	JR	GETPT1
   349                          ;
   350                          ;GETPTR - Return file pointer.
   351                          ;   Inputs: E = file channel
   352                          ;  Outputs: DEHL = pointer (0-&7FFFFF)
   353                          ; Destroys: A,B,C,D,E,H,L,F
   354                          ;
   355  019c  cda202            GETPTR:	CALL	FIND
   356  019f  7e                	LD	A,(HL)
   357  01a0  87                	ADD	A,A
   358  01a1  2b                	DEC	HL
   359  01a2  2b                GETPT1:	DEC	HL
   360  01a3  56                	LD	D,(HL)
   361  01a4  2b                	DEC	HL
   362  01a5  5e                	LD	E,(HL)
   363  01a6  2b                	DEC	HL
   364  01a7  66                	LD	H,(HL)
   365  01a8  6f                	LD	L,A
   366  01a9  cb3a              	SRL	D
   367  01ab  cb1b              	RR	E
   368  01ad  cb1c              	RR	H
   369  01af  cb1d              	RR	L
   370  01b1  c9                	RET
   371                          ;
   372                          ;PUTPTR - Update file pointer.
   373                          ;   Inputs: A = file channel
   374                          ;           DEHL = new pointer (0-&7FFFFF)
   375                          ; Destroys: A,B,C,D,E,H,L,F
   376                          ;
   377  01b2  55                PUTPTR:	LD	D,L
   378  01b3  29                	ADD	HL,HL
   379  01b4  cb13              	RL	E
   380  01b6  43                	LD	B,E
   381  01b7  4c                	LD	C,H
   382  01b8  5f                	LD	E,A		;CHANNEL
   383  01b9  d5                	PUSH	DE
   384  01ba  cda202            	CALL	FIND
   385  01bd  f1                	POP	AF
   386  01be  e67f              	AND	7FH
   387  01c0  cb7e              	BIT	7,(HL)		;PENDING WRITE?
   388  01c2  2802              	JR	Z,PUTPT1
   389  01c4  f680              	OR	80H
   390  01c6  77                PUTPT1:	LD	(HL),A
   391  01c7  d5                	PUSH	DE
   392  01c8  e5                	PUSH	HL
   393  01c9  2b                	DEC	HL
   394  01ca  2b                	DEC	HL
   395  01cb  2b                	DEC	HL
   396  01cc  56                	LD	D,(HL)
   397  01cd  2b                	DEC	HL
   398  01ce  5e                	LD	E,(HL)
   399  01cf  eb                	EX	DE,HL
   400  01d0  b7                	OR	A
   401  01d1  ed42              	SBC	HL,BC
   402  01d3  e1                	POP	HL
   403  01d4  d1                	POP	DE
   404  01d5  c8                	RET	Z
   405  01d6  23                	INC	HL
   406  01d7  b7                	OR	A
   407  01d8  fc3c02            	CALL	M,WRITE
   408  01db  e5                	PUSH	HL
   409  01dc  2b                	DEC	HL
   410  01dd  2b                	DEC	HL
   411  01de  2b                	DEC	HL
   412  01df  3600              	LD	(HL),0
   413  01e1  2b                	DEC	HL
   414  01e2  70                	LD	(HL),B
   415  01e3  2b                	DEC	HL
   416  01e4  71                	LD	(HL),C		;NEW RECORD NO.
   417  01e5  e1                	POP	HL
   418  01e6  1803              	JR	RDF
   419                          ;
   420                          ;WRRDF - Write, read; if EOF fill with zeroes.
   421                          ;RDF - Read; if EOF fill with zeroes.
   422                          ;   Inputs: DE address FCB.
   423                          ;           HL addresses data buffer.
   424                          ;  Outputs: A=0, Z-flag set.
   425                          ;           Carry set if fill done (EOF)
   426                          ; Destroys: A,H,L,F
   427                          ;
   428  01e8  cd3c02            WRRDF:	CALL	WRITE
   429  01eb  cd0b02            RDF:	CALL	READ
   430  01ee  2b                	DEC	HL
   431  01ef  cbbe              	RES	7,(HL)
   432  01f1  2b                	DEC	HL
   433  01f2  77                	LD	(HL),A		;CLEAR EOF FLAG
   434  01f3  c8                	RET	Z
   435  01f4  36ff              	LD	(HL),-1		;SET EOF FLAG
   436  01f6  23                	INC	HL
   437  01f7  23                	INC	HL
   438  01f8  c5                	PUSH	BC
   439  01f9  af                	XOR	A
   440  01fa  0680              	LD	B,128
   441  01fc  77                FILL:	LD	(HL),A
   442  01fd  23                	INC	HL
   443  01fe  10fc              	DJNZ	FILL
   444  0200  c1                	POP	BC
   445  0201  37                	SCF
   446  0202  c9                	RET
   447                          ;
   448                          ;INCRDF - Increment record, read; if EOF fill.
   449                          ;   Inputs: DE addresses FCB.
   450                          ;           HL addresses data buffer.
   451                          ;  Outputs: A=1, Z-flag reset.
   452                          ;           Carry set if fill done (EOF)
   453                          ; Destroys: A,H,L,F
   454                          ;
   455  0203  cd5502            INCRDF:	CALL	INCSEC
   456  0206  cdeb01            	CALL	RDF
   457  0209  3c                	INC	A
   458  020a  c9                	RET
   459                          ;
   460                          ;READ - Read a record from a disk file.
   461                          ;   Inputs: DE addresses FCB.
   462                          ;           HL = address to store data.
   463                          ;  Outputs: A<>0 & Z-flag reset indicates EOF.
   464                          ;           Carry = 0
   465                          ; Destroys: A,F
   466                          ;
   467                          ;BDOS1 - CP/M BDOS call.
   468                          ;   Inputs: A = function number
   469                          ;          DE = parameter
   470                          ;  Outputs: AF = result (carry=0)
   471                          ; Destroys: A,F
   472                          ;
   473  020b  cd9a02            READ:	CALL	SETDMA
   474  020e  3e21              	LD	A,33
   475  0210  cd2702            BDOS1:	CALL	BDOS0
   476  0213  2002              	JR	NZ,CPMERR
   477  0215  b7                	OR	A
   478  0216  c9                	RET
   479  0217  3eff              CPMERR:	LD	A,255
   480  0219  cd0000            	CALL	EXTERR
   481  021c  43502f4d20457272  	DEFM	"CP/M Error"
              6f72              
   482  0226  00                	DEFB	0
   483                          ;
   484  0227  c5                BDOS0:	PUSH	BC
   485  0228  d5                	PUSH	DE
   486  0229  e5                	PUSH	HL
   487  022a  dde5              	PUSH	IX
   488  022c  fde5              	PUSH	IY
   489  022e  4f                	LD	C,A
   490  022f  cd0500            	CALL	BDOS
   491  0232  24                	INC	H
   492  0233  25                	DEC	H
   493  0234  fde1              	POP	IY
   494  0236  dde1              	POP	IX
