   285  00f1  08                EXPR2S:	EX	AF,AF'
   286  00f2  3d                	DEC	A
   287  00f3  e607              	AND	7
   288  00f5  cd9909            	CALL	PUSHS		;SAVE STRING ON STACK
   289  00f8  f5                	PUSH	AF		;SAVE OPERATOR
   290  00f9  cd1e01            	CALL	EXPR3		;SECOND STRING
   291  00fc  08                	EX	AF,AF'
   292  00fd  f2ec01            	JP	P,MISMAT
   293  0100  f1                	POP	AF
   294  0101  4b                	LD	C,E		;LENGTH OF STRING #2
   295  0102  d1                	POP	DE
   296  0103  210000            	LD	HL,0
   297  0106  39                	ADD	HL,SP
   298  0107  43                	LD	B,E		;LENGTH OF STRING #1
   299  0108  d5                	PUSH	DE
   300  0109  110000            	LD	DE,ACCS
   301  010c  eb                	EX	DE,HL
   302  010d  cd3b0a            	CALL	DISPT2
   303  0110  d1                	POP	DE
   304  0111  eb                	EX	DE,HL
   305  0112  2600              	LD	H,0
   306  0114  39                	ADD	HL,SP
   307  0115  f9                	LD	SP,HL
   308  0116  eb                	EX	DE,HL
   309  0117  af                	XOR	A		;NUMERIC MARKER
   310  0118  4f                	LD	C,A		;INTEGER MARKER
