  1035                          ;
  1036                          ; MSX-DOS2 directory search.  FFIRST/FNEXT use IX as a 64-byte
  1037                          ; file information block rather than a file handle.
  1038                          ;
  1039                          DIRDOS2:
  1040  056b  210000            	LD	HL,PATHBUF
  1041  056e  7e                	LD	A,(HL)
  1042  056f  b7                	OR	A
  1043  0570  200b              	JR	NZ,DIRD21
  1044  0572  362a              	LD	(HL),'*'
  1045  0574  23                	INC	HL
  1046  0575  362e              	LD	(HL),'.'
  1047  0577  23                	INC	HL
  1048  0578  362a              	LD	(HL),'*'
  1049  057a  23                	INC	HL
  1050  057b  3600              	LD	(HL),0
  1051                          DIRD21:
