  1401  0798  cbb6              	RES	6,(HL)		;ENABLE ESCAPE
  1402  079a  c8                	RET	Z
  1403  079b  cbf6              	SET	6,(HL)		;DISABLE ESCAPE
  1404  079d  c9                	RET
