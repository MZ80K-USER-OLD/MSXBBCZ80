   161  00c8  3a0000            	LD	A,(LISTON)
   162  00cb  e620              	AND	20H
   163  00cd  200b              	JR	NZ,ASMB0
   164  00cf  dd7e00            	LD	A,(IX)
   165  00d2  ddb601            	OR	(IX+1)
